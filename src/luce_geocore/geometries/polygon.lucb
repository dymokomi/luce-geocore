## Immutable indexed polygon topology, shared by procedural geometry consumers.
## Operators return new meshes; input snapshots never change. No editor state.
import interop
import math
import memory
import luce_geocore.errors as errors
from luce_geocore.core.geometry import Geometry, Vertex, Bounds
from luce_geocore.core.polygon_topology import PolygonTopology
from luce_geocore.math.vector import Vector3
from luce_geocore.math.matrix import Matrix4
from luce_geocore.geometries.attributes import AttributeSet
from luce_geocore.geometries.query_cache import QueryCache, SharedCount
from luce_geocore.geometries.polygon_triangulation import triangulate, area_normal
import luce_geocore.geometries.display_triangulation as display_triangles
from luce_geocore.geometries.topology_hash import topology_hash
import luce_geocore.geometries.position_edit as positions

pub struct PolygonMesh: Geometry, PolygonTopology:
    var points: Vector3[]
    let sizes: i64[]
    let corners: i64[]
    let offsets: usize[]
    let corner_faces: usize[]
    var normals: Vector3[]
    var triangles: i64[]
    let edge_a: i64[]
    let edge_b: i64[]
    let corner_edges: usize[]
    let edges: usize
    var extent: Bounds
    # Connectivity fingerprint, computed once; position-only copies keep it.
    let topology_key: u64
    var attributes: AttributeSet
    # Snapshots, including worker-to-UI transfers, share the immutable storage
    # and its query index, never attributes. Counts are atomic: owners on
    # different threads close independently and the last one frees.
    var queries: QueryCache[]
    # Position-only edits share the sizes/corners/edge arrays and, unless a face
    # folded, the triangles. Each count is the number of query caches (point
    # sets) using that storage; the last one frees it.
    var topology_owners: SharedCount[]
    var triangle_owners: SharedCount[]

    ## Optional display indices are grouped by polygon, 3*(size-2) entries each.
    ## A wholly -1 face requests ordinary triangulation. Explicit triangles are
    ## validated and affect rendering/picking, never the polygon edge topology.
    pub func init(points: const Vector3[], sizes: const i64[], corners: const i64[], display: const i64[]? = none) -> !:
        if points.length > 8388608 or sizes.length > 8388608 or corners.length > 33554432:
            error(errors.limit, "polygon mesh exceeds 8M points/faces or 32M corners")
        var used: usize = 0
        var triangle_count: usize = 0
        for size in sizes:
            if size < 3 or size > 256:
                error(errors.invalid, "a polygon needs 3..256 corners")
            used += (usize)size
            triangle_count += (usize)(size - 2)
        if used != corners.length or triangle_count > 33554432:
            error(errors.invalid, "polygon sizes must describe every corner")
        if let supplied = display:
            if supplied.length != triangle_count*3: error(errors.invalid,"display indices must cover every polygon")
        var minimum = Vector3()
        var maximum = Vector3()
        for index in 0..<points.length:
            let point = points[index]
            if not point.is_finite() or math.abs(point.x) > 1000000.0 or math.abs(point.y) > 1000000.0 or math.abs(point.z) > 1000000.0:
                error(errors.invalid, "mesh points must be finite and bounded to 1e6")
            if index == 0:
                minimum = point
                maximum = point
            else:
                minimum = Vector3(math.min(minimum.x, point.x), math.min(minimum.y, point.y), math.min(minimum.z, point.z))
                maximum = Vector3(math.max(maximum.x, point.x), math.max(maximum.y, point.y), math.max(maximum.z, point.z))
        for corner in corners:
            if corner < 0 or (usize)corner >= points.length:
                error(errors.invalid, "polygon references a missing point")
        let copied_points = try alloc Vector3[points.length] in memory.heap
        errdefer free(copied_points) in memory.heap
        let copied_sizes = try alloc i64[sizes.length] in memory.heap
        errdefer free(copied_sizes) in memory.heap
        let copied_corners = try alloc i64[corners.length] in memory.heap
        errdefer free(copied_corners) in memory.heap
        let offsets = try alloc usize[sizes.length + 1] in memory.heap
        errdefer free(offsets) in memory.heap
        let corner_faces = try alloc usize[corners.length] in memory.heap
        errdefer free(corner_faces) in memory.heap
        let normals = try alloc Vector3[sizes.length] in memory.heap
        errdefer free(normals) in memory.heap
        let triangles = try alloc i64[triangle_count * 3] in memory.heap
        errdefer free(triangles) in memory.heap
        let edge_a = try alloc i64[corners.length] in memory.heap
        errdefer free(edge_a) in memory.heap
        let edge_b = try alloc i64[corners.length] in memory.heap
        errdefer free(edge_b) in memory.heap
        let corner_edges = try alloc usize[corners.length] in memory.heap
        errdefer free(corner_edges) in memory.heap
        # Open-addressed edge table: linear construction, deterministic edge IDs.
        let table = try alloc i64[corners.length * 2 + 1] in memory.heap
        defer free(table) in memory.heap
        for index in 0..<table.length:
            table[index] = -1
        for index in 0..<points.length:
            copied_points[index] = points[index]
        for index in 0..<corners.length:
            copied_corners[index] = corners[index]
        var start: usize = 0
        var triangle: usize = 0
        var edges: usize = 0
        for face in 0..<sizes.length:
            let count = (usize)sizes[face]
            copied_sizes[face] = sizes[face]
            offsets[face] = start
            var normal = Vector3()
            var extent2: f64 = 0.0
            let origin = points[(usize)corners[start]]
            for at in 0..<count:
                let a = corners[start + at]
                let b = corners[start + (at + 1) % count]
                if a == b:
                    error(errors.invalid, "polygon has a collapsed edge")
                let delta = points[(usize)a].subtract(origin)
                extent2 = math.max(extent2,delta.dot(delta))
                normal = normal.add(delta.cross(points[(usize)b].subtract(origin)))
                corner_faces[start + at] = face
                let low = a if a < b else b
                let high = b if a < b else a
                var slot = ((usize)low * 65537 + (usize)high * 31) % table.length
                while table[slot] >= 0 and (edge_a[(usize)table[slot]] != low or edge_b[(usize)table[slot]] != high):
                    slot = (slot + 1) % table.length
                if table[slot] < 0:
                    table[slot] = (i64)edges
                    edge_a[edges] = low
                    edge_b[edges] = high
                    edges += 1
                corner_edges[start + at] = (usize)table[slot]
            normals[face] = try area_normal(normal,extent2)
            let output = triangles[triangle..<triangle + (count - 2) * 3]
            var provided = false
            if let supplied = display:
                let part = supplied[triangle..<triangle + (count - 2) * 3]
                if part[0] >= 0:
                    try display_triangles.validate(points,corners,start,count,part)
                    memory.copy(output,part,part.length)
                    provided = true
                else:
                    for index in part:
                        if index != -1: error(errors.invalid,"partial display triangulation is not valid")
            if not provided: try triangulate(points, corners, start, count, normals[face], output)
            triangle += (count - 2) * 3
            start += count
        offsets[sizes.length] = start
        let queries = try alloc QueryCache[1] in memory.heap
        errdefer free(queries) in memory.heap
        queries[0] = QueryCache()
        let topology_owners = try alloc SharedCount[1] in memory.heap
        errdefer free(topology_owners) in memory.heap
        topology_owners[0].count.store(1)
        let triangle_owners = try alloc SharedCount[1] in memory.heap
        errdefer free(triangle_owners) in memory.heap
        triangle_owners[0].count.store(1)
        self.attributes = try AttributeSet()
        self.topology_owners = topology_owners
        self.triangle_owners = triangle_owners
        self.queries = queries
        self.points = copied_points
        self.sizes = copied_sizes
        self.corners = copied_corners
        self.offsets = offsets
        self.corner_faces = corner_faces
        self.normals = normals
        self.triangles = triangles
        self.edge_a = edge_a
        self.edge_b = edge_b
        self.corner_edges = corner_edges
        self.edges = edges
        self.extent = Bounds(minimum, maximum)
        self.topology_key = topology_hash(points.length, sizes, corners)

    # Attribute-only edits keep the triangulation, edge index, bounds and BVH.
    func snapshot_storage() -> PolygonMesh*!:
        let storage = try alloc PolygonMesh[1] in memory.heap
        errdefer free(storage) in memory.heap
        let attributes = try AttributeSet()
        storage[0] = self
        storage[0].attributes = attributes
        discard(storage[0].queries[0].owners.add(1))
        return storage.data

    func snapshot() -> interop.Reference[PolygonMesh]!:
        return try interop.Reference[PolygonMesh].adopt(try self.snapshot_storage(), polygon_mesh_type, memory.heap)

    pub static func cube(size: f64 = 2.0) -> interop.Reference[PolygonMesh]!:
        if not (size > 0.0 and size <= 100000.0):
            error(errors.invalid, "cube size must be in (0,100000]")
        let h = size * 0.5
        let points: Vector3[8] = [Vector3(-h, 0.0, -h), Vector3(h, 0.0, -h), Vector3(h, size, -h), Vector3(-h, size, -h),
                                 Vector3(-h, 0.0, h), Vector3(h, 0.0, h), Vector3(h, size, h), Vector3(-h, size, h)]
        let sizes: i64[6] = [4, 4, 4, 4, 4, 4]
        let corners: i64[24] = [1, 2, 6, 5, 4, 7, 3, 0, 3, 7, 6, 2, 0, 1, 5, 4, 5, 6, 7, 4, 0, 3, 2, 1]
        return try make_mesh(points, sizes, corners)

    pub static func empty() -> interop.Reference[PolygonMesh]!:
        var points: Vector3[]
        var sizes: i64[]
        var corners: i64[]
        return try make_mesh(points, sizes, corners)

    pub func point_count() -> i64:
        return (i64)self.points.length
    ## Nonzero 64-bit connectivity hash (bit pattern as a signed integer).
    pub func topology_hash() -> i64:
        return (i64)self.topology_key
    pub func domain_count(domain: i64) -> i64!:
        if domain < 0 or domain > 3:
            error(errors.invalid, "unknown attribute domain")
        return (i64)(self.points.length if domain == 0 else (self.corners.length if domain == 1 else (self.sizes.length if domain == 2 else 1)))
    pub func attribute_count() -> i64:
        return (i64)self.attributes.count
    pub func find_attribute(name: str, domain: i64) -> i64:
        return self.attributes.find(name, domain)
    pub func attribute_name(index: i64) -> str!:
        try checked(index, self.attributes.count)
        return self.attributes.entries[(usize)index].name.value
    pub func attribute_domain(index: i64) -> i64!:
        try checked(index, self.attributes.count)
        return self.attributes.entries[(usize)index].domain
    pub func attribute_width(index: i64) -> i64!:
        try checked(index, self.attributes.count)
        return self.attributes.entries[(usize)index].width
    pub func attribute_integer(index: i64) -> bool!:
        try checked(index, self.attributes.count)
        return self.attributes.entries[(usize)index].integer
    pub func attribute_value(index: i64, element: i64, component: i64 = 0) -> f64!:
        try checked(index, self.attributes.count)
        let entry = &self.attributes.entries[(usize)index]
        try checked(component, (usize)entry.width)
        try checked(element, entry.values.length // (usize)entry.width)
        return entry.values[(usize)(element * entry.width + component)]
    pub func corner_point(corner: i64) -> i64!:
        try checked(corner, self.corners.length)
        return self.corners[(usize)corner]
    pub func corner_face(corner: i64) -> i64!:
        try checked(corner, self.corners.length)
        return (i64)self.corner_faces[(usize)corner]
    pub func corner_edge(corner: i64) -> i64!:
        try checked(corner, self.corners.length)
        return (i64)self.corner_edges[(usize)corner]
    pub func face_offset(face: i64) -> i64!:
        try checked(face, self.sizes.length)
        return (i64)self.offsets[(usize)face]

    ## All operators publish new meshes. Parent maps are output-to-input indices;
    ## -1 means a genuinely new element (zero-valued attributes). Empty maps mean
    ## unchanged indexing, valid only when domain cardinality is unchanged.
    pub func remapped(points: const Vector3[], sizes: const i64[], corners: const i64[],
                      point_parents: const i64[], face_parents: const i64[], corner_parents: const i64[], preserve_normals: bool = false, display: const i64[]? = none) -> interop.Reference[PolygonMesh]!:
        try validate_map(point_parents, points.length, self.points.length)
        try validate_map(face_parents, sizes.length, self.sizes.length)
        try validate_map(corner_parents, corners.length, self.corners.length)
        let result = try make_mesh(points, sizes, corners, display)
        errdefer result.release()
        var unchanged_geometry = points.length == self.points.length and sizes.length == self.sizes.length and corners.length == self.corners.length
        if unchanged_geometry and not preserve_normals:
            for at in 0..<points.length:
                unchanged_geometry = unchanged_geometry and points[at].x == self.points[at].x and points[at].y == self.points[at].y and points[at].z == self.points[at].z
            for at in 0..<sizes.length:
                unchanged_geometry = unchanged_geometry and sizes[at] == self.sizes[at]
            for at in 0..<corners.length:
                unchanged_geometry = unchanged_geometry and corners[at] == self.corners[at]
        for index in 0..<self.attributes.count:
            let entry = &self.attributes.entries[index]
            # Derived shading normals become stale after arbitrary modeling edits.
            # Rigid/affine transforms explicitly retain and inverse-transpose them.
            if entry.name.value == "N" and not unchanged_geometry and not preserve_normals:
                continue
            let parents = point_parents if entry.domain == 0 else (corner_parents if entry.domain == 1 else face_parents)
            let count = (usize)(try result.value().domain_count(entry.domain))
            let values = try alloc f64[count * (usize)entry.width] in memory.heap
            defer free(values) in memory.heap
            for element in 0..<count:
                let parent = (i64)element if parents.length == 0 or entry.domain == 3 else parents[element]
                for component in 0..<(usize)entry.width:
                    values[element * (usize)entry.width + component] = entry.values[(usize)parent * (usize)entry.width + component] if parent >= 0 else 0.0
            try result.value().attributes.put(entry.name.value, entry.domain, entry.width, values, entry.integer)
        return result

    pub func with_attribute(name: str, domain: i64, width: i64, values: const f64[], integer: bool = false) -> interop.Reference[PolygonMesh]!:
        let count = try self.domain_count(domain)
        if width < 1 or width > 4 or values.length != (usize)(count * width):
            error(errors.invalid, "attribute length must match its geometry domain")
        let result = try self.snapshot()
        errdefer result.release()
        var replaced = false
        for entry in self.attributes.entries[..<self.attributes.count]:
            if entry.name.value == name and entry.domain == domain:
                try result.value().attributes.put(name, domain, width, values, integer)
                replaced = true
            else:
                try result.value().attributes.put(entry.name.value, entry.domain, entry.width, entry.values, entry.integer)
        if not replaced: try result.value().attributes.put(name, domain, width, values, integer)
        return result

    ## Nearest Euclidean distance to the mesh surface; -1 for an empty mesh.
    pub func surface_distance(point: Vector3) -> f64!:
        if not point.is_finite(): error(errors.invalid, "distance query requires a finite point")
        return (try self.queries[0].get(self.points, self.corners, self.triangles, self.corner_faces)).distance(point)

    ## Primitive containing the closest surface point, or -1 for empty geometry.
    pub func closest_face(point: Vector3) -> i64!:
        if not point.is_finite(): error(errors.invalid, "distance query requires a finite point")
        return (try self.queries[0].get(self.points, self.corners, self.triangles, self.corner_faces)).nearest(point).face

    ## Build the shared query index now, for example before worker-to-UI transfer.
    ## Otherwise the first ray/distance query builds it. Failure is retryable.
    pub func prepare_queries() -> !:
        discard(try self.queries[0].get(self.points, self.corners, self.triangles, self.corner_faces))

    ## Construct topology and its imported corner data once, without rebuilding
    ## triangulation, edge tables and BVH for each attribute. Empty spans omit it.
    pub static func from_corner_data(points: const Vector3[], sizes: const i64[], corners: const i64[], uv: const f64[], normals: const f64[]) -> interop.Reference[PolygonMesh]!:
        if (uv.length != 0 and uv.length != corners.length * 2) or (normals.length != 0 and normals.length != corners.length * 3):
            error(errors.invalid, "imported corner attribute size mismatch")
        let result = try make_mesh(points, sizes, corners)
        errdefer result.release()
        if uv.length > 0: try result.value().attributes.put("uv", 1, 2, uv, false)
        if normals.length > 0: try result.value().attributes.put("N", 1, 3, normals, false)
        return result

    ## Native owner for a worker mailbox: it shares the immutable storage and
    ## query index through atomic counts and owns a copy of the attributes. No
    ## ARC owners, callbacks or borrowed spans cross threads; the receiver
    ## adopts it on its thread.
    func detached_copy() -> PolygonMesh*!:
        let result = try self.snapshot_storage()
        errdefer dispose_detached(result)
        for entry in self.attributes.entries[..<self.attributes.count]:
            try result.attributes.put(entry.name.value, entry.domain, entry.width, entry.values, entry.integer)
        return result

    pub func without_attribute(name: str, domain: i64) -> interop.Reference[PolygonMesh]!:
        let result = try self.snapshot()
        errdefer result.release()
        for index in 0..<self.attributes.count:
            let entry = &self.attributes.entries[index]
            if entry.name.value != name or entry.domain != domain:
                try result.value().attributes.put(entry.name.value, entry.domain, entry.width, entry.values, entry.integer)
        return result

    pub func renamed_attribute(name: str, replacement: str, domain: i64) -> interop.Reference[PolygonMesh]!:
        let index = self.attributes.find(name, domain)
        if index < 0:
            error(errors.invalid, "attribute to rename does not exist")
        let removed = try self.without_attribute(name, domain)
        defer removed.release()
        let entry = &self.attributes.entries[(usize)index]
        return try removed.value().with_attribute(replacement, domain, entry.width, entry.values, entry.integer)

    ## Numeric domain conversion: continuous values average incident source
    ## elements, integers keep the first contributor. Isolated targets get zero.
    pub func promoted_attribute(name: str, domain: i64, target: i64) -> interop.Reference[PolygonMesh]!:
        let index = self.attributes.find(name, domain)
        if index < 0:
            error(errors.invalid, "attribute to promote does not exist")
        let entry = &self.attributes.entries[(usize)index]
        let count = (usize)(try self.domain_count(target))
        let source_count = (usize)(try self.domain_count(domain))
        let width = (usize)entry.width
        let values = try alloc f64[count * width] in memory.heap
        defer free(values) in memory.heap
        let weights = try alloc usize[count] in memory.heap
        defer free(weights) in memory.heap
        for at in 0..<values.length:
            values[at] = 0.0
        for at in 0..<count:
            weights[at] = 0
        let contributions = count if domain == target or domain == 3 else (source_count if target == 3 else self.corners.length)
        for at in 0..<contributions:
            let source = at if domain == target or target == 3 else (0 if domain == 3 else ((usize)self.corners[at] if domain == 0 else (self.corner_faces[at] if domain == 2 else at)))
            let destination = at if domain == target or domain == 3 else (0 if target == 3 else ((usize)self.corners[at] if target == 0 else (self.corner_faces[at] if target == 2 else at)))
            for component in 0..<width:
                if not entry.integer or weights[destination] == 0:
                    values[destination * width + component] += entry.values[source * width + component]
            weights[destination] += 1
        if not entry.integer:
            for at in 0..<count:
                if weights[at] > 0:
                    for component in 0..<width:
                        values[at * width + component] /= (f64)weights[at]
        return try self.with_attribute(name, target, entry.width, values, entry.integer)

    ## Position-only edits keep this mesh's topology (edges, corner maps) and
    ## its triangle indices, recomputing moved faces' normals and the bounds.
    ## The spatial index is rebuilt lazily on the first query. Stale shading
    ## normals ("N") are dropped once any point moves, as for other edits.
    pub func with_positions(points: const Vector3[]) -> interop.Reference[PolygonMesh]!:
        return try self.repositioned(points, false)

    func repositioned(points: const Vector3[], rigid: bool) -> interop.Reference[PolygonMesh]!:
        var edit = try positions.reposition(self.points, points, self.sizes, self.corners, self.offsets, self.normals, self.triangles, rigid)
        if not edit.moved:
            edit.close()
            let same = try self.snapshot()
            errdefer same.release()
            try positions.copy_attributes(&self.attributes, &same.value().attributes, true)
            return same
        let result = try interop.Reference[PolygonMesh].adopt(try self.repositioned_storage(&edit), polygon_mesh_type, memory.heap)
        errdefer result.release()
        try positions.copy_attributes(&self.attributes, &result.value().attributes, rigid)
        return result

    ## Takes the edit's arrays on success; frees them on failure.
    func repositioned_storage(edit: positions.Repositioned*) -> PolygonMesh*!:
        errdefer edit.close()
        let queries = try alloc QueryCache[1] in memory.heap
        errdefer free(queries) in memory.heap
        queries[0] = QueryCache()
        let storage = try alloc PolygonMesh[1] in memory.heap
        errdefer free(storage) in memory.heap
        var attributes = try AttributeSet()
        errdefer attributes.close()
        var triangle_owners = self.triangle_owners
        if edit.triangles.length > 0:
            triangle_owners = try alloc SharedCount[1] in memory.heap
            triangle_owners[0].count.store(0)
        storage[0] = self
        storage[0].attributes = attributes
        storage[0].points = edit.points
        storage[0].normals = edit.normals
        storage[0].extent = edit.extent
        storage[0].queries = queries
        storage[0].triangles = edit.triangles if edit.triangles.length > 0 else self.triangles
        storage[0].triangle_owners = triangle_owners
        discard(storage[0].topology_owners[0].count.add(1))
        discard(triangle_owners[0].count.add(1))
        return storage.data

    pub func face_count() -> i64:
        return (i64)self.sizes.length
    pub func edge_count() -> i64:
        return (i64)self.edges
    pub func vertex_count() -> i64:
        return (i64)self.corners.length
    pub func index_count() -> i64:
        return (i64)self.triangles.length
    pub func triangle_face(triangle: i64) -> i64!:
        try checked(triangle, self.triangles.length // 3)
        return (i64)self.corner_faces[(usize)self.triangles[(usize)triangle * 3]]
    pub func bounds() -> Bounds:
        return self.extent

    pub func point(index: i64) -> Vector3!:
        try checked(index, self.points.length)
        return self.points[(usize)index]
    pub func face_size(face: i64) -> i64!:
        try checked(face, self.sizes.length)
        return self.sizes[(usize)face]
    pub func face_point(face: i64, corner: i64) -> i64!:
        try checked(face, self.sizes.length)
        try checked(corner, (usize)self.sizes[(usize)face])
        return self.corners[self.offsets[(usize)face] + (usize)corner]

    ## Shared undirected edge ID for a polygon's outgoing corner edge.
    pub func face_edge(face: i64, corner: i64) -> i64!:
        try checked(face, self.sizes.length)
        try checked(corner, (usize)self.sizes[(usize)face])
        return (i64)self.corner_edges[self.offsets[(usize)face] + (usize)corner]
    pub func face_normal(face: i64) -> Vector3!:
        try checked(face, self.sizes.length)
        return self.normals[(usize)face]
    pub func face_center(face: i64) -> Vector3!:
        try checked(face, self.sizes.length)
        var sum = Vector3()
        for at in self.offsets[(usize)face]..<self.offsets[(usize)face + 1]:
            sum = sum.add(self.points[(usize)self.corners[at]])
        return sum.multiply_scalar(1.0 / (f64)self.sizes[(usize)face])
    pub func edge_point(edge: i64, end: i64) -> i64!:
        try checked(edge, self.edges)
        if end != 0 and end != 1:
            error(errors.invalid, "edge endpoint must be 0 or 1")
        return self.edge_a[(usize)edge] if end == 0 else self.edge_b[(usize)edge]

    pub func vertex(index: i64) -> interop.Outcome[Vertex]:
        if index < 0 or (usize)index >= self.corners.length:
            return errors.failure[Vertex](errors.invalid, "polygon vertex out of range")
        let face = self.corner_faces[(usize)index]
        let at = (usize)index - self.offsets[face]
        var color = Vector3(1.0, 1.0, 1.0)
        let normal = self.shading_normal((usize)index, face)
        var u = 1.0 if at == 1 or at == 2 else 0.0
        var v = 1.0 if at >= 2 else 0.0
        # Houdini-style corner > point > primitive > detail lookup precedence.
        let domains: i64[4] = [3, 2, 0, 1]
        for domain in domains:
            let element = (usize)(0 if domain == 3 else ((i64)face if domain == 2 else (self.corners[(usize)index] if domain == 0 else index)))
            let cd = self.attributes.colors[(usize)domain]
            if cd >= 0 and self.attributes.entries[(usize)cd].width >= 3:
                let entry = &self.attributes.entries[(usize)cd]
                let start = element * (usize)entry.width
                color = Vector3(math.max(0.0, math.min(1.0, entry.values[start])), math.max(0.0, math.min(1.0, entry.values[start + 1])), math.max(0.0, math.min(1.0, entry.values[start + 2])))
            let uv = self.attributes.uvs[(usize)domain]
            if uv >= 0 and self.attributes.entries[(usize)uv].width >= 2:
                let entry = &self.attributes.entries[(usize)uv]
                let start = element * (usize)entry.width
                u = entry.values[start]
                v = entry.values[start + 1]
        return errors.success[Vertex](Vertex(self.points[(usize)self.corners[(usize)index]], normal, u, v, color))
    ## A corner's shading normal alone, without building a whole Vertex; bulk
    ## overlay extraction calls it for every corner.
    pub func corner_normal(corner: i64) -> Vector3!:
        try checked(corner, self.corners.length)
        return self.shading_normal((usize)corner, self.corner_faces[(usize)corner])

    ## The N attribute by corner > point > primitive > detail precedence,
    ## else the face normal.
    func shading_normal(corner: usize, face: usize) -> Vector3:
        var normal = self.normals[face]
        let domains: i64[4] = [3, 2, 0, 1]
        for domain in domains:
            let ni = self.attributes.normals[(usize)domain]
            if ni < 0 or self.attributes.entries[(usize)ni].width != 3:
                continue
            let element = 0 if domain == 3 else (face if domain == 2 else ((usize)self.corners[corner] if domain == 0 else corner))
            let entry = &self.attributes.entries[(usize)ni]
            let provided = Vector3(entry.values[element * 3], entry.values[element * 3 + 1], entry.values[element * 3 + 2])
            if provided.length() > 0.000000001:
                normal = provided.multiply_scalar(1.0 / provided.length())
        return normal

    pub func index(offset: i64) -> interop.Outcome[i64]:
        if offset < 0 or (usize)offset >= self.triangles.length:
            return errors.failure[i64](errors.invalid, "polygon triangle index out of range")
        return errors.success[i64](self.triangles[(usize)offset])

    pub func transformed(translation: Vector3, rotation: Vector3, scale: Vector3) -> interop.Reference[PolygonMesh]!:
        if not translation.is_finite() or not rotation.is_finite() or not scale.is_finite() or math.abs(scale.x) < 0.000001 or math.abs(scale.y) < 0.000001 or math.abs(scale.z) < 0.000001:
            error(errors.invalid, "mesh transform must be finite and nonsingular")
        let matrix = Matrix4.compose(translation, rotation, scale)
        return try self.placed(matrix)

    ## Affine placement preserves attributes and inverse-transposes normals.
    pub func placed(matrix: Matrix4) -> interop.Reference[PolygonMesh]!:
        if not matrix.is_finite() or math.abs(matrix.determinant()) < 0.000000000001:
            error(errors.invalid, "mesh placement must be finite and nonsingular")
        let points = try alloc Vector3[self.points.length] in memory.heap
        defer free(points) in memory.heap
        for index in 0..<points.length:
            points[index] = matrix.transform_point(self.points[index])
        # Without a reflection, placement is a position-only edit: topology and
        # triangles are shared, and no triangle can fold.
        if matrix.determinant() > 0.0:
            let moved = try self.repositioned(points, true)
            errdefer moved.release()
            try positions.transform_normals(&moved.value().attributes, matrix)
            return moved
        # Reversing corners preserves outward normals under a reflection.
        let corners = try alloc i64[self.corners.length] in memory.heap
        defer free(corners) in memory.heap
        let parents = try alloc i64[self.corners.length] in memory.heap
        defer free(parents) in memory.heap
        for face in 0..<self.sizes.length:
            let start = self.offsets[face]
            let count = (usize)self.sizes[face]
            for at in 0..<count:
                corners[start + at] = self.corners[start + (count - 1 - at if matrix.determinant() < 0.0 else at)]
                parents[start + at] = (i64)(start + (count - 1 - at if matrix.determinant() < 0.0 else at))
        var unchanged: i64[]
        let display = try alloc i64[self.triangles.length] in memory.heap
        defer free(display) in memory.heap
        let reflected = matrix.determinant() < 0.0
        for triangle in 0..<display.length//3:
            for at in 0..<(usize)3:
                let old = (usize)self.triangles[triangle*3+(2-at if reflected else at)]
                display[triangle*3+at] = parents[old]
        let result = try self.remapped(points, self.sizes, corners, unchanged, unchanged, parents, true, display)
        errdefer result.release()
        try positions.transform_normals(&result.value().attributes, matrix)
        return result

    pub func moved_points(selection: const i64[], delta: Vector3) -> interop.Reference[PolygonMesh]!:
        if not delta.is_finite():
            error(errors.invalid, "point displacement must be finite")
        let marked = try alloc bool[self.points.length] in memory.heap
        defer free(marked) in memory.heap
        for index in 0..<marked.length:
            marked[index] = false
        for index in selection:
            try checked(index, self.points.length)
            marked[(usize)index] = true
        let points = try alloc Vector3[self.points.length] in memory.heap
        defer free(points) in memory.heap
        for index in 0..<points.length:
            points[index] = self.points[index].add(delta) if marked[index] else self.points[index]
        return try self.with_positions(points)

    pub func merged(other: interop.Reference[PolygonMesh]) -> interop.Reference[PolygonMesh]!:
        let rhs = try other.get()
        if self.points.length + rhs.points.length > 8388608 or self.corners.length + rhs.corners.length > 33554432:
            error(errors.limit, "merged mesh exceeds geometry limits")
        let points = try alloc Vector3[self.points.length + rhs.points.length] in memory.heap
        defer free(points) in memory.heap
        let sizes = try alloc i64[self.sizes.length + rhs.sizes.length] in memory.heap
        defer free(sizes) in memory.heap
        let corners = try alloc i64[self.corners.length + rhs.corners.length] in memory.heap
        defer free(corners) in memory.heap
        for index in 0..<points.length:
            points[index] = self.points[index] if index < self.points.length else rhs.points[index - self.points.length]
        for index in 0..<sizes.length:
            sizes[index] = self.sizes[index] if index < self.sizes.length else rhs.sizes[index - self.sizes.length]
        for index in 0..<corners.length:
            corners[index] = self.corners[index] if index < self.corners.length else rhs.corners[index - self.corners.length] + (i64)self.points.length
        let display = try alloc i64[self.triangles.length+rhs.triangles.length] in memory.heap
        defer free(display) in memory.heap
        for at in 0..<display.length:
            display[at] = self.triangles[at] if at < self.triangles.length else rhs.triangles[at-self.triangles.length]+(i64)self.corners.length
        let result = try make_mesh(points, sizes, corners, display)
        errdefer result.release()
        try merge_attributes(&self.attributes, &rhs.attributes, &self, rhs, result.value())
        return result

    ## Region extrusion: duplicate selected points once, replace caps in place,
    ## and create walls only at the region boundary (never between selected faces).
    ## Face IDs of caps are stable so repeated extrusions keep their selection.
    pub func extruded_faces(selection: const i64[], distance: f64) -> interop.Reference[PolygonMesh]!:
        if selection.length == 0 or not math.is_finite(distance) or math.abs(distance) < 0.000001:
            error(errors.invalid, "extrusion needs selected faces and a finite nonzero distance")
        let selected = try alloc bool[self.sizes.length] in memory.heap
        defer free(selected) in memory.heap
        let counts = try alloc i64[self.edges] in memory.heap
        defer free(counts) in memory.heap
        let mapping = try alloc i64[self.points.length] in memory.heap
        defer free(mapping) in memory.heap
        let directions = try alloc Vector3[self.points.length] in memory.heap
        defer free(directions) in memory.heap
        for face in 0..<selected.length:
            selected[face] = false
        for edge in 0..<counts.length:
            counts[edge] = 0
        for index in 0..<mapping.length:
            mapping[index] = -1
            directions[index] = Vector3()
        for face in selection:
            try checked(face, self.sizes.length)
            selected[(usize)face] = true
        for face in 0..<self.sizes.length:
            if not selected[face]:
                continue
            for at in self.offsets[face]..<self.offsets[face + 1]:
                counts[self.corner_edges[at]] += 1
                let point = (usize)self.corners[at]
                mapping[point] = 0
                directions[point] = directions[point].add(self.normals[face])
        var walls: usize = 0
        for count in counts:
            if count == 1:
                walls += 1
            elif count > 2:
                error(errors.invalid, "cannot extrude a nonmanifold region")
        if walls == 0:
            error(errors.invalid, "extrude a face region with a boundary, not an entire closed surface")
        var points_count = self.points.length
        for index in 0..<mapping.length:
            if mapping[index] >= 0:
                mapping[index] = (i64)points_count
                points_count += 1
        if points_count > 8388608 or self.corners.length + walls * 4 > 33554432:
            error(errors.limit, "extrusion exceeds geometry limits")
        let points = try alloc Vector3[points_count] in memory.heap
        defer free(points) in memory.heap
        let sizes = try alloc i64[self.sizes.length + walls] in memory.heap
        defer free(sizes) in memory.heap
        let corners = try alloc i64[self.corners.length + walls * 4] in memory.heap
        defer free(corners) in memory.heap
        let point_parents = try alloc i64[points_count] in memory.heap
        defer free(point_parents) in memory.heap
        let face_parents = try alloc i64[sizes.length] in memory.heap
        defer free(face_parents) in memory.heap
        let corner_parents = try alloc i64[corners.length] in memory.heap
        defer free(corner_parents) in memory.heap
        for index in 0..<self.points.length:
            points[index] = self.points[index]
            point_parents[index] = (i64)index
            if mapping[index] >= 0:
                point_parents[(usize)mapping[index]] = (i64)index
                let direction = try directions[index].normalized()
                points[(usize)mapping[index]] = self.points[index].add(direction.multiply_scalar(distance))
        var next_face = self.sizes.length
        var next_corner = self.corners.length
        for face in 0..<self.sizes.length:
            sizes[face] = self.sizes[face]
            face_parents[face] = (i64)face
            let start = self.offsets[face]
            let count = (usize)self.sizes[face]
            for at in 0..<count:
                let a = self.corners[start + at]
                corners[start + at] = mapping[(usize)a] if selected[face] else a
                corner_parents[start + at] = (i64)(start + at)
                if selected[face] and counts[self.corner_edges[start + at]] == 1:
                    let b = self.corners[start + (at + 1) % count]
                    sizes[next_face] = 4
                    face_parents[next_face] = (i64)face
                    next_face += 1
                    corners[next_corner] = a
                    corners[next_corner + 1] = b
                    corners[next_corner + 2] = mapping[(usize)b]
                    corners[next_corner + 3] = mapping[(usize)a]
                    corner_parents[next_corner] = (i64)(start + at)
                    corner_parents[next_corner + 1] = (i64)(start + (at + 1) % count)
                    corner_parents[next_corner + 2] = corner_parents[next_corner + 1]
                    corner_parents[next_corner + 3] = corner_parents[next_corner]
                    next_corner += 4
        # Original faces keep their corner slots, so their triangles (CAD display
        # triangles included) stay valid; only the new quad walls triangulate.
        let display = try alloc i64[self.triangles.length + walls * 6] in memory.heap
        defer free(display) in memory.heap
        memory.copy(display, self.triangles, self.triangles.length)
        for at in self.triangles.length..<display.length:
            display[at] = -1
        return try self.remapped(points, sizes, corners, point_parents, face_parents, corner_parents, false, display)

    ## Nearest two-sided face intersection. -1 means no hit; direction must be
    ## normalized for the returned distance to be world-space distance.
    pub func ray_face(origin: Vector3, direction: Vector3) -> i64!:
        return (try self.queries[0].get(self.points, self.corners, self.triangles, self.corner_faces)).ray(origin, direction).face

    pub func ray_distance(origin: Vector3, direction: Vector3) -> f64!:
        return (try self.queries[0].get(self.points, self.corners, self.triangles, self.corner_faces)).ray(origin, direction).distance

    pub mutating func close():
        self.attributes.close()
        if self.queries[0].owners.sub(1, .acq_rel) > 1: return
        self.queries[0].close()
        free(self.queries) in memory.heap
        free(self.points) in memory.heap
        free(self.normals) in memory.heap
        if self.triangle_owners[0].count.sub(1, .acq_rel) == 1:
            free(self.triangles) in memory.heap
            free(self.triangle_owners) in memory.heap
        if self.topology_owners[0].count.sub(1, .acq_rel) > 1: return
        free(self.topology_owners) in memory.heap
        free(self.sizes) in memory.heap
        free(self.corners) in memory.heap
        free(self.offsets) in memory.heap
        free(self.corner_faces) in memory.heap
        free(self.edge_a) in memory.heap
        free(self.edge_b) in memory.heap
        free(self.corner_edges) in memory.heap

pub let polygon_mesh_type: interop.Type[PolygonMesh] = interop.Type[PolygonMesh]("PolygonMesh", PolygonMesh.close, closeable = true)

## Base-only transfer API; receiver exclusively owns the returned heap storage.
pub func detached_mesh(source: interop.Reference[PolygonMesh]) -> PolygonMesh*!:
    return try source.value().detached_copy()

func dispose_detached(mesh: PolygonMesh*):
    mesh.close()
    free(mesh) in memory.heap

func make_mesh(points: const Vector3[], sizes: const i64[], corners: const i64[], display: const i64[]? = none) -> interop.Reference[PolygonMesh]!:
    return try interop.Reference[PolygonMesh].adopt(new PolygonMesh(points, sizes, corners, display) in memory.heap, polygon_mesh_type, memory.heap)

func checked(index: i64, length: usize) -> !:
    if index < 0 or (usize)index >= length:
        error(errors.invalid, "mesh element index is out of range")

func validate_map(parents: const i64[], count: usize, old_count: usize) -> !:
    if parents.length == 0:
        if count != 0 and count != old_count:
            error(errors.invalid, "changed topology requires explicit attribute parent maps")
        return
    if parents.length != count:
        error(errors.invalid, "attribute parent map has the wrong length")
    for parent in parents:
        if parent < -1 or (parent >= 0 and (usize)parent >= old_count):
            error(errors.invalid, "attribute parent index out of range")

func merge_attributes(left: const AttributeSet*, right: const AttributeSet*, a: const PolygonMesh*, b: const PolygonMesh*, output: PolygonMesh*) -> !:
    for side in 0..<(usize)2:
        let source = left if side == 0 else right
        for index in 0..<source.count:
            let entry = &source.entries[index]
            let ai = left.find(entry.name.value, entry.domain)
            let bi = right.find(entry.name.value, entry.domain)
            if side == 1 and ai >= 0:
                continue
            if ai >= 0 and bi >= 0:
                let other = &right.entries[(usize)bi]
                if entry.width != other.width or entry.integer != other.integer:
                    error(errors.invalid, "Merge inputs have conflicting attribute schemas")
            let na = (usize)(try a.domain_count(entry.domain))
            let nb = (usize)(try b.domain_count(entry.domain))
            let count = 1 if entry.domain == 3 else na + nb
            let values = try alloc f64[count * (usize)entry.width] in memory.heap
            defer free(values) in memory.heap
            for element in 0..<count:
                let use_left = element < na and (entry.domain != 3 or ai >= 0)
                let found = ai if use_left else bi
                let source_set = left if use_left else right
                let source_element = element if use_left or entry.domain == 3 else element - na
                for component in 0..<(usize)entry.width:
                    values[element * (usize)entry.width + component] = source_set.entries[(usize)found].values[source_element * (usize)entry.width + component] if found >= 0 else 0.0
            try output.attributes.put(entry.name.value, entry.domain, entry.width, values, entry.integer)
