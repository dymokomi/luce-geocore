## Owned structure-of-arrays numeric attributes. No graph or UI dependencies.
## Domains: 0 point, 1 face corner, 2 primitive, 3 detail.
import interop
import memory
import math
import luce_geocore.errors as errors

pub struct Attribute:
    pub let name: interop.Packet[str]
    pub let domain: i64
    pub let width: i64
    pub let integer: bool
    pub let values: f64[]

    pub func init(name: str, domain: i64, width: i64, values: const f64[], integer: bool) -> !:
        if name.length == 0 or name.length > 64 or name == "P" or domain < 0 or domain > 3 or width < 1 or width > 4 or values.length % (usize)width != 0:
            error(errors.invalid, "attribute needs a nonreserved name, domain 0..3 and tuple size 1..4")
        if values.length // (usize)width > 33554432:
            error(errors.limit, "attribute exceeds 33554432 tuples")
        for value in values:
            if not math.is_finite(value) or (integer and (math.abs(value) > 9007199254740991.0 or math.floor(value) != value)):
                error(errors.invalid, "attribute values must be finite and integer values exactly representable")
        let copied_name = try interop.text_transfer.copy(name)
        errdefer copied_name.release()
        let copied = try alloc f64[values.length] in memory.heap
        for index in 0..<values.length:
            copied[index] = values[index]
        self.name = copied_name
        self.domain = domain
        self.width = width
        self.integer = integer
        self.values = copied

    pub mutating func close():
        self.name.release()
        free(self.values) in memory.heap

pub struct AttributeSet:
    pub let entries: Attribute[]
    pub var count: usize
    pub var colors: i64[4]
    pub var uvs: i64[4]
    pub var normals: i64[4]

    pub func init() -> !:
        self.entries = try alloc Attribute[32] in memory.heap
        self.count = 0
        self.colors = [-1, -1, -1, -1]
        self.uvs = [-1, -1, -1, -1]
        self.normals = [-1, -1, -1, -1]

    pub func find(name: str, domain: i64) -> i64:
        for index in 0..<self.count:
            if self.entries[index].name.value == name and self.entries[index].domain == domain:
                return (i64)index
        return -1

    pub mutating func put(name: str, domain: i64, width: i64, values: const f64[], integer: bool) -> !:
        let found = self.find(name, domain)
        if found < 0 and self.count == 32:
            error(errors.limit, "a mesh supports at most 32 named attributes")
        let replacement = try Attribute(name, domain, width, values, integer)
        let index = found if found >= 0 else (i64)self.count
        if name == "Cd":
            self.colors[(usize)domain] = index
        if name == "uv":
            self.uvs[(usize)domain] = index
        if name == "N":
            self.normals[(usize)domain] = index
        if found >= 0:
            self.entries[(usize)found].close()
            self.entries[(usize)found] = replacement
        else:
            self.entries[self.count] = replacement
            self.count += 1

    pub mutating func close():
        for index in 0..<self.count:
            self.entries[index].close()
        free(self.entries) in memory.heap
        self.count = 0
