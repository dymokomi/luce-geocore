## Pure mesh operators, independent of editor commands and graph evaluation.
import interop
import memory
import math
import luce_geocore.errors as errors
from luce_geocore.math.vector import Vector3
from luce_geocore.math.matrix import Matrix4
from luce_geocore.geometries.polygon import Mesh
from luce_geocore.geometries.builder import MeshBuilder, selection_mask

pub struct MeshOps:
    let reserved: u8 = 0
    pub static func delete_points(source: interop.Reference[Mesh], selection: const i64[]) -> interop.Reference[Mesh]!:
        let mesh = try source.get()
        let marked = try selection_mask(selection, mesh.point_count())
        defer free(marked) in memory.heap
        let mapping = try alloc i64[(usize)mesh.point_count()] in memory.heap
        defer free(mapping) in memory.heap
        var out = try MeshBuilder()
        defer out.close()
        for id in 0..<mesh.point_count():
            mapping[(usize)id] = -1 if marked[(usize)id] else (try out.point(try mesh.point(id), id))
        for face in 0..<mesh.face_count():
            let count = try mesh.face_size(face)
            var removed = false
            for at in 0..<count:
                if marked[(usize)(try mesh.face_point(face, at))]:
                    removed = true
            if not removed:
                try out.face(count, face)
                for at in 0..<count:
                    try out.corner(mapping[(usize)(try mesh.face_point(face, at))], (try mesh.face_offset(face)) + at)
                try out.copy_last_display(mesh,face)
        return try out.finish(mesh)

    ## Remove unused points without altering faces, display triangles or normals.
    pub static func compact(source: interop.Reference[Mesh]) -> interop.Reference[Mesh]!:
        let mesh = try source.get()
        let used = try alloc bool[(usize)mesh.point_count()] in memory.heap
        defer free(used) in memory.heap
        let mapping = try alloc i64[(usize)mesh.point_count()] in memory.heap
        defer free(mapping) in memory.heap
        for id in 0..<used.length:
            used[id] = false
        for corner in 0..<mesh.vertex_count():
            used[(usize)(try mesh.corner_point(corner))] = true
        var out = try MeshBuilder()
        defer out.close()
        for id in 0..<used.length:
            mapping[id] = (try out.point(try mesh.point((i64)id),(i64)id)) if used[id] else -1
        for face in 0..<mesh.face_count():
            let count = try mesh.face_size(face)
            let first = try mesh.face_offset(face)
            try out.face(count,face)
            for at in 0..<count:
                try out.corner(mapping[(usize)(try mesh.face_point(face,at))],first+at)
            try out.copy_last_display(mesh,face)
        return try out.finish(mesh,true)
    ## 0 delete faces, 1 reverse, 2 triangulate, 3 individual-face inset,
    ## 4 duplicate faces with normal offset, 5 split selected faces apart.
    pub static func faces(source: interop.Reference[Mesh], selection: const i64[], operation: i64, amount: f64 = 0.2) -> interop.Reference[Mesh]!:
        let mesh = try source.get()
        if operation < 0 or operation > 5 or not math.is_finite(amount):
            error(errors.invalid, "unknown face operation or nonfinite amount")
        if operation == 3 and not (amount > 0.0 and amount < 1.0):
            error(errors.invalid, "Inset fraction must be between 0 and 1")
        let selected = try selection_mask(selection, mesh.face_count())
        defer free(selected) in memory.heap
        var out = try MeshBuilder()
        defer out.close()
        try out.copy_points(mesh)
        for face in 0..<mesh.face_count():
            if not selected[(usize)face]:
                try out.copy_face(mesh, face)
                continue
            let count = try mesh.face_size(face)
            let offset = try mesh.face_offset(face)
            if operation == 0:
                continue
            if operation == 1:
                try out.face(count, face)
                for at in 0..<count:
                    try out.corner(try mesh.face_point(face, count - at - 1), offset + count - at - 1)
                try out.copy_last_display(mesh,face,true)
            elif operation == 2:
                for triangle in 0..<mesh.index_count() // 3:
                    if try mesh.triangle_face(triangle) != face:
                        continue
                    try out.face(3, face)
                    for at in 0..<(i64)3:
                        let fetched = mesh.index(triangle * 3 + at)
                        defer fetched.release()
                        let corner = try fetched.get()
                        try out.corner(try mesh.corner_point(corner), corner)
            else:
                if operation == 4:
                    try out.copy_face(mesh, face)
                let center = try mesh.face_center(face)
                let normal = try mesh.face_normal(face)
                var inner: i64[256]
                for at in 0..<count:
                    let original = try mesh.face_point(face, at)
                    let p = try mesh.point(original)
                    let position = p.add(center.subtract(p).multiply_scalar(amount)) if operation == 3 else (p.add(normal.multiply_scalar(amount)) if operation == 4 else p)
                    inner[(usize)at] = try out.point(position, original)
                try out.face(count, face)
                for at in 0..<count:
                    try out.corner(inner[(usize)at], offset + at)
                # Inset, duplicate-offset and split all apply an affine map
                # within this face, so its display triangulation stays valid.
                try out.copy_last_display(mesh,face)
                if operation == 3:
                    for at in 0..<count:
                        let next = (at + 1) % count
                        try out.face(4, face)
                        try out.corner(try mesh.face_point(face, at), offset + at)
                        try out.corner(try mesh.face_point(face, next), offset + next)
                        try out.corner(inner[(usize)next], offset + next)
                        try out.corner(inner[(usize)at], offset + at)
        # Face filtering (including Blast) retains exactly the original corners,
        # so authored CAD/import normals remain valid. Geometric edits below
        # still invalidate them rather than retaining stale shading.
        return try out.finish(mesh,operation == 0)

    ## 0 Laplacian relax; 1 deterministic noise; 2 normal offset; 3 flatten Y;
    ## 4 rotate around selection centroid (radians); 5 scale; 6 grid snap.
    pub static func points(source: interop.Reference[Mesh], selection: const i64[], operation: i64, amount: f64 = 0.2, vector: Vector3 = Vector3()) -> interop.Reference[Mesh]!:
        let mesh = try source.get()
        if operation < 0 or operation > 6 or not math.is_finite(amount) or not vector.is_finite():
            error(errors.invalid, "invalid point operation")
        if operation == 0 and not (amount >= 0.0 and amount <= 1.0):
            error(errors.invalid, "Smooth amount must be in 0..1")
        if operation == 6 and amount <= 0.000001:
            error(errors.invalid, "Snap spacing must be positive")
        let selected = try selection_mask(selection, mesh.point_count())
        defer free(selected) in memory.heap
        let count = (usize)mesh.point_count()
        let points = try alloc Vector3[count] in memory.heap
        defer free(points) in memory.heap
        let sums = try alloc Vector3[count] in memory.heap
        defer free(sums) in memory.heap
        let weights = try alloc f64[count] in memory.heap
        defer free(weights) in memory.heap
        var center = Vector3()
        var total = 0.0
        for id in 0..<count:
            points[id] = try mesh.point((i64)id)
            sums[id] = Vector3()
            weights[id] = 0.0
            if selected[id]:
                center = center.add(points[id])
                total += 1.0
        center = center.multiply_scalar(1.0 / math.max(1.0, total))
        if operation == 0:
            for edge in 0..<(try mesh.edge_count()):
                let a = (usize)(try mesh.edge_point(edge, 0))
                let b = (usize)(try mesh.edge_point(edge, 1))
                sums[a] = sums[a].add(points[b])
                sums[b] = sums[b].add(points[a])
                weights[a] += 1.0
                weights[b] += 1.0
        elif operation == 2:
            for face in 0..<mesh.face_count():
                let normal = try mesh.face_normal(face)
                for at in 0..<(try mesh.face_size(face)):
                    let id = (usize)(try mesh.face_point(face, at))
                    sums[id] = sums[id].add(normal)
        let matrix = Matrix4.compose(Vector3(), vector if operation == 4 else Vector3(), vector if operation == 5 else Vector3(1.0, 1.0, 1.0))
        for id in 0..<count:
            if not selected[id]:
                continue
            let p = points[id]
            if operation == 0 and weights[id] > 0.0:
                points[id] = p.add(sums[id].multiply_scalar(1.0 / weights[id]).subtract(p).multiply_scalar(amount))
            elif operation == 1:
                let seed = (f64)id + vector.x * 131.0
                points[id] = p.add(Vector3(noise(seed + 1.0), noise(seed + 17.0), noise(seed + 43.0)).multiply_scalar(amount))
            elif operation == 2 and sums[id].length() > 0.000001:
                points[id] = p.add((try sums[id].normalized()).multiply_scalar(amount))
            elif operation == 3:
                points[id] = Vector3(p.x, center.y, p.z)
            elif operation == 4 or operation == 5:
                points[id] = matrix.transform_point(p.subtract(center)).add(center)
            elif operation == 6:
                points[id] = Vector3(math.floor(p.x / amount + 0.5), math.floor(p.y / amount + 0.5), math.floor(p.z / amount + 0.5)).multiply_scalar(amount)
        return try mesh.with_positions(points)

    ## Shared quad subdivision; optional Catmull-Clark position rules.
    pub static func subdivide(source: interop.Reference[Mesh], smooth: bool = false) -> interop.Reference[Mesh]!:
        let mesh = try source.get()
        if mesh.point_count() + (try mesh.edge_count()) + mesh.face_count() > 16384 or mesh.vertex_count() * 4 > 65536:
            error(errors.limit, "subdivision would exceed mesh limits")
        var out = try MeshBuilder()
        defer out.close()
        try out.copy_points(mesh)
        for edge in 0..<(try mesh.edge_count()):
            let a = try mesh.edge_point(edge, 0)
            let b = try mesh.edge_point(edge, 1)
            discard(try out.point((try mesh.point(a)).add(try mesh.point(b)).multiply_scalar(0.5), a))
        for face in 0..<mesh.face_count():
            let count = try mesh.face_size(face)
            let offset = try mesh.face_offset(face)
            let center = try out.point(try mesh.face_center(face), try mesh.face_point(face, 0))
            for at in 0..<count:
                let prev = (at + count - 1) % count
                try out.face(4, face)
                try out.corner(try mesh.face_point(face, at), offset + at)
                try out.corner(mesh.point_count() + (try mesh.corner_edge(offset + at)), offset + at)
                try out.corner(center, offset + at)
                try out.corner(mesh.point_count() + (try mesh.corner_edge(offset + prev)), offset + prev)
        if smooth:
            try smooth_subdivision(mesh, &out)
        var result = try out.finish(mesh)
        errdefer result.release()
        # Interpolate continuous point/corner attributes; categorical integers
        # intentionally retain their deterministic parent value.
        for attribute in 0..<mesh.attribute_count():
            let domain = try mesh.attribute_domain(attribute)
            if (domain != 0 and domain != 1) or (try mesh.attribute_integer(attribute)):
                continue
            let width = try mesh.attribute_width(attribute)
            let values = try alloc f64[(usize)((try result.value().domain_count(domain)) * width)] in memory.heap
            defer free(values) in memory.heap
            if domain == 0:
                for point in 0..<mesh.point_count():
                    for component in 0..<width:
                        values[(usize)(point * width + component)] = try mesh.attribute_value(attribute, point, component)
                for edge in 0..<(try mesh.edge_count()):
                    for component in 0..<width:
                        values[(usize)((mesh.point_count() + edge) * width + component)] = ((try mesh.attribute_value(attribute, try mesh.edge_point(edge, 0), component)) + (try mesh.attribute_value(attribute, try mesh.edge_point(edge, 1), component))) * 0.5
                for face in 0..<mesh.face_count():
                    let count = try mesh.face_size(face)
                    for component in 0..<width:
                        var sum = 0.0
                        for at in 0..<count:
                            sum += try mesh.attribute_value(attribute, try mesh.face_point(face, at), component)
                        values[(usize)((mesh.point_count() + (try mesh.edge_count()) + face) * width + component)] = sum / (f64)count
            else:
                var written: usize = 0
                for face in 0..<mesh.face_count():
                    let count = try mesh.face_size(face)
                    let offset = try mesh.face_offset(face)
                    for at in 0..<count:
                        for vertex in 0..<(i64)4:
                            for component in 0..<width:
                                let a = try mesh.attribute_value(attribute, offset + at, component)
                                var value = a
                                if vertex == 1 or vertex == 3:
                                    let other = (at + (1 if vertex == 1 else count - 1)) % count
                                    value = (a + (try mesh.attribute_value(attribute, offset + other, component))) * 0.5
                                elif vertex == 2:
                                    value = 0.0
                                    for corner in 0..<count:
                                        value += try mesh.attribute_value(attribute, offset + corner, component)
                                    value /= (f64)count
                                values[written] = value
                                written += 1
            let replacement = try result.value().with_attribute(try mesh.attribute_name(attribute), domain, width, values)
            result.release()
            result = replacement
        return result

    ## Spatially hashed weld, deterministic first-point attribute ownership.
    pub static func fuse(source: interop.Reference[Mesh], selection: const i64[], tolerance: f64 = 0.001) -> interop.Reference[Mesh]!:
        let mesh = try source.get()
        if not (tolerance >= 0.000001 and tolerance <= 100000.0):
            error(errors.invalid, "Fuse tolerance must be in 1e-6..1e5")
        let selected = try selection_mask(selection, mesh.point_count())
        defer free(selected) in memory.heap
        var out = try MeshBuilder()
        defer out.close()
        let mapping = try alloc i64[(usize)mesh.point_count()] in memory.heap
        defer free(mapping) in memory.heap
        let heads = try alloc i64[32771] in memory.heap
        defer free(heads) in memory.heap
        let next = try alloc i64[(usize)mesh.point_count()] in memory.heap
        defer free(next) in memory.heap
        for id in 0..<heads.length:
            heads[id] = -1
        for id in 0..<mesh.point_count():
            let p = try mesh.point(id)
            let x = (i64)math.floor(p.x / tolerance)
            let y = (i64)math.floor(p.y / tolerance)
            let z = (i64)math.floor(p.z / tolerance)
            var found: i64 = -1
            if selected[(usize)id]:
                for dx in (i64)-1..<(i64)2:
                    for dy in (i64)-1..<(i64)2:
                        for dz in (i64)-1..<(i64)2:
                            var candidate = heads[hash_cell(x + dx, y + dy, z + dz)]
                            while candidate >= 0:
                                if out.points[(usize)candidate].subtract(p).length() <= tolerance and (found < 0 or candidate < found):
                                    found = candidate
                                candidate = next[(usize)candidate]
            if found < 0:
                found = try out.point(p, id)
                let bucket = hash_cell(x, y, z)
                next[(usize)found] = heads[bucket] if selected[(usize)id] else -1
                if selected[(usize)id]:
                    heads[bucket] = found
            mapping[(usize)id] = found
        for face in 0..<mesh.face_count():
            var ids: i64[256]
            var parents: i64[256]
            var count: usize = 0
            for at in 0..<(try mesh.face_size(face)):
                let point = mapping[(usize)(try mesh.face_point(face, at))]
                if count == 0 or point != ids[count - 1]:
                    ids[count] = point
                    parents[count] = (try mesh.face_offset(face)) + at
                    count += 1
            if count > 1 and ids[0] == ids[count - 1]:
                count -= 1
            if count >= 3:
                try out.face((i64)count, face)
                for at in 0..<count:
                    try out.corner(ids[at], parents[at])
        return try out.finish(mesh)

func noise(seed: f64) -> f64:
    let value = math.sin(seed * 12.9898) * 43758.5453
    return (value - math.floor(value)) * 2.0 - 1.0

func hash_cell(x: i64, y: i64, z: i64) -> usize:
    let value = ((x % 104729) * 73856093 + (y % 104729) * 19349663 + (z % 104729) * 83492791) % 32771
    return (usize)(value + 32771 if value < 0 else value)

## Catmull-Clark without creases: interior (F + 2R + (n-3)P)/n,
## boundary 3/4 P + 1/8 each boundary neighbor. Edge attributes remain linear.
func smooth_subdivision(mesh: const Mesh*, out: MeshBuilder*) -> !:
    let np = (usize)mesh.point_count()
    let ne = (usize)(try mesh.edge_count())
    let sums = try alloc Vector3[np * 3 + ne] in memory.heap
    defer free(sums) in memory.heap
    let counts = try alloc i64[np * 3 + ne] in memory.heap
    defer free(counts) in memory.heap
    for index in 0..<sums.length:
        sums[index] = Vector3()
        counts[index] = 0
    for face in 0..<mesh.face_count():
        let center = out.points[np + ne + (usize)face]
        for at in 0..<(try mesh.face_size(face)):
            let p = (usize)(try mesh.face_point(face, at))
            let edge = (usize)(try mesh.corner_edge((try mesh.face_offset(face)) + at))
            sums[p] = sums[p].add(center)
            counts[p] += 1
            sums[np * 3 + edge] = sums[np * 3 + edge].add(center)
            counts[np * 3 + edge] += 1
    for edge in 0..<ne:
        let a = (usize)(try mesh.edge_point((i64)edge, 0))
        let b = (usize)(try mesh.edge_point((i64)edge, 1))
        let midpoint = out.points[np + edge]
        sums[np + a] = sums[np + a].add(midpoint)
        sums[np + b] = sums[np + b].add(midpoint)
        counts[np + a] += 1
        counts[np + b] += 1
        let incident = counts[np * 3 + edge]
        if incident == 1:
            sums[np * 2 + a] = sums[np * 2 + a].add(try mesh.point((i64)b))
            sums[np * 2 + b] = sums[np * 2 + b].add(try mesh.point((i64)a))
            counts[np * 2 + a] += 1
            counts[np * 2 + b] += 1
        elif incident == 2:
            out.points[np + edge] = midpoint.multiply_scalar(0.5).add(sums[np * 3 + edge].multiply_scalar(0.25))
        else:
            error(errors.invalid, "Catmull-Clark requires manifold edges")
    for id in 0..<np:
        let p = try mesh.point((i64)id)
        let boundary = counts[np * 2 + id]
        if boundary == 2:
            out.points[id] = p.multiply_scalar(0.75).add(sums[np * 2 + id].multiply_scalar(0.125))
        elif boundary != 0:
            error(errors.invalid, "Catmull-Clark requires manifold boundary vertices")
        elif counts[id] > 0:
            let n = (f64)counts[id]
            let f = sums[id].multiply_scalar(1.0 / n)
            let r = sums[np + id].multiply_scalar(1.0 / (f64)counts[np + id])
            out.points[id] = f.add(r.multiply_scalar(2.0)).add(p.multiply_scalar(n - 3.0)).multiply_scalar(1.0 / n)
