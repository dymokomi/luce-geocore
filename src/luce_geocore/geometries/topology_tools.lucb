## Manifold topology tools. Reject unsupported topology before publication.
import interop
import memory
import luce_geocore.errors as errors
from luce_geocore.math.vector import Vector3
from luce_geocore.geometries.polygon import PolygonMesh
from luce_geocore.geometries.builder import MeshBuilder, selection_mask

pub struct TopologyTools:
    let reserved: u8 = 0

    ## Chamfer all edges of an oriented closed manifold. Width is face-centroid
    ## fraction, not constant world-space distance; there are no round segments.
    pub static func bevel(source: interop.Reference[PolygonMesh], fraction: f64 = 0.15) -> interop.Reference[PolygonMesh]!:
        let mesh = try source.get()
        if not (fraction > 0.0 and fraction < 0.9):
            error(errors.invalid, "Bevel fraction must be between 0 and 0.9")
        let opposite = try opposite_corners(mesh, true)
        defer free(opposite) in memory.heap
        var out = try MeshBuilder()
        defer out.close()
        for face in 0..<mesh.face_count():
            let center = try mesh.face_center(face)
            for at in 0..<(try mesh.face_size(face)):
                let id = try mesh.face_point(face, at)
                let p = try mesh.point(id)
                discard(try out.point(p.add(center.subtract(p).multiply_scalar(fraction)), id))
        for face in 0..<mesh.face_count():
            let offset = try mesh.face_offset(face)
            let count = try mesh.face_size(face)
            try out.face(count, face)
            for at in 0..<count:
                try out.corner(offset + at, offset + at)
        for corner in 0..<mesh.vertex_count():
            let other = opposite[(usize)corner]
            if other < corner:
                continue
            let next = try next_corner(mesh, corner)
            let other_next = try next_corner(mesh, other)
            try out.face(4, try mesh.corner_face(corner))
            try out.corner(next, next)
            try out.corner(corner, corner)
            try out.corner(other_next, other_next)
            try out.corner(other, other)
        let first = try alloc i64[(usize)mesh.point_count()] in memory.heap
        defer free(first) in memory.heap
        for id in 0..<first.length:
            first[id] = -1
        for corner in 0..<mesh.vertex_count():
            first[(usize)(try mesh.corner_point(corner))] = corner
        for point in 0..<mesh.point_count():
            let start = first[(usize)point]
            if start < 0:
                continue
            var loop: i64[256]
            var count: usize = 0
            var current = start
            while true:
                if count == 256:
                    error(errors.invalid, "Bevel encountered an invalid vertex fan")
                loop[count] = current
                count += 1
                current = opposite[(usize)(try previous_corner(mesh, current))]
                if current == start:
                    break
            if count < 3:
                error(errors.invalid, "Bevel needs at least three faces around each vertex")
            try out.face((i64)count, try mesh.corner_face(start))
            for at in 0..<count:
                try out.corner(loop[at], loop[at])
        return try out.finish(mesh)

    ## Fill one selected, simple boundary loop. Parentless new face attributes
    ## are zero; corner attributes inherit the existing boundary corners.
    pub static func fill(source: interop.Reference[PolygonMesh], selection: const i64[]) -> interop.Reference[PolygonMesh]!:
        let mesh = try source.get()
        if selection.length < 3 or selection.length > 256:
            error(errors.invalid, "Fill needs 3..256 boundary edges forming one loop")
        let marked = try selection_mask(selection, (try mesh.edge_count()))
        defer free(marked) in memory.heap
        let opposite = try opposite_corners(mesh, false)
        defer free(opposite) in memory.heap
        var boundary: i64[256]
        var count: usize = 0
        for corner in 0..<mesh.vertex_count():
            if marked[(usize)(try mesh.corner_edge(corner))]:
                if opposite[(usize)corner] >= 0:
                    error(errors.invalid, "Fill only accepts open boundary edges")
                boundary[count] = corner
                count += 1
        if count != selection.length:
            error(errors.invalid, "Fill selection must contain unique boundary edges")
        var loop: i64[256]
        var used: bool[256]
        for index in 0..<count:
            used[index] = false
        loop[0] = boundary[0]
        used[0] = true
        for at in (usize)1..<count:
            let endpoint = try mesh.corner_point(try next_corner(mesh, loop[at - 1]))
            var found: i64 = -1
            for index in 0..<count:
                if not used[index] and (try mesh.corner_point(boundary[index])) == endpoint:
                    if found >= 0:
                        error(errors.invalid, "Fill boundary branches")
                    found = (i64)index
            if found < 0:
                error(errors.invalid, "Fill needs one continuous boundary loop")
            used[(usize)found] = true
            loop[at] = boundary[(usize)found]
        if (try mesh.corner_point(try next_corner(mesh, loop[count - 1]))) != (try mesh.corner_point(loop[0])):
            error(errors.invalid, "Fill boundary does not close")
        var out = try MeshBuilder()
        defer out.close()
        try out.copy_points(mesh)
        for face in 0..<mesh.face_count():
            try out.copy_face(mesh, face)
        try out.face((i64)count)
        for at in 0..<count:
            let corner = loop[count - at - 1]
            try out.corner(try mesh.corner_point(corner), corner)
        return try out.finish(mesh)

    ## Dissolve a single internal edge by joining its two incident polygons.
    pub static func dissolve(source: interop.Reference[PolygonMesh], edge: i64) -> interop.Reference[PolygonMesh]!:
        let mesh = try source.get()
        let opposite = try opposite_corners(mesh, false)
        defer free(opposite) in memory.heap
        var first: i64 = -1
        for corner in 0..<mesh.vertex_count():
            if (try mesh.corner_edge(corner)) == edge:
                first = corner
                break
        if first < 0 or opposite[(usize)first] < 0:
            error(errors.invalid, "Dissolve needs an internal manifold edge")
        let second = opposite[(usize)first]
        let a = try mesh.corner_face(first)
        let b = try mesh.corner_face(second)
        let na = try mesh.face_size(a)
        let nb = try mesh.face_size(b)
        var out = try MeshBuilder()
        defer out.close()
        try out.copy_points(mesh)
        for face in 0..<mesh.face_count():
            if face != a and face != b:
                try out.copy_face(mesh, face)
        try out.face(na + nb - 2, a)
        var current = try next_corner(mesh, first)
        for at in 0..<na - 1:
            try out.corner(try mesh.corner_point(current), current)
            current = try next_corner(mesh, current)
        current = try next_corner(mesh, second)
        for at in 0..<nb - 1:
            try out.corner(try mesh.corner_point(current), current)
            current = try next_corner(mesh, current)
        # Dissolving an edge changes polygon topology, not the surface. The
        # two validated triangulations already tile the union, including thin
        # collinear boundary pieces that a new greedy ear order can strand.
        # Retain them as display diagonals, never as polygon/wireframe edges.
        let count = (usize)(na+nb-2)
        for at in 0..<count:
            for before in 0..<at:
                if out.corners[out.nc-count+at] == out.corners[out.nc-count+before]:
                    error(errors.invalid,"dissolve requires a simple polygon union")
        var indices: i64[762]
        var written: usize = 0
        for face in [a,b]:
            let offset = try mesh.face_offset(face)
            let first_triangle = (offset-face*2)*3
            for at in 0..<(try mesh.face_size(face)-2)*3:
                let index = mesh.index(first_triangle+at)
                defer index.release()
                let point = try mesh.corner_point(try index.get())
                var mapped: usize = 0
                while mapped < count and out.corners[out.nc-count+mapped] != point: mapped += 1
                if mapped == count: error(errors.invalid,"dissolve lost a source triangle corner")
                indices[written] = (i64)mapped
                written += 1
        try out.set_last_display(indices[..<written])
        return try out.finish(mesh)

func next_corner(mesh: const PolygonMesh*, corner: i64) -> i64!:
    let face = try mesh.corner_face(corner)
    let offset = try mesh.face_offset(face)
    return offset + (corner - offset + 1) % (try mesh.face_size(face))

func previous_corner(mesh: const PolygonMesh*, corner: i64) -> i64!:
    let face = try mesh.corner_face(corner)
    let offset = try mesh.face_offset(face)
    let count = try mesh.face_size(face)
    return offset + (corner - offset + count - 1) % count

func opposite_corners(mesh: const PolygonMesh*, closed: bool) -> i64[]!:
    let result = try alloc i64[(usize)mesh.vertex_count()] in memory.heap
    errdefer free(result) in memory.heap
    let first = try alloc i64[(usize)(try mesh.edge_count())] in memory.heap
    defer free(first) in memory.heap
    for index in 0..<first.length:
        first[index] = -1
    for corner in 0..<mesh.vertex_count():
        result[(usize)corner] = -1
        let edge = (usize)(try mesh.corner_edge(corner))
        let other = first[edge]
        if other < 0:
            first[edge] = corner
        else:
            if result[(usize)other] >= 0 or (try mesh.corner_point(other)) != (try mesh.corner_point(try next_corner(mesh, corner))):
                error(errors.invalid, "Operation needs consistently oriented manifold topology")
            result[(usize)corner] = other
            result[(usize)other] = corner
    if closed:
        for other in result:
            if other < 0:
                error(errors.invalid, "Bevel currently requires a closed manifold mesh")
    return result
