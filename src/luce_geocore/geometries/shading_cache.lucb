## Smooth shading normals for meshes without an authored N, computed on first
## use and shared by the snapshots of one geometry: each corner averages the
## normals of the faces around its point, weighted by their angle there, over
## the faces within the cusp angle of its own face (60 degrees, as Houdini's
## default), so hard edges stay hard. A mesh made by moving points keeps the
## previous geometry's cache as its source and updates only the corners around
## the moved points. The same cache holds the points' discrete principal
## curvatures (curvature.lucb) once asked for.
import math
import memory
import sync
import luce_geocore.core.parallel as parallel
from luce_geocore.core.float3 import Float3
from luce_geocore.core.shared import Column
from luce_geocore.math.vector import Vector3
from luce_geocore.geometries.curvature import CurvatureShape, point_curvatures

## cos(60 degrees): faces meeting at a sharper angle keep separate normals.
let cusp_cosine: f64 = 0.5

pub struct ShadingCache:
    pub var owners: @usize = 1
    var lock: sync.Mutex
    var ready: @u32
    var smooth: Column[Float3]
    ## Before this cache is built: the previous geometry's cache and the
    ## points that moved since.
    var source: ShadingCache*? = none
    var moved: u32[]
    ## k1 and k2 of every point.
    var curvature_ready: @u32
    var curvature: Column[f32]

    ## A cache for a mesh whose points `moved` over `previous`'s geometry.
    ## Only a built `previous` is kept; otherwise this one computes afresh.
    pub static func after(previous: ShadingCache*, moved: const u32[]) -> ShadingCache*!:
        let cache = try new ShadingCache() in memory.heap
        if previous.ready.load(.acquire) == 0 or moved.length == 0:
            return cache
        let copy = alloc u32[moved.length] in memory.heap catch failure:
            free(cache) in memory.heap
            error(failure.code, failure.message)
        memory.copy(copy, moved, moved.length)
        discard(previous.owners.add(1, .relaxed))
        cache.source = previous
        cache.moved = copy
        return cache

    ## The smooth normal of every corner. Published once, immutable after.
    pub mutating func get(shape: const Surface*) -> const Float3[]!:
        if self.ready.load(.acquire) == 0:
            self.lock.lock()
            defer self.lock.unlock()
            if self.ready.load(.acquire) == 0:
                var column = try Column[Float3].allocate(shape.corners.length)
                errdefer column.release()
                if let source = self.source:
                    memory.copy(column.span(), source.smooth.view(), shape.corners.length)
                    try update(shape, self.moved, column.span())
                    # Provenance: GPU copies of the old normals update in place.
                    column.set_parent(source.smooth.id())
                else:
                    var work = SmoothWork(shape, column.span())
                    parallel.parallel_for(shape.offsets.length - 1, 2048, smooth_faces, (void*)&work)
                self.smooth = column
                self.ready.store(1, .release)
                self.drop_source()
        return self.smooth.view()

    pub func is_ready() -> bool:
        return self.ready.load(.acquire) != 0

    ## k1 and k2 of every point, computed on first use.
    pub mutating func curvatures(shape: const CurvatureShape*) -> const f32[]!:
        if self.curvature_ready.load(.acquire) == 0:
            self.lock.lock()
            defer self.lock.unlock()
            if self.curvature_ready.load(.acquire) == 0:
                var column = try Column[f32].allocate(shape.positions.length * 2)
                point_curvatures(shape, column.span())
                self.curvature = column
                self.curvature_ready.store(1, .release)
        return self.curvature.view()

    pub func has_curvatures() -> bool:
        return self.curvature_ready.load(.acquire) != 0

    ## The curvatures once `has_curvatures`.
    pub func built_curvatures() -> const f32[]:
        return self.curvature.view()

    pub func curvature_id() -> u64:
        return self.curvature.id()

    ## The smooth column's id and the column it was derived from (0: none);
    ## meaningful once built.
    pub func id() -> u64:
        return self.smooth.id()

    pub func parent() -> u64:
        return self.smooth.parent()

    mutating func drop_source():
        if let source = self.source:
            self.source = none
            release_shading(source)
        if self.moved.length > 0:
            free(self.moved) in memory.heap
            var empty: u32[]
            self.moved = empty

    ## Called by the last owner, after every reader.
    mutating func close():
        self.smooth.release()
        self.curvature.release()
        self.drop_source()

## Give up one owner of `cache`; the last frees it.
pub func release_shading(cache: ShadingCache*):
    if cache.owners.sub(1, .acq_rel) > 1: return
    cache.close()
    free(cache) in memory.heap

## The arrays smooth normals read.
pub struct Surface:
    pub let positions: const Float3[]
    pub let offsets: const i32[]
    pub let corners: const i32[]
    pub let normals: const Float3[]
    pub let incident_offsets: const i32[]
    pub let incident_faces: const i32[]

struct SmoothWork:
    let shape: const Surface*
    let output: Float3[]

func smooth_faces(context: void*?, first: usize, end: usize):
    let work = (SmoothWork*)(context else return)
    for face in first..<end:
        for corner in (usize)work.shape.offsets[face]..<(usize)work.shape.offsets[face + 1]:
            work.output[corner] = Float3.of(corner_normal(work.shape, face, corner))

## Recompute the corners at every point of a face around a moved point.
func update(shape: const Surface*, moved: const u32[], output: Float3[]) -> !:
    let points = shape.positions.length
    let marked = try alloc bool[points] in memory.heap
    defer free(marked) in memory.heap
    memory.set(u8[]((u8*)marked.data, points), 0)
    var count: usize = 0
    for point in moved:
        for at in (usize)shape.incident_offsets[(usize)point]..<(usize)shape.incident_offsets[(usize)point + 1]:
            let face = (usize)shape.incident_faces[at]
            for corner in (usize)shape.offsets[face]..<(usize)shape.offsets[face + 1]:
                let p = (usize)shape.corners[corner]
                if not marked[p]:
                    marked[p] = true
                    count += 1
    let affected = try alloc u32[count] in memory.heap
    defer free(affected) in memory.heap
    var written: usize = 0
    for point in 0..<points:
        if marked[point]:
            affected[written] = (u32)point
            written += 1
    var work = UpdateWork(shape, affected, output)
    parallel.parallel_for(affected.length, 1024, update_points, (void*)&work)

struct UpdateWork:
    let shape: const Surface*
    let points: const u32[]
    let output: Float3[]

func update_points(context: void*?, first: usize, end: usize):
    let work = (UpdateWork*)(context else return)
    let shape = work.shape
    for at in first..<end:
        let point = work.points[at]
        for index in (usize)shape.incident_offsets[(usize)point]..<(usize)shape.incident_offsets[(usize)point + 1]:
            let face = (usize)shape.incident_faces[index]
            for corner in (usize)shape.offsets[face]..<(usize)shape.offsets[face + 1]:
                if (u32)shape.corners[corner] == point:
                    work.output[corner] = Float3.of(corner_normal(shape, face, corner))

## The angle-weighted normal of `corner` (of `face`) over the faces around its
## point within the cusp angle; the face normal when they cancel.
func corner_normal(shape: const Surface*, face: usize, corner: usize) -> Vector3:
    let own = shape.normals[face].vector()
    let point = (usize)shape.corners[corner]
    var sum = Vector3()
    for index in (usize)shape.incident_offsets[point]..<(usize)shape.incident_offsets[point + 1]:
        let other = (usize)shape.incident_faces[index]
        let normal = shape.normals[other].vector()
        if normal.dot(own) < cusp_cosine: continue
        sum = sum.add(normal.multiply_scalar(corner_angle(shape, other, point)))
    let length = sum.length()
    return sum.multiply_scalar(1.0 / length) if length > 1e-20 else own

## The interior angle of `face` at `point` (its first corner there).
func corner_angle(shape: const Surface*, face: usize, point: usize) -> f64:
    let start = (usize)shape.offsets[face]
    let count = (usize)shape.offsets[face + 1] - start
    for at in 0..<count:
        if (usize)shape.corners[start + at] != point: continue
        let here = shape.positions[point].vector()
        let previous = shape.positions[(usize)shape.corners[start + (at + count - 1) % count]].vector().subtract(here)
        let next = shape.positions[(usize)shape.corners[start + (at + 1) % count]].vector().subtract(here)
        let lengths = previous.length() * next.length()
        if lengths <= 1e-30: return 0.0
        return math.acos(math.max(-1.0, math.min(1.0, previous.dot(next) / lengths)))
    return 0.0
