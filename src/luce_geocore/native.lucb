## The geocore_native export: Base-only access to a mesh's arrays for
## renderers and kernels in other packages. Spans cannot cross into Luce, so
## these are free functions in their own export, which Luce code never imports.
## The pack functions write a mesh's arrays in the GPU's layout (f32 vectors,
## u32 indices); their cost is a plain pass over the array.
import math
import memory
import luce_geocore.errors as errors
import luce_geocore.geometries.polygon as polygon
from luce_geocore.math.vector import Vector3
from luce_geocore.core.attributes import DataType
from luce_geocore.core.float3 import Float3
from luce_geocore.geometries.polygon import Mesh, point_span, corner_span, offset_span, corner_face_span, face_normal_span, triangle_span, edge_span, attribute_entry, mesh_origin, smooth_normal_span, smooth_normals_ids, smooth_normals_corner_domain, curvature_span, curvature_id

## Positions as x, y, z f32 triples relative to `origin(mesh)`; `out` holds
## 3 per point. Positions are stored this way, so this is a copy.
pub func pack_positions(mesh: const Mesh*, out: f32[]) -> !:
    let points = point_span(mesh)
    if out.length != points.length * 3: error(errors.invalid, "position output needs three values per point")
    memory.copy(Float3[]((Float3*)out.data, points.length), points, points.length)

## The elements of positions, smooth normals and attribute `index` that may
## differ from the arrays they were edited from (points_parent, smooth_ids,
## attribute_parent): a Move's neighbourhood. All of them without a parent.
pub func points_changed(mesh: const Mesh*) -> (usize, usize):
    return polygon.points_changed(mesh)

pub func smooth_changed(mesh: const Mesh*) -> (usize, usize)!:
    return try polygon.smooth_changed(mesh)

pub func attribute_changed(mesh: const Mesh*, index: i64) -> (usize, usize)!:
    let entry = try attribute_entry(mesh, index)
    let bytes = entry.data.changed()
    let tuple = entry.tuple_bytes()
    return (bytes.0 // tuple, (bytes.1 + tuple - 1) // tuple)

## Positions first..<end as f32 triples (relative to `origin`) into `out`.
pub func pack_positions_range(mesh: const Mesh*, first: usize, end: usize, out: f32[]) -> !:
    let points = point_span(mesh)
    if end > points.length or first > end or out.length != (end - first) * 3: error(errors.invalid, "position range leaves the mesh")
    memory.copy(Float3[]((Float3*)out.data, end - first), points[first..<end], end - first)

## Smooth normals first..<end (of their domain) into `out`.
pub func pack_smooth_range(mesh: const Mesh*, first: usize, end: usize, out: f32[]) -> !:
    let normals = try smooth_normal_span(mesh)
    if end > normals.length or first > end or out.length != (end - first) * 3: error(errors.invalid, "normal range leaves the mesh")
    memory.copy(Float3[]((Float3*)out.data, end - first), normals[first..<end], end - first)

## Tuples first..<end of a width-3 float attribute as f32 triples.
pub func pack_attribute3_range(mesh: const Mesh*, index: i64, first: usize, end: usize, out: f32[]) -> !:
    let entry = try attribute_entry(mesh, index)
    if entry.width != 3 or (entry.kind != DataType.float32 and entry.kind != DataType.float64) or (u8)entry.storage == 1: error(errors.invalid, "range packing needs a float attribute of three components")
    if end > entry.elements or first > end or out.length != (end - first) * 3: error(errors.invalid, "attribute range leaves the mesh")
    let bytes = entry.data.view()
    if entry.kind == DataType.float32:
        memory.copy(out, f32[]((f32*)bytes.data, entry.elements * 3)[first * 3..<end * 3], (end - first) * 3)
        return
    let values = f64[]((f64*)bytes.data, entry.elements * 3)
    for at in 0..<(end - first) * 3: out[at] = (f32)values[first * 3 + at]

## Where stored positions are measured from.
pub func origin(mesh: const Mesh*) -> Vector3:
    return mesh_origin(mesh)

## The corner of each vertex of triangles first..<first + out.length / 3.
pub func pack_triangles(mesh: const Mesh*, first: usize, out: u32[]) -> !:
    let triangles = triangle_span(mesh)
    if first * 3 + out.length > triangles.length: error(errors.invalid, "triangle range leaves the mesh")
    memory.copy(i32[]((i32*)out.data, out.length), triangles[first * 3..<first * 3 + out.length], out.length)

## The point of every corner.
pub func pack_corner_points(mesh: const Mesh*, out: u32[]) -> !:
    let corners = corner_span(mesh)
    if out.length != corners.length: error(errors.invalid, "corner output needs one value per corner")
    memory.copy(i32[]((i32*)out.data, out.length), corners, corners.length)

## The face of each of triangles first..<first + out.length.
pub func pack_triangle_faces(mesh: const Mesh*, first: usize, out: u32[]) -> !:
    let triangles = triangle_span(mesh)
    let faces = try corner_face_span(mesh)
    if (first + out.length) * 3 > triangles.length: error(errors.invalid, "triangle range leaves the mesh")
    for at in 0..<out.length:
        out[at] = (u32)faces[(usize)triangles[(first + at) * 3]]

## Face normals as f32 triples.
pub func pack_face_normals(mesh: const Mesh*, out: f32[]) -> !:
    let normals = face_normal_span(mesh)
    if out.length != normals.length * 3: error(errors.invalid, "normal output needs three values per face")
    memory.copy(Float3[]((Float3*)out.data, normals.length), normals, normals.length)

## Smooth normals (the shading of a mesh without N) as f32 triples, one per
## point or per corner (`smooth_domain`), computed on first use.
pub func pack_smooth_normals(mesh: const Mesh*, out: f32[]) -> !:
    let normals = try smooth_normal_span(mesh)
    if out.length != normals.length * 3: error(errors.invalid, "normal output needs three values per normal")
    memory.copy(Float3[]((Float3*)out.data, normals.length), normals, normals.length)

## The domain of the smooth normals: 1 (corner) or 0 (point).
pub func smooth_domain(mesh: const Mesh*) -> i64!:
    return 1 if (try smooth_normals_corner_domain(mesh)) else 0

## The smooth normals' column id and the id it was updated from (0: none).
pub func smooth_ids(mesh: const Mesh*) -> (u64, u64)!:
    return try smooth_normals_ids(mesh)

## The two points of every edge.
pub func pack_edges(mesh: const Mesh*, out: u32[]) -> !:
    let edges = try edge_span(mesh)
    if out.length != edges.length: error(errors.invalid, "edge output needs two values per edge")
    memory.copy(i32[]((i32*)out.data, out.length), edges, edges.length)

## The first three components of attribute `index` per stored tuple (one for
## single storage), as f32; `out` holds 3 per tuple.
pub func pack_attribute3(mesh: const Mesh*, index: i64, out: f32[]) -> !:
    let entry = try attribute_entry(mesh, index)
    if entry.width < 3 or entry.kind == DataType.boolean: error(errors.invalid, "packing needs a numeric attribute of three components")
    let tuples = out.length // 3
    let bytes = entry.data.view()
    let single = (u8)entry.storage == 1
    if entry.width == 3 and entry.kind == DataType.float32 and not single:
        memory.copy(out, f32[]((f32*)bytes.data, tuples * 3), tuples * 3)
        return
    if entry.width == 3 and entry.kind == DataType.float64 and not single:
        let values = f64[]((f64*)bytes.data, tuples * 3)
        for at in 0..<tuples * 3: out[at] = (f32)values[at]
        return
    for at in 0..<tuples:
        for component in 0..<(usize)3:
            out[at * 3 + component] = (f32)entry.number(at, component)

## The column attribute `index` was written from (a copy-on-write edit), or 0.
pub func attribute_parent(mesh: const Mesh*, index: i64) -> u64!:
    return (try attribute_entry(mesh, index)).data.parent()

## Tuples attribute `index` stores: its domain's size, or 1 for single storage.
pub func attribute_tuples(mesh: const Mesh*, index: i64) -> usize!:
    let entry = try attribute_entry(mesh, index)
    return 1 if (u8)entry.storage == 1 else entry.elements

## The arrays a position edit derived positions and face normals from, or 0.
pub func points_parent(mesh: const Mesh*) -> u64:
    return polygon.points_parent(mesh)
pub func normals_parent(mesh: const Mesh*) -> u64:
    return polygon.normals_parent(mesh)

# mark: Curvature =============================================================================

## Where a mesh's principal curvatures come from: the analytic CAD attributes
## curvature.k1/k2 (corner domain) when present, else the discrete estimate
## per point. `key` names the data for GPU caches.
pub struct CurvatureSource:
    pub let domain: i64
    pub let key: u64
    let k1: i64
    let k2: i64

pub func curvature_source(mesh: const Mesh*) -> CurvatureSource!:
    let k1 = mesh.find_attribute("curvature.k1", 1)
    let k2 = mesh.find_attribute("curvature.k2", 1)
    if k1 >= 0 and k2 >= 0:
        let key = (try mesh.attribute_id(k1)) *% 0x9E3779B97F4A7C15 ^ (try mesh.attribute_id(k2))
        return CurvatureSource(1, key, k1, k2)
    return CurvatureSource(0, try curvature_id(mesh), -1, -1)

## (k1, k2, 0) per element of the source's domain into `out`.
pub func pack_curvature(mesh: const Mesh*, source: const CurvatureSource*, out: f32[]) -> !:
    if source.k1 >= 0:
        let k1 = try attribute_entry(mesh, source.k1)
        let k2 = try attribute_entry(mesh, source.k2)
        if out.length != k1.elements * 3: error(errors.invalid, "curvature output needs three values per corner")
        for at in 0..<k1.elements:
            out[at * 3] = (f32)k1.number(at, 0)
            out[at * 3 + 1] = (f32)k2.number(at, 0)
            out[at * 3 + 2] = 0.0
        return
    let values = try curvature_span(mesh)
    if out.length != values.length // 2 * 3: error(errors.invalid, "curvature output needs three values per point")
    for at in 0..<values.length // 2:
        out[at * 3] = values[at * 2]
        out[at * 3 + 1] = values[at * 2 + 1]
        out[at * 3 + 2] = 0.0

## The 98th percentile of |value| over the source, where `kind` picks the
## value from (k1, k2): 0 mean, 1 Gaussian, 2 k1, 3 k2, 4 the larger |k|.
## The colour map spans it, so a few extreme points do not wash it out.
pub func curvature_range(mesh: const Mesh*, source: const CurvatureSource*, kind: i64) -> f64!:
    var count: usize = 0
    if source.k1 >= 0: count = (try attribute_entry(mesh, source.k1)).elements
    else: count = (try curvature_span(mesh)).length // 2
    if count == 0: return 1.0
    let packed = try alloc f32[count * 3] in memory.heap
    defer free(packed) in memory.heap
    try pack_curvature(mesh, source, packed)
    let values = try alloc f64[count] in memory.heap
    defer free(values) in memory.heap
    var largest: f64 = 0.0
    for at in 0..<count:
        let k1 = (f64)packed[at * 3]
        let k2 = (f64)packed[at * 3 + 1]
        let value = (k1 + k2) * 0.5 if kind == 0 else (k1 * k2 if kind == 1 else (k1 if kind == 2 else (k2 if kind == 3 else math.max(math.abs(k1), math.abs(k2)))))
        values[at] = math.abs(value) if math.is_finite(value) else 0.0
        largest = math.max(largest, values[at])
    if largest <= 1e-12: return 1.0
    # A 4096-bucket histogram of |value| finds the percentile in one pass.
    var buckets: u32[4096]
    for value in values: buckets[(usize)math.min(4095.0, value / largest * 4096.0)] += 1
    let wanted = count * 98 // 100
    var seen: usize = 0
    for bucket in 0..<(usize)4096:
        seen += (usize)buckets[bucket]
        if seen > wanted: return largest * (f64)(bucket + 1) / 4096.0
    return largest
