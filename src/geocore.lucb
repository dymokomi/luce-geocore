## The luce-geocore export: shared geometry with no GPU or UI dependency.
## Vectors and matrices, polygon meshes and their builders, modeling kernels,
## primitives and CPU spatial queries.
import math.vector
import math.matrix
import core.geometry
import core.polygon_topology
import geometries.polygon
import geometries.builder
import geometries.shading.normals
import geometries.distance
import geometries.overlays
import geometries.primitives
import geometries.dissolve_workspace
import geometries.attribute_kernels
import geometry_set
import groups
import verbs
import subdivision
import set_verbs
import geometry_files
import fields
import curves
import errors
import core.attributes
import code

pub type Vector3 = vector.Vector3
pub type Matrix4 = matrix.Matrix4
pub type Geometry = geometry.Geometry
pub type Vertex = geometry.Vertex
pub type Bounds = geometry.Bounds
pub type PolygonTopology = polygon_topology.PolygonTopology
pub type Mesh = polygon.Mesh
pub let mesh_type = polygon.mesh_type
pub let detached_mesh = polygon.detached_mesh
pub type MeshBuilder = builder.MeshBuilder
pub type MeshNormals = normals.MeshNormals
## Squared Euclidean distance to a triangle, including degenerate triangles.
pub let squared_triangle_distance = distance.triangle_distance
pub let mesh_overlay_points = overlays.mesh_overlay_points
pub type MeshPrimitives = primitives.MeshPrimitives
pub type DissolveWorkspace = dissolve_workspace.DissolveWorkspace
pub let dissolve_edge = dissolve_workspace.dissolve_edge
pub type AttributeKernels = attribute_kernels.AttributeKernels
pub type GeometrySet = geometry_set.GeometrySet
pub let geometry_set_type = geometry_set.geometry_set_type
## Cameras and lights in a set, flattened to world space (GeometrySet.scene).
pub type SceneList = geometry_set.SceneList
pub type SceneObject = geometry_set.SceneObject
pub type SceneKind = geometry_set.SceneKind
pub type Camera = geometry_set.Camera
pub type Light = geometry_set.Light
pub type LightShape = geometry_set.LightShape
pub type Projection = geometry_set.Projection
pub type Selection = groups.Selection
## Selection domains (Domain.point, .corner, .face, .edge) and what a verb's
## group names (GroupType); Luce passes them to the i64 parameters with int().
pub type Domain = attributes.Domain
pub type GroupType = groups.GroupType
pub type Groups = groups.Groups
## Writes the `material` binding attribute on faces (Assign Material).
pub type MaterialAssignment = groups.MaterialAssignment
pub type Verbs = verbs.Verbs
pub type VerbResult = verbs.VerbResult
pub type Subdivision = subdivision.Subdivision
## Verbs over whole sets (curves, fields, conversions), and the one catalog
## of every verb a node runs.
pub type GeometryVerbs = set_verbs.GeometryVerbs
pub type SetVerbResult = set_verbs.SetVerbResult
pub type VerbCatalog = set_verbs.VerbCatalog
## Attribute nodes on curves and point clouds.
pub type SetAttributes = set_verbs.SetAttributes
## Geometry files: a whole set as a .prism crate.
pub type GeometryFile = geometry_files.GeometryFile
## Volume and SDF previews for the viewport.
pub type Fields = fields.Fields
## Edit GSplats: a set's splat cloud edited by selection, picked on its points.
pub type SplatEdits = set_verbs.SplatEdits
## Edit SDF: a set's SDF edited primitive by primitive, picked on proxies.
pub type SdfEdits = fields.SdfEdits
## Edit Sketch: planar sketches as curves, picked on point clouds.
pub type Sketches = curves.Sketches
## geocore's error codes: invalid input, reentered work, and sizes past the
## mesh limits. luce-3d raises the same codes.
pub let invalid: ErrorCode = errors.invalid
pub let busy: ErrorCode = errors.busy
pub let limit: ErrorCode = errors.limit
## The Code node: snippets checked (`Code.check`), helped (`Code.complete`, `Code.hover`)
## and run over a set (`Code.run`).
pub type Code = code.Code
pub type CodeCheck = code.CodeCheck
## Editor help for the Code node's text: `Code.complete`'s items and `Code.hover`.
pub type CodeCompletion = code.CodeCompletion
## Editor help for a Script node's script, checked as a file of a check package:
## `ScriptHelp.check`, `ScriptHelp.complete` and `ScriptHelp.hover`.
pub type ScriptHelp = code.ScriptHelp
## `ScriptHelp.check` on a thread of its own, for a first check that reads packages.
pub type ScriptCheckJob = code.ScriptCheckJob
