## Select verbs: each select rule (selecting/) as a verb, after the
## modeling verbs. They change no geometry; their output selection is what
## the rule made from the group, on its own domain, which the viewport
## adopts: a Select node, an Edit Mesh step's selection, a D menu entry.

## Select rule `index` as a verb (run_verb runs the rule, not `cook`).
func rule_verb(index: usize) -> Verb:
    let rule = rule_at(index)
    return Verb(rule.name, "Modeling", rule.description, rule.first_domain(), true, rule.parms, false, cook_rule,
                native = true, label = rule.label, section = "Select", family = rule.family, icon = rule.icon, picks = rule.picks, whole = rule.whole, rule = (i64)index)

## Never called: run_verb runs a Select verb's rule.
func cook_rule(input: const VerbInput*, output: VerbOutput*) -> !:
    error(errors.invalid, "a Select verb runs its rule")
