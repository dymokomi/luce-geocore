## Subdivide: every face of n corners becomes n quads through its edge
## midpoints and its center; Catmull-Clark then moves the points (Linear
## keeps the shape). Linear's Smoothness rounds the new points out as
## Blender's Subdivide Smoothness does, onto the sphere the corners'
## normals describe: a new point at the mean of points p_i with normals n_i
## rises along the normals' mean by R (1 - |mean n_i|), R the radius the
## edges give (an edge's length over 2 sin of half the angle between its
## ends' normals), so an edge's point rises by its arc's sagitta; the old
## points stay.
## Edge and face points mix their parents' attributes, and each new corner
## mixes the corners it lies between, so UVs interpolate within faces.
## Edges used by more than two faces act as creases.

let subdivide_parms: ParmSpec[3] = [
    ParmSpec("Levels", ParmKind.integer, 1.0, 1.0, 4.0, 1, "", "Each level splits every face into quads."),
    ParmSpec("Method", ParmKind.menu, 1.0, 0.0, 1.0, 1, "Linear|Catmull-Clark", "Catmull-Clark smooths as it splits; Linear keeps the shape."),
    ParmSpec("Smoothness", ParmKind.number, 0.0, 0.0, 1.0, 1, "", "Linear: round the new points out along the surface's curve (1: onto the circle the normals describe).")]

func subdivide_verb() -> Verb:
    return Verb("Subdivide", "Modeling", "Split faces into quads, optionally with Catmull-Clark smoothing", Domain.face, true, subdivide_parms, true, cook_subdivide, section = "Modify", family = "Subdivide", icon = "subdivide", picks = pick_pieces, whole = true)

func cook_subdivide(input: const VerbInput*, output: VerbOutput*) -> !:
    let levels = (usize)math.max(1.0, math.min(4.0, input.parms.at(0)))
    let smooth = input.parms.at(1) != 0.0
    let smoothness = 0.0 if smooth else math.max(0.0, math.min(1.0, input.parms.at(2)))
    if input.group.population() != input.group.count:
        output.warning = "Subdivide works on the whole mesh; the group is ignored"
    var current = try mesh_share(input.mesh)
    for _ in 0..<levels:
        var level = TopologyBuilder()
        defer level.close()
        subdivide_level(current, smooth, smoothness, &level) catch failure:
            mesh_dispose(current)
            error(failure.code, failure.message)
        let next = level.finish(current) catch failure:
            mesh_dispose(current)
            error(failure.code, failure.message)
        mesh_dispose(current)
        current = next
    output.mesh = current
    output.selection = try BitsBuilder.ones((usize)current.face_count())
    output.selection_domain = Domain.face

func subdivide_level(mesh: const Mesh*, smooth: bool, smoothness: f64, builder: TopologyBuilder*) -> !:
    let topology = try Topology.of(mesh)
    let offsets = topology.offsets
    let corners = topology.corners
    let points = topology.points
    let edges = topology.edges()
    let faces = topology.faces()
    if points + edges + faces > max_points: error(errors.limit, "subdivision would exceed 8M points")
    try builder.begin(mesh)
    try builder.copy_points(mesh)
    # Face points: centroids.
    let centers = try new Vector3[faces] --- in memory.heap
    defer free(centers) in memory.heap
    for face in 0..<faces:
        var sum = Vector3()
        let start = (usize)offsets[face]
        let size = (usize)offsets[face + 1] - start
        for at in 0..<size: sum = sum.add(builder.position(corners[start + at]))
        centers[face] = sum.multiply_scalar(1.0 / (f64)size)
    # Edge points: midpoints, or with Catmull-Clark the average of the ends
    # and the two face points of an interior edge; with Smoothness risen
    # off the middle (their rises kept for the face points).
    var parents: i32[256]
    var weights: f32[256]
    let rises = try new Vector3[edges] --- in memory.heap
    defer free(rises) in memory.heap
    let radii = try new f64[edges] --- in memory.heap
    defer free(radii) in memory.heap
    let point_normals = try new Vector3[points] --- in memory.heap
    defer free(point_normals) in memory.heap
    for edge in 0..<edges:
        rises[edge] = Vector3()
        radii[edge] = 0.0
    if smoothness > 0.0:
        try corner_normals(mesh, &topology, point_normals[..<points])
        edge_rises(mesh, &topology, smoothness, point_normals[..<points], rises[..<edges], radii[..<edges])
    for edge in 0..<edges:
        let a = topology.edge_points[edge * 2]
        let b = topology.edge_points[edge * 2 + 1]
        var position = builder.position(a).add(builder.position(b)).multiply_scalar(0.5)
        let first = (usize)topology.edge_corner_offsets[edge]
        let end = (usize)topology.edge_corner_offsets[edge + 1]
        if smooth and end - first == 2:
            let f1 = centers[(usize)topology.corner_faces[(usize)topology.edge_corners[first]]]
            let f2 = centers[(usize)topology.corner_faces[(usize)topology.edge_corners[first + 1]]]
            position = builder.position(a).add(builder.position(b)).add(f1).add(f2).multiply_scalar(0.25)
        position = position.add(rises[edge])
        parents[0] = a
        parents[1] = b
        weights[0] = 0.5
        weights[1] = 0.5
        _ = try builder.mixed_point(position, parents[..<2], weights[..<2])
    for face in 0..<faces:
        let start = (usize)offsets[face]
        let size = (usize)offsets[face + 1] - start
        # Small faces mix on the stack, larger ones in heap scratch.
        let face_parents = try face_scratch.take[i32](parents, size, size)
        defer face_scratch.release[i32](parents, face_parents)
        let face_weights = try face_scratch.take[f32](weights, size, size)
        defer face_scratch.release[f32](weights, face_weights)
        var normal_sum = Vector3()
        var radius = 0.0
        var curved: usize = 0
        for at in 0..<size:
            face_parents[at] = corners[start + at]
            face_weights[at] = (f32)(1.0 / (f64)size)
            normal_sum = normal_sum.add(point_normals[(usize)corners[start + at]])
            let edge_radius = radii[(usize)topology.corner_edges[start + at]]
            if edge_radius > 0.0:
                radius += edge_radius
                curved += 1
        var center = centers[face]
        let mean = normal_sum.length() / (f64)size
        if smoothness > 0.0 and curved > 0 and mean > 0.0:
            center = center.add(normal_sum.multiply_scalar(smoothness * radius / (f64)curved * (1.0 - mean) / normal_sum.length()))
        _ = try builder.mixed_point(center, face_parents, face_weights)
    if smooth: try catmull_clark_points(&topology, builder, centers)
    # n quads per face.
    let edge_base = (i32)points
    let face_base = (i32)(points + edges)
    var mixed_parents: i32[256]
    var mixed_weights: f32[256]
    for face in 0..<faces:
        let start = (usize)offsets[face]
        let size = (usize)offsets[face + 1] - start
        let center_parents = try face_scratch.take[i32](mixed_parents, size, size)
        defer face_scratch.release[i32](mixed_parents, center_parents)
        let center_weights = try face_scratch.take[f32](mixed_weights, size, size)
        defer face_scratch.release[f32](mixed_weights, center_weights)
        for at in 0..<size:
            center_parents[at] = (i32)(start + at)
            center_weights[at] = (f32)(1.0 / (f64)size)
        # Every quad's center corner shares one mix of the face's corners.
        let center = try builder.shared_mix(center_parents, center_weights)
        for at in 0..<size:
            let corner = start + at
            let next = start + (at + 1) % size
            let previous = start + (at + size - 1) % size
            try builder.face((i32)face)
            try builder.corner(corners[corner], (i32)corner)
            let pair: i32[2] = [(i32)corner, (i32)next]
            let half: f32[2] = [0.5, 0.5]
            try builder.mixed_corner(edge_base + topology.corner_edges[corner], pair, half)
            try builder.shared_corner(face_base + (i32)face, center)
            let back: i32[2] = [(i32)previous, (i32)corner]
            try builder.mixed_corner(edge_base + topology.corner_edges[previous], back, half)
            try builder.end_face()

## Each point's normal: its faces', weighted by their corner angles (zero
## for a point no face uses).
func corner_normals(mesh: const Mesh*, topology: const Topology*, point_normals: Vector3[]) -> !:
    let normals = mesh.face_normal_span()
    for at in 0..<point_normals.length: point_normals[at] = Vector3()
    for corner in 0..<topology.corners.length:
        let point = topology.corners[corner]
        let here = point_of(mesh, point)
        let before = point_of(mesh, topology.corners[topology.previous(corner)]).subtract(here)
        let after = point_of(mesh, topology.corners[topology.next(corner)]).subtract(here)
        let lengths = before.length() * after.length()
        if lengths <= 0.0: continue
        let angle = math.acos(math.max(-1.0, math.min(1.0, before.dot(after) / lengths)))
        point_normals[(usize)point] = point_normals[(usize)point].add(normals[(usize)topology.corner_faces[corner]].vector().multiply_scalar(angle))
    for at in 0..<point_normals.length:
        let length = point_normals[at].length()
        if length > 0.0: point_normals[at] = point_normals[at].multiply_scalar(1.0 / length)

## Each edge's rise for Smoothness (its arc's sagitta along its ends'
## mean normal, times `smoothness`) and the radius its ends' normals give
## (0 where they agree).
func edge_rises(mesh: const Mesh*, topology: const Topology*, smoothness: f64, point_normals: const Vector3[], rises: Vector3[], radii: f64[]):
    for edge in 0..<rises.length:
        let na = point_normals[(usize)topology.edge_points[edge * 2]]
        let nb = point_normals[(usize)topology.edge_points[edge * 2 + 1]]
        let mean = na.add(nb)
        let length = mean.length()
        if length <= 0.0: continue
        let angle = math.acos(math.max(-1.0, math.min(1.0, na.dot(nb))))
        if angle < 0.000001: continue
        let chord = point_of(mesh, topology.edge_points[edge * 2 + 1]).subtract(point_of(mesh, topology.edge_points[edge * 2])).length()
        radii[edge] = chord / (2.0 * math.sin(angle * 0.5))
        rises[edge] = mean.multiply_scalar(smoothness * radii[edge] * (1.0 - length * 0.5) / length)

## Catmull-Clark positions of the original points: interior (F + 2R + (n-3)P)/n
## over n faces, boundary 3/4 P + 1/8 each boundary neighbor; points on
## creases or other irregular boundaries stay.
func catmull_clark_points(topology: const Topology*, builder: TopologyBuilder*, centers: const Vector3[]) -> !:
    let point_faces = try new Vector3[topology.points] --- in memory.heap
    defer free(point_faces) in memory.heap
    let face_counts = try new u32[topology.points] --- in memory.heap
    defer free(face_counts) in memory.heap
    for at in 0..<topology.points:
        point_faces[at] = Vector3()
        face_counts[at] = 0
    for corner in 0..<topology.corners.length:
        let point = (usize)topology.corners[corner]
        point_faces[point] = point_faces[point].add(centers[(usize)topology.corner_faces[corner]])
        face_counts[point] += 1
    let moved = try new Vector3[topology.points] --- in memory.heap
    defer free(moved) in memory.heap
    for point in 0..<topology.points:
        let p = builder.position((i32)point)
        moved[point] = p
        let first = (usize)topology.point_edge_offsets[point]
        let end = (usize)topology.point_edge_offsets[point + 1]
        var mids = Vector3()
        var boundary = Vector3()
        var boundary_count = 0
        var irregular = false
        for slot in first..<end:
            let edge = (usize)topology.point_edges[slot]
            let a = topology.edge_points[edge * 2]
            let other = topology.edge_points[edge * 2 + 1] if (usize)a == point else a
            let q = builder.position(other)
            mids = mids.add(p.add(q).multiply_scalar(0.5))
            let uses = topology.edge_corner_offsets[edge + 1] - topology.edge_corner_offsets[edge]
            if uses == 1:
                boundary = boundary.add(q)
                boundary_count += 1
            elif uses > 2:
                irregular = true
        let n = (f64)(end - first)
        if irregular or n == 0.0: continue
        if boundary_count == 2:
            moved[point] = p.multiply_scalar(0.75).add(boundary.multiply_scalar(0.125))
        elif boundary_count == 0 and face_counts[point] > 0:
            let faces = point_faces[point].multiply_scalar(1.0 / (f64)face_counts[point])
            let edges = mids.multiply_scalar(1.0 / n)
            moved[point] = faces.add(edges.multiply_scalar(2.0)).add(p.multiply_scalar(n - 3.0)).multiply_scalar(1.0 / n)
    for point in 0..<topology.points: builder.move_point((i32)point, moved[point])
