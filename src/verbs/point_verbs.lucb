## Verbs that move points and keep the topology: Transform (move, rotate,
## scale about a pivot), Smooth, Mountain (noise), Peak (along normals),
## Flatten and Snap. They copy the positions once, write the group's points
## in parallel, and share the topology, its caches, the triangles and every
## attribute; the output selection is the input's group.

let transform_parms: ParmSpec[7] = [
    ParmSpec("Translate", ParmKind.vector, 0.0, -100000.0, 100000.0, 3, "", "Moves the group, after rotating and scaling."),
    ParmSpec("Rotate", ParmKind.vector, 0.0, -360000.0, 360000.0, 3, "", "Rotation about X, then Y, then Z, in degrees, about the pivot."),
    ParmSpec("Scale", ParmKind.vector, 1.0, -100000.0, 100000.0, 3, "", "Scale along each axis about the pivot."),
    ParmSpec("Pivot", ParmKind.menu, 0.0, 0.0, 2.0, 1, "Centroid|Origin|Custom", "Rotate and scale about the group's centroid, the origin or the custom point."),
    ParmSpec("Custom pivot", ParmKind.vector, 0.0, -100000.0, 100000.0, 3, "", "The point rotation and scale happen about when Pivot is Custom."),
    ParmSpec("Soft radius", ParmKind.number, 0.0, 0.0, 100000.0, 1, "", "Points within this distance of the group follow it, less the farther they are (0: off).", 5.0),
    ParmSpec("Falloff", ParmKind.menu, 3.0, 0.0, 3.0, 1, "Linear|Quadratic|Cubic|Smooth", "How the soft weight falls off with distance.")]

## Transform Components' numbers (translate, rotate in degrees, scale,
## pivot mode and custom pivot, in transform_parms' order) as matrices, for
## editors that move whole things rather than points (Edit SDF's
## primitives, Edit Sketch's curves, luce-cad's models): the rotation and
## scale, the translation, and the pivot (`middle`, the group's centroid;
## the origin; or the custom point).
pub struct ComponentTransform:
    pub let linear: Matrix4
    pub let translation: Vector3
    pub let pivot: Vector3

    pub static func of(numbers: const f64[], middle: Vector3) -> ComponentTransform!:
        if numbers.length < 13: error(errors.invalid, "a transform needs its thirteen numbers")
        let degrees = math.pi / 180.0
        let linear = Matrix4.compose(Vector3(), Vector3(numbers[3] * degrees, numbers[4] * degrees, numbers[5] * degrees), Vector3(numbers[6], numbers[7], numbers[8]))
        var pivot = Vector3(numbers[10], numbers[11], numbers[12])
        if numbers[9] == 1.0: pivot = Vector3()
        elif numbers[9] == 0.0: pivot = middle
        return ComponentTransform(linear, Vector3(numbers[0], numbers[1], numbers[2]), pivot)

    ## The whole move: rotate and scale about the pivot, then translate by
    ## `translation` (the numbers' own, or an editor's constrained one).
    pub func matrix(translation: Vector3) -> Matrix4:
        let moved = translation.add(self.pivot).subtract(self.linear.transform_point(self.pivot))
        return Matrix4(self.linear.x, self.linear.y, self.linear.z, moved)

func transform_verb() -> Verb:
    return Verb("Transform Components", "Deform", "Move, rotate and scale components about a pivot", Domain.point, true, transform_parms, false, cook_transform)

let smooth_parms: ParmSpec[2] = [
    ParmSpec("Amount", ParmKind.number, 0.5, 0.0, 1.0, 1, "", "How far each point moves toward the average of its neighbors."),
    ParmSpec("Iterations", ParmKind.integer, 1.0, 1.0, 100.0, 1, "", "Rounds of smoothing.")]

func smooth_verb() -> Verb:
    return Verb("Smooth", "Deform", "Laplacian relaxation of the group's points", Domain.point, true, smooth_parms, false, cook_smooth)

let mountain_parms: ParmSpec[2] = [
    ParmSpec("Height", ParmKind.number, 0.2, 0.0, 100000.0, 1, "", "Largest displacement of the noise.", 2.0),
    ParmSpec("Seed", ParmKind.integer, 0.0, 0.0, 100000.0, 1, "", "Another seed gives other noise.")]

func mountain_verb() -> Verb:
    return Verb("Mountain", "Deform", "Deterministic noise displacement", Domain.point, true, mountain_parms, false, cook_mountain)

let peak_parms: ParmSpec[1] = [ParmSpec("Distance", ParmKind.number, 0.2, -100000.0, 100000.0, 1, "", "Distance along the averaged normals.", 2.0)]

func peak_verb() -> Verb:
    return Verb("Peak", "Deform", "Move points along their normals", Domain.point, true, peak_parms, false, cook_peak)

let flatten_parms: ParmSpec[1] = [ParmSpec("Axis", ParmKind.menu, 1.0, 0.0, 2.0, 1, "X|Y|Z", "The axis flattened to the group's centroid.")]

func flatten_verb() -> Verb:
    return Verb("Flatten", "Deform", "Flatten the group onto a plane through its centroid", Domain.point, true, flatten_parms, false, cook_flatten)

let snap_parms: ParmSpec[1] = [ParmSpec("Spacing", ParmKind.number, 0.1, 0.000001, 100000.0, 1, "", "Grid spacing points snap to.")]

func snap_verb() -> Verb:
    return Verb("Snap", "Deform", "Snap points to a grid", Domain.point, true, snap_parms, false, cook_snap)

## Positions of the input (relative to its origin), written copy-on-write,
## and the group's points in ascending order.
struct Points:
    var positions: Column[Float3]
    var selected: Growing[u32]

func begin_points(input: const VerbInput*, output: VerbOutput*) -> const u32[]!:
    output.positions = mesh_positions(input.mesh)
    _ = try output.positions.writable()
    try output.moved.reserve(input.group.population())
    for word in 0..<input.group.words.length:
        var pending = input.group.words[word]
        while pending != 0:
            output.moved.items[output.moved.count] = (u32)(word * 64 + (usize)trailing_zeros(pending))
            output.moved.count += 1
            pending = pending & (pending - 1)
    output.selection = try BitsBuilder.copy_of(input.group)
    output.selection_domain = Domain.point
    return output.moved.view()

## The centroid of the group's points (relative to the origin).
func centroid(points: const Float3[], moved: const u32[]) -> Vector3:
    var sum = Vector3()
    for point in moved: sum = sum.add(points[(usize)point].vector())
    return sum.multiply_scalar(1.0 / (f64)(moved.length if moved.length > 0 else 1))

## Apply `matrix` to the listed points, each by its weight (all of it
## without weights), in parallel.
struct PlaceWork:
    let positions: Float3[]
    let moved: const u32[]
    let weights: const f32[]
    let matrix: Matrix4

func place_points(context: void*?, first: usize, end: usize):
    let work = (PlaceWork*)(context else return)
    for at in first..<end:
        let point = (usize)work.moved[at]
        let original = work.positions[point].vector()
        let target = work.matrix.transform_point(original)
        let weight = (f64)work.weights[point] if work.weights.length > 0 else 1.0
        work.positions[point] = Float3.of(original.add(target.subtract(original).multiply_scalar(weight)))

func cook_transform(input: const VerbInput*, output: VerbOutput*) -> !:
    let group = try begin_points(input, output)
    let p = input.parms
    for at in 0..<(usize)14:
        if not math.is_finite(p.at(at)): error(errors.invalid, "transform values must be finite")
    let radius = p.at(13)
    let positions = output.positions.span()
    let origin = input.mesh.position_origin()
    let axis = input.symmetry
    let tolerance = mirror_tolerance(input.mesh) if axis > 0 else 0.0
    # The centroid pivot is of the group's positive half under symmetry, so
    # the mirrored half follows by reflection.
    let middle = centroid_of(positions, group, origin, axis, tolerance) if p.at(9) == 0.0 else Vector3()
    let transform = try ComponentTransform.of(p.numbers, middle.add(origin))
    # Positions are relative to the origin: so is the matrix.
    let whole = transform.matrix(transform.translation)
    let matrix = Matrix4(whole.x, whole.y, whole.z, whole.transform_point(origin).subtract(origin))
    # Soft selection: every point within the radius moves by its weight.
    var affected = Growing[u32]()
    defer affected.close()
    var weights = Growing[f32]()
    defer weights.close()
    if radius > 0.0:
        try weights.fill(positions.length, 0.0)
        try soft_weights(input.mesh, input.group, radius, (i64)p.at(14), weights.items[..<positions.length])
        for point in 0..<positions.length:
            if weights.items[point] > 0.0: try affected.push((u32)point)
    else:
        try affected.assign(group)
    var work = PlaceWork(positions, affected.view(), weights.view(), matrix)
    parallel.parallel_for(affected.count, 16384, place_points, (void*)&work)
    if axis > 0: try mirror_points(input.mesh, positions, affected.view(), origin, axis, tolerance)
    output.moved.clear()
    try output.moved.assign(affected.view())

## The centroid of the group's points (relative to the origin); under
## symmetry, of those on the positive side of the plane.
func centroid_of(positions: const Float3[], group: const u32[], origin: Vector3, axis: i64, tolerance: f64) -> Vector3:
    var sum = Vector3()
    var count = 0.0
    for point in group:
        let p = positions[(usize)point].vector()
        if axis > 0 and p.add(origin).coordinate((usize)(axis - 1)) < -tolerance: continue
        sum = sum.add(p)
        count += 1.0
    return sum.multiply_scalar(1.0 / math.max(1.0, count))

## Symmetry: points on the negative side take the reflection of their
## mirror's new position; points on the plane stay on it.
func mirror_points(mesh: const Mesh*, positions: Float3[], affected: const u32[], origin: Vector3, axis: i64, tolerance: f64) -> !:
    var mirrors = Growing[i32]()
    defer mirrors.close()
    try mirror_map(mesh, Domain.point, axis, &mirrors)
    let before = mesh.point_span()
    for point in affected:
        let original = before[(usize)point].vector().add(origin)
        let coordinate = original.coordinate((usize)(axis - 1))
        if math.abs(coordinate) <= tolerance:
            let moved = positions[(usize)point].vector().add(origin)
            positions[(usize)point] = Float3.of(moved.with_coordinate((usize)(axis - 1), 0.0).subtract(origin))
            continue
        if coordinate > 0.0: continue
        let mirror = mirrors.items[(usize)point]
        if mirror < 0: continue
        let partner = positions[(usize)mirror].vector().add(origin)
        positions[(usize)point] = Float3.of(partner.reflected((usize)(axis - 1)).subtract(origin))

## Neighbor averages over the edges, `iterations` rounds.
func cook_smooth(input: const VerbInput*, output: VerbOutput*) -> !:
    let moved = try begin_points(input, output)
    let amount = input.parms.at(0)
    let rounds = (usize)math.max(1.0, math.min(100.0, input.parms.at(1)))
    if not (amount >= 0.0 and amount <= 1.0): error(errors.invalid, "Smooth amount must be in 0..1")
    let edges = try input.mesh.edge_span()
    let around = try input.mesh.point_edge_span()
    let positions = output.positions.span()
    let next = try new Float3[moved.length] --- in memory.heap
    defer free(next) in memory.heap
    for _ in 0..<rounds:
        var work = SmoothWork(positions, moved, edges, around.0, around.1, next, amount)
        parallel.parallel_for(moved.length, 4096, smooth_points, (void*)&work)
        for at in 0..<moved.length: positions[(usize)moved[at]] = next[at]

struct SmoothWork:
    let positions: const Float3[]
    let moved: const u32[]
    let edges: const i32[]
    let offsets: const i32[]
    let point_edges: const i32[]
    let next: Float3[]
    let amount: f64

func smooth_points(context: void*?, first: usize, end: usize):
    let work = (SmoothWork*)(context else return)
    for at in first..<end:
        let point = (usize)work.moved[at]
        let p = work.positions[point].vector()
        var sum = Vector3()
        var count = 0.0
        for slot in (usize)work.offsets[point]..<(usize)work.offsets[point + 1]:
            let edge = (usize)work.point_edges[slot]
            let a = (usize)work.edges[edge * 2]
            let other = (usize)work.edges[edge * 2 + 1] if a == point else a
            sum = sum.add(work.positions[other].vector())
            count += 1.0
        work.next[at] = Float3.of(p.add(sum.multiply_scalar(1.0 / count).subtract(p).multiply_scalar(work.amount))) if count > 0.0 else work.positions[point]

func noise(seed: f64) -> f64:
    let value = math.sin(seed * 12.9898) * 43758.5453
    return (value - math.floor(value)) * 2.0 - 1.0

func cook_mountain(input: const VerbInput*, output: VerbOutput*) -> !:
    let moved = try begin_points(input, output)
    let height = input.parms.at(0)
    let seed = input.parms.at(1)
    let positions = output.positions.span()
    for point in moved:
        let base = (f64)point + seed * 131.0
        let offset = Vector3(noise(base + 1.0), noise(base + 17.0), noise(base + 43.0)).multiply_scalar(height)
        positions[(usize)point] = Float3.of(positions[(usize)point].vector().add(offset))

## Along each point's averaged face normals.
func cook_peak(input: const VerbInput*, output: VerbOutput*) -> !:
    let moved = try begin_points(input, output)
    let distance = input.parms.at(0)
    let around = try input.mesh.point_face_span()
    let normals = input.mesh.face_normal_span()
    let positions = output.positions.span()
    for point in moved:
        var sum = Vector3()
        for slot in (usize)around.0[(usize)point]..<(usize)around.0[(usize)point + 1]:
            sum = sum.add(normals[(usize)around.1[slot]].vector())
        let length = sum.length()
        if length > 0.000001:
            positions[(usize)point] = Float3.of(positions[(usize)point].vector().add(sum.multiply_scalar(distance / length)))

func cook_flatten(input: const VerbInput*, output: VerbOutput*) -> !:
    let moved = try begin_points(input, output)
    let positions = output.positions.span()
    let center = centroid(positions, moved)
    let axis = (i64)input.parms.at(0)
    for point in moved:
        let p = positions[(usize)point]
        positions[(usize)point] = Float3(p.x if axis != 0 else (f32)center.x, p.y if axis != 1 else (f32)center.y, p.z if axis != 2 else (f32)center.z)

func cook_snap(input: const VerbInput*, output: VerbOutput*) -> !:
    let moved = try begin_points(input, output)
    let spacing = input.parms.at(0)
    if not (spacing > 0.000001): error(errors.invalid, "Snap spacing must be positive")
    let origin = input.mesh.position_origin()
    let positions = output.positions.span()
    for point in moved:
        let p = positions[(usize)point].vector().add(origin)
        let snapped = Vector3(math.floor(p.x / spacing + 0.5), math.floor(p.y / spacing + 0.5), math.floor(p.z / spacing + 0.5)).multiply_scalar(spacing)
        positions[(usize)point] = Float3.of(snapped.subtract(origin))
