from geometries.triangulation.polygon_triangulation import area_normal
import geometries.triangulation.face_scratch
from geometries.point_hash import PointHash
from geometries.topology.connectivity import Topology
from groups import GroupType, is_blank, guess_domain, GroupResult, GroupReport, group_bits, Selection, adopt_selection, strict_conversion, selection_bits
from selecting import converted, rule_at, rule_count, run_rule, mirror_tolerance, mirror_map, symmetric
