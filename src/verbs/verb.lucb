## A verb with no pick declared takes one, at every level.
let no_picks: PickSpec[1] = [PickSpec("")]

## A verb that takes no other domain as it is.
let no_domains: Domain[1] = [Domain.detail]

## The picks many tools share: faces, edges, whole pieces or their faces,
## and points, edges or faces.
let pick_faces: PickSpec[1] = [PickSpec("Faces", "faces")]
let pick_edges: PickSpec[1] = [PickSpec("Edges", "edges")]
let pick_pieces: PickSpec[1] = [PickSpec("Faces", "objects faces")]
let pick_components: PickSpec[1] = [PickSpec("Components", "points edges faces")]

## Weighted parents of interpolated elements (a new point on an edge, a new
## corner inside a face): element e takes entries offsets[e]..<offsets[e+1].
pub struct Mix:
    pub var offsets: Growing[i32]
    pub var parents: Growing[i32]
    pub var weights: Growing[f32]

    pub func init():
        self.offsets = Growing[i32]()
        self.parents = Growing[i32]()
        self.weights = Growing[f32]()

    pub func close():
        self.offsets.close()
        self.parents.close()
        self.weights.close()

## What a kernel reads: the input mesh, its group as bits of the verb's
## domain (every element when the group is empty) and the parameters.
pub struct VerbInput:
    pub let mesh: const Mesh*
    pub let group: Bits
    pub let parms: Parms
    ## Mirror across X, Y or Z (1..3; 0 none): the group is symmetric already,
    ## and point verbs move mirrored points to mirrored places.
    pub let symmetry: i64 = 0
    ## The domain of `group`: the verb's, or its second domain.
    pub let domain: Domain = Domain.face

## What a kernel returns: new positions over the same topology, a topology
## built with parents, or a finished mesh; and the output selection.
pub struct VerbOutput:
    ## Position verbs: every point's new position (relative to the input's
    ## origin) and the points that moved.
    pub var positions: Column[Float3]
    pub var moved: Growing[u32]
    pub var built: bool = false
    pub var builder: TopologyBuilder
    ## Verbs that make their mesh themselves (subsets).
    pub var mesh: Mesh*? = none
    ## The output selection and its domain.
    pub var selection: BitsBuilder
    pub var selection_domain: Domain = Domain.face
    ## A warning for the node's info line (static text), and how many
    ## elements it concerns.
    pub var warning: str = ""
    pub var skipped: usize = 0

    pub func init():
        self.positions = Column[Float3]()
        self.moved = Growing[u32]()
        self.built = false
        self.builder = TopologyBuilder()
        self.mesh = none
        self.selection = BitsBuilder(Column[u64](), 0)
        self.selection_domain = Domain.face
        self.warning = ""
        self.skipped = 0

    pub func close():
        self.positions.release()
        self.moved.close()
        self.builder.close()
        if let mesh = self.mesh: mesh_dispose(mesh)
        self.mesh = none
        self.selection.close()

pub struct Verb:
    ## The node kind and recipe name ("PolyExtrude").
    pub let name: str
    pub let category: str
    pub let description: str
    ## The domain the kernel works on; other group types convert to it.
    pub let domain: Domain
    ## Whether the group may name other domains (converted).
    pub let converts: bool
    pub let parms: const ParmSpec[]
    ## False: positions and attributes only, element ids stable.
    pub let changes_topology: bool
    pub let cook: func(const VerbInput*, VerbOutput*) -> unit!
    ## Groups of other domains convert with "any" related element (Blast:
    ## a point deletes every face using it) instead of the default rules.
    pub let loose: bool = false
    ## Other domains the kernel takes as they are (PolyExtrude: edges and
    ## points); none for a verb that converts every group to its domain.
    pub let also: const Domain[] = no_domains[..<0]
    ## Groups of other domains convert with "all" related elements (Dissolve:
    ## a face group dissolves only the edges between its faces).
    pub let strict: bool = false
    ## Whether numbers may follow the parameters (PolyDraw's drawn corners).
    pub let trailing: bool = false
    ## Whether the group stays on its own domain, whichever it is (the
    ## Select verbs: a pattern of selected points, edges or faces).
    pub let native: bool = false

    # How the verb is offered as a modeling tool. luced-3d builds its tool
    # registry from these, so a verb added to `makers` reaches the node
    # menu, the Edit Mesh tools, the menus, the marking menus, the
    # right-click menu and the docs with no other edit.

    ## The tool's label ("Bevel" for PolyBevel; "": the name).
    pub let label: str = ""
    ## "Create", "Modify" or "Select"; "" when the verb is a node only.
    pub let section: str = ""
    ## The group menus list it under ("Extrude", "Cut", "Shape", …).
    pub let family: str = ""
    ## A luciaos-assets icon name.
    pub let icon: str = ""
    ## What it works on; none declared is one pick at every level.
    pub let picks: const PickSpec[] = no_picks[..<0]
    ## The parameter a drag in the viewport sets after it runs (-1: none),
    ## and how the pointer sets it (verbs/drag.lucb): "length" a world
    ## distance hauled away from the selection's center, "normal" along the
    ## selection's average normal, "amount" a share of the parameter's
    ## range, "angle" turned about the center, "slide" along the rails
    ## `rails` gives.
    pub let drag: i64 = -1
    pub let drag_mode: str = "length"
    ## Whether the value follows the pointer as soon as the tool runs, no
    ## button held (Blender's Extrude and Edge Slide); else a drag sets it.
    pub let follows: bool = false
    ## The count parameter the wheel steps while the drag lasts (-1: none).
    pub let wheel: i64 = -1
    ## The vector parameter X, Y and Z set while the drag lasts (an axis
    ## lock), and the menu parameter set to its last choice with it (-1:
    ## none).
    pub let axis: i64 = -1
    pub let axis_choice: i64 = -1
    ## The rails a "slide" drag runs along, from the input and parameters.
    pub let rails: (func(const VerbInput*, Rails*) -> unit!)? = none
    ## Viewport input it takes besides the selection: "" none, "stroke"
    ## (the knife), "place" (PolyDraw's clicked corners), "hover" (Loop
    ## Cut's ring under the pointer, placed by a click).
    pub let gesture: str = ""
    ## Whether, with nothing selected, it runs on everything.
    pub let whole: bool = false
    ## The select rule it runs instead of `cook` (selecting/registry.lucb's
    ## index; -1: none).
    pub let rule: i64 = -1

    ## Whether the kernel takes groups on `domain` as they are (`also`).
    pub func takes(domain: Domain) -> bool:
        for other in self.also:
            if other == domain: return true
        return false

## A run's product: the output mesh, its selection and the warning.
pub struct VerbRun:
    pub var mesh: Mesh*
    pub var selection: Column[u64]
    pub var selection_count: usize
    pub var selection_domain: Domain
    pub var warning: str
    pub var misses: usize

    pub func close():
        mesh_dispose(self.mesh)
        self.selection.release()

## Run `verb` on `mesh`: the group (text; empty is every element) on
## `group_type`'s domain, made symmetric across `symmetry` (0 none, 1 X,
## 2 Y, 3 Z), converted to the verb's domain. With `keep`, the output
## selection is the group carried through the verb (a new element is
## selected when all its parents were) instead of what the verb made.
pub func run_verb(verb: const Verb*, mesh: const Mesh*, group: str, group_type: i64, numbers: const f64[], symmetry: i64 = 0, keep: bool = false) -> VerbRun!:
    var resolved = try resolve_group(verb, mesh, group, group_type, symmetry)
    defer resolved.close()
    let domain = resolved.domain
    let target = resolved.target
    # The group rides through the verb as `.carried` when it is kept.
    var carrier: interop.Reference[Mesh]? = none
    defer:
        if let owner = carrier: owner.release()
    var source = mesh
    if keep:
        let owner = try with_group_bits(mesh, ".carried", domain, resolved.chosen.view())
        carrier = owner
        source = owner.value()
    let bits = resolved.bits.view()
    var values = try filled_parms(verb.parms, numbers, verb.trailing)
    defer values.close()
    var output = VerbOutput()
    defer output.close()
    let input = VerbInput(source, bits, Parms(values.view()), symmetry, target)
    if verb.rule >= 0:
        let rule = rule_at((usize)verb.rule)
        let made = try run_rule(&rule, source, bits, target, values.view())
        output.selection.close()
        output.selection = made.bits
        output.selection_domain = made.domain
    else:
        let cook = verb.cook
        try cook(&input, &output)
    let product = try finish(source, &output)
    # Edges the kernel selected by their points: found on the output.
    if output.built and output.builder.selected_edges.count > 0:
        select_edges(product, &output) catch failure:
            mesh_dispose(product)
            error(failure.code, failure.message)
    var selection = output.selection.finish()
    var selection_domain = output.selection_domain
    if keep:
        let carried_index = product.attribute_on(".carried", domain)
        if carried_index >= 0:
            let entry = product.attribute_entry(carried_index) catch failure:
                mesh_dispose(product)
                selection.release()
                error(failure.code, failure.message)
            selection.release()
            selection = Column[u64].copy_of(u64[]((u64*)entry.data.view().data, entry.data.view().length // 8)) catch failure:
                mesh_dispose(product)
                error(failure.code, failure.message)
            selection_domain = domain
            remove_attribute(product, ".carried", domain)
    # The output selection also rides in the mesh as the group `.selection`
    # (Houdini's cook selection), so it reaches the viewport with the result.
    mark_selection(product, &selection, selection_domain) catch failure:
        mesh_dispose(product)
        selection.release()
        error(failure.code, failure.message)
    let count = product.domain_size(selection_domain) catch failure:
        mesh_dispose(product)
        selection.release()
        error(failure.code, failure.message)
    return VerbRun(product, selection, count, selection_domain, output.warning, resolved.misses)

## A group as a verb reads it: `chosen` on the domain it names (made
## symmetric), and `bits` on the domain the kernel works on.
struct Resolved:
    var chosen: BitsBuilder
    var domain: Domain
    var bits: BitsBuilder
    var target: Domain
    var misses: usize

    func close():
        self.chosen.close()
        self.bits.close()

## Verb `verb`'s group on `mesh`: the expression (empty is every element)
## on `group_type`'s domain, made symmetric across `symmetry` (0 none,
## 1 X, 2 Y, 3 Z), converted to the domain the kernel works on.
func resolve_group(verb: const Verb*, mesh: const Mesh*, group: str, group_type: i64, symmetry: i64) -> Resolved!:
    let expression = group if not is_blank(group) else "*"
    let named = try GroupType.of(group_type)
    var domain = named.domain(verb.domain)
    if named == GroupType.guess: domain = try guess_domain(mesh, expression, verb.domain)
    let target = domain if verb.native or verb.takes(domain) else verb.domain
    if not verb.converts and domain != target: error(errors.invalid, "this operation works on another component type")
    if symmetry < 0 or symmetry > 3: error(errors.invalid, "symmetry is 0 (none), 1 (X), 2 (Y) or 3 (Z)")
    var result = try group_bits(mesh, expression, domain)
    defer result.bits.release()
    var chosen = try BitsBuilder.copy_of(Bits(result.bits.view(), try mesh.domain_size(domain)))
    errdefer chosen.close()
    if symmetry > 0:
        var mirrored = try symmetric(mesh, chosen.view(), domain, symmetry)
        chosen.close()
        chosen = mirrored
    var bits = try BitsBuilder.copy_of(chosen.view())
    errdefer bits.close()
    if domain != target:
        let topology = try Topology.of(mesh)
        var moved = try converted(&topology, bits.view(), domain, target, (strict_conversion(domain, target) or verb.strict) and not verb.loose)
        bits.close()
        bits = moved
    return Resolved(chosen, domain, bits, target, result.report.misses)

## The kernel's output as a mesh: moved positions share everything else, a
## built topology carries every attribute through its provenance.
func finish(source: const Mesh*, output: VerbOutput*) -> Mesh*!:
    if let made = output.mesh:
        output.mesh = none
        return made
    if output.built:
        # Faces the kernel made degenerate (a bridge between coplanar loops,
        # say): nothing sensible to show, so the input passes through.
        let built: Mesh*? = output.builder.finish(source) catch failure:
            if failure.code != errors.invalid: error(failure.code, failure.message)
            output.warning = "The operation would make degenerate faces; the input passes through"
            recover none
        if let made = built:
            # Meshes keep faces without an area; a verb making new ones
            # still refuses.
            if degenerate_faces(made) <= degenerate_faces(source): return made
            mesh_dispose(made)
            output.warning = "The operation would make degenerate faces; the input passes through"
        output.selection.close()
        output.selection = try BitsBuilder.zeros(0)
        output.builder.selected_edges.clear()
        return try mesh_share(source)
    if not output.positions.is_empty():
        # Meshes keep faces without an area, but a modeling verb that collapses
        # faces (points moved onto each other) has nothing sensible to make: the
        # input passes through with a warning, as for built faces above.
        let moved: Mesh*? = moved_storage(source, output.positions, output.moved.view()) catch failure:
            if failure.code != errors.invalid: error(failure.code, failure.message)
            output.warning = "The operation would collapse faces; the input passes through"
            recover none
        if let made = moved:
            if degenerate_faces(made) <= degenerate_faces(source): return made
            mesh_dispose(made)
            output.warning = "The operation would collapse faces; the input passes through"
    return try mesh_share(source)

## The output selection as the edges between the builder's selected point
## pairs.
func select_edges(product: const Mesh*, output: VerbOutput*) -> !:
    var bits = try BitsBuilder.zeros((usize)(try product.edge_count()))
    errdefer bits.close()
    _ = try edge_bits_from_pairs(product, output.builder.selected_edges.view(), &bits)
    output.selection.close()
    output.selection = bits
    output.selection_domain = Domain.edge

## Replace any `.selection` group of `mesh` with `bits` on `domain`. No
## bits at all is a kernel that selected nothing; any other length must be
## the domain's.
func mark_selection(mesh: Mesh*, bits: Column[u64]*, domain: Domain) -> !:
    let domains: Domain[4] = [Domain.point, Domain.corner, Domain.face, Domain.edge]
    for other in domains: remove_attribute(mesh, ".selection", other)
    let count = try mesh.domain_size(domain)
    if bits.count() == 0:
        var empty = try BitsBuilder.zeros(count)
        bits.release()
        *bits = empty.finish()
    if bits.count() != (count + 63) // 64: trap("a verb's selection does not cover its domain")
    try put_attribute(mesh, try Attribute.group_of(".selection", domain, count, bits.view()))

## How many faces have no area (a zero normal).
func degenerate_faces(mesh: const Mesh*) -> usize:
    var count: usize = 0
    for normal in mesh.face_normal_span():
        if normal.x == 0.0 and normal.y == 0.0 and normal.z == 0.0: count += 1
    return count
