## The box around a geometry, in world space (lane 3 is 0).
pub struct Bounds:
    pub let min: f32[4]
    pub let max: f32[4]
    pub let center: f32[4]
    pub let size: f32[4]

## Where a ray met a geometry: the primitive (-1 for a miss), its parametric uv (for
## `primuv_*`), the world position and the distance along the ray.
pub struct Hit:
    pub let prim: i32
    pub let uv: f32[2]
    pub let position: f32[4]
    pub let distance: f32

## Up to 16 point numbers, nearest first.
pub struct Near:
    pub let count: i32
    pub let points: i32[16]

## A point cloud an input's `pcopen` found: up to 64 points near a position, nearest
## first. VEX's pcnumfound is `count()`, pcimport is `f32(i, name)` / `vec3(i, name)`, and
## pcfilter is `filter_f32(name)` / `filter_vec3(name)`.
pub struct PointCloud:
    var unused: i32
    ## How many points were found (VEX `pcnumfound`).
    pub func count() -> i32:
        return 0
    ## The `i`-th found point's number and its distance from the position.
    pub func point(i: i32) -> i32:
        return i
    pub func distance(i: i32) -> f32:
        _ = i
        return 0.0
    ## Point attribute `name` ("P" the position) of the `i`-th found point (VEX
    ## `pcimport`).
    pub func f32(i: i32, name: str) -> f32:
        _ = i
        _ = name
        return 0.0
    pub func vec3(i: i32, name: str) -> f32[4]:
        _ = i
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    ## Point attribute `name` averaged over the found points with weights
    ## `1 - (distance / radius)^2`, normalized (VEX `pcfilter`): one call smooths.
    pub func filter_f32(name: str) -> f32:
        _ = name
        return 0.0
    pub func filter_vec3(name: str) -> f32[4]:
        _ = name
        return [0.0, 0.0, 0.0, 0.0]

## A geometry the snippet reads: `k.input(0)` (the node's input as it was before this
## run) or `k.input(1)` (the second input; empty when not connected). Numbers out of
## range fail the cook at the element.
