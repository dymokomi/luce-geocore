        return 0
    pub func point_i64(index: i32, name: str) -> i64:
        _ = index
        _ = name
        return 0
    pub func point_vec2(index: i32, name: str) -> f32[2]:
        _ = index
        _ = name
        return [0.0, 0.0]
    pub func point_vec3(index: i32, name: str) -> f32[4]:
        _ = index
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    pub func point_vec4(index: i32, name: str) -> f32[4]:
        _ = index
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    ## Primitive attribute `name` of primitive `index`.
    pub func prim_f32(index: i32, name: str) -> f32:
        _ = index
        _ = name
        return 0.0
    pub func prim_f64(index: i32, name: str) -> f64:
        _ = index
        _ = name
        return 0.0
    pub func prim_i32(index: i32, name: str) -> i32:
        _ = index
        _ = name
        return 0
    pub func prim_i64(index: i32, name: str) -> i64:
        _ = index
        _ = name
        return 0
    pub func prim_vec2(index: i32, name: str) -> f32[2]:
        _ = index
        _ = name
        return [0.0, 0.0]
    pub func prim_vec3(index: i32, name: str) -> f32[4]:
        _ = index
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    pub func prim_vec4(index: i32, name: str) -> f32[4]:
        _ = index
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    ## The points of primitive `prim`, in order: how many, and the `at`-th.
    pub func prim_point_count(prim: i32) -> i32:
        _ = prim
        return 0
    pub func prim_point(prim: i32, at: i32) -> i32:
        _ = prim
        _ = at
        return 0
    ## The primitives using point `point`: how many, and the `at`-th.
    pub func point_prim_count(point: i32) -> i32:
        _ = point
        return 0
    pub func point_prim(point: i32, at: i32) -> i32:
        _ = point
        _ = at
        return 0
    ## The points sharing an edge with point `point`: how many, and the `at`-th.
    pub func neighbor_count(point: i32) -> i32:
        _ = point
        return 0
