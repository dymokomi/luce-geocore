let stub_text: str = """## The geometry a Code node's snippet runs against (luce-geocore). Positions, normals
## and colors are f32[4] with lane 3 zero; uv is f32[2]. Accessors take the attribute's
## name as a literal and read or write it in its stored type; reading an attribute the
## geometry lacks gives 0, and writing one creates it.

## The point a snippet runs for (Run Over Points).
pub struct Point:
    ## Position, in world space.
    pub var P: f32[4]
    ## Normal, 0 when the geometry has none; writing creates it.
    pub var N: f32[4]
    ## Color; writing creates it.
    pub var Cd: f32[4]
    ## Texture coordinates on points.
    pub var uv: f32[2]
    ## This point's number and how many points there are.
    pub let ptnum: i32
    pub let numpt: i32
    var written: bool

    ## Point attribute `name`, of its stored type.
    pub func f32(name: str) -> f32:
        _ = name
        return 0.0
    pub func f64(name: str) -> f64:
        _ = name
        return 0.0
    pub func i32(name: str) -> i32:
        _ = name
        return 0
    pub func i64(name: str) -> i64:
        _ = name
        return 0
    pub func vec2(name: str) -> f32[2]:
        _ = name
        return [0.0, 0.0]
    pub func vec3(name: str) -> f32[4]:
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    pub func vec4(name: str) -> f32[4]:
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    ## Set point attribute `name`, creating it with the setter's type.
    pub func set_f32(name: str, value: f32):
        _ = name
        _ = value
        self.written = true
    pub func set_f64(name: str, value: f64):
        _ = name
        _ = value
        self.written = true
    pub func set_i32(name: str, value: i32):
        _ = name
        _ = value
