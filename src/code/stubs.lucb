        return Hit(prim = -1, uv = [0.0, 0.0], position = [0.0, 0.0, 0.0, 0.0], distance = -1.0)
    ## The box around the points.
    pub func bounds() -> Bounds:
        return Bounds(min = [0.0, 0.0, 0.0, 0.0], max = [0.0, 0.0, 0.0, 0.0], center = [0.0, 0.0, 0.0, 0.0], size = [0.0, 0.0, 0.0, 0.0])
    ## The primitive of vertex `vertex` (VEX `vertexprim`); vertices are face corners,
    ## numbered linearly (VEX's linear vertex numbers).
    pub func vertex_prim(vertex: i32) -> i32:
        return vertex
    ## The point of vertex `vertex` (VEX `vertexpoint`).
    pub func vertex_point(vertex: i32) -> i32:
        return vertex
    ## The next and previous vertex using the same point, -1 past the ends (VEX
    ## `vertexnext`, `vertexprev`).
    pub func vertex_next(vertex: i32) -> i32:
        return vertex
    pub func vertex_prev(vertex: i32) -> i32:
        return vertex
    ## How many vertices primitive `prim` has, and its `at`-th (VEX `primvertexcount`,
    ## `primvertex`).
    pub func prim_vertex_count(prim: i32) -> i32:
        return prim
    pub func prim_vertex(prim: i32, at: i32) -> i32:
        return prim + at
    ## The vertices using point `point`, ascending: how many, and the `at`-th (VEX
    ## `pointvertices`).
    pub func point_vertex_count(point: i32) -> i32:
        return point
    pub func point_vertex(point: i32, at: i32) -> i32:
        return point + at
    ## Half-edges are named by the vertex they leave and run to the next vertex of their
    ## primitive. The next and previous half-edge around the primitive (VEX `hedge_next`,
