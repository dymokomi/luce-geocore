    pub func xyzdist(position: f32[4]) -> f32:
        _ = position
        return 0.0
    pub func closest_prim(position: f32[4]) -> i32:
        _ = position
        return -1
    pub func closest_uv(position: f32[4]) -> f32[2]:
        _ = position
        return [0.0, 0.0]
    ## Point attribute `name` ("P" for positions) interpolated at `uv` on primitive `prim`.
    pub func primuv_f32(prim: i32, uv: f32[2], name: str) -> f32:
