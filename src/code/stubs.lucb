    pub func point_f32(index: i32, name: str) -> f32:
        _ = index
        _ = name
        return 0.0
    pub func point_f64(index: i32, name: str) -> f64:
        _ = index
        _ = name
        return 0.0
    pub func point_i32(index: i32, name: str) -> i32:
