## The box around a geometry, in world space (lane 3 is 0).
pub struct Bounds:
    pub let min: f32[4]
    pub let max: f32[4]
    pub let center: f32[4]
    pub let size: f32[4]

## Where a ray met a geometry: the primitive (-1 for a miss), its parametric uv (for
## `primuv_*`), the world position and the distance along the ray.
pub struct Hit:
    pub let prim: i32
    pub let uv: f32[2]
    pub let position: f32[4]
    pub let distance: f32

## Up to 16 point numbers, nearest first.
pub struct Near:
    pub let count: i32
    pub let points: i32[16]

## A geometry the snippet reads: `k.input(0)` (the node's input as it was before this
