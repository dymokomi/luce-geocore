## The node: the timeline, its spare parameters, the detail attributes, the inputs, and
## edits queued for after the run (new points and primitives, attribute sets, removals:
## applied in element order, so the result is the same on any number of threads).
pub struct Kernel:
    ## The timeline's frame, seconds (frame 1 is 0) and frames per second.
    pub let frame: f64
    pub let time: f64
    pub let fps: f64
    var written: bool

    ## Input `index`: 0 the node's own input, 1 its second.
    pub func input(index: i32) -> const Geometry*:
        _ = index
        return (const Geometry*)(void*)4096
    ## Queue a new point at world position `position`; its number, for add_prim and the
    ## set_point_ accessors (an element adds at most 1024 points and 1024 primitives).
    pub func add_point(position: f32[4]) -> i32:
        _ = position
        return 0
    ## Queue a new polygon through the first `count` of `points` (3 or more); its number.
    pub func add_prim(points: i32[16], count: i32) -> i32:
        _ = points
        _ = count
        return 0
    ## Queue removing point `index` (and the primitives using it), or primitive `index`.
    pub func remove_point(index: i32):
        _ = index
    pub func remove_prim(index: i32):
        _ = index
    ## Queue setting attribute `name` of point `index` (a new point's number too); it wins over writes through `p`.
    pub func set_point_f32(index: i32, name: str, value: f32):
        _ = index
        _ = name
        _ = value
    pub func set_point_f64(index: i32, name: str, value: f64):
        _ = index
        _ = name
        _ = value
    pub func set_point_i32(index: i32, name: str, value: i32):
        _ = index
