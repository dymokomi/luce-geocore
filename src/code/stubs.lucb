    pub func hedge_next(hedge: i32) -> i32:
        return hedge
    pub func hedge_prev(hedge: i32) -> i32:
        return hedge
    ## A half-edge's source and destination points (VEX `hedge_srcpoint`, `hedge_dstpoint`).
    pub func hedge_src_point(hedge: i32) -> i32:
        return hedge
    pub func hedge_dst_point(hedge: i32) -> i32:
        return hedge
    ## A half-edge's primitive (VEX `hedge_prim`).
    pub func hedge_prim(hedge: i32) -> i32:
        return hedge
    ## How many half-edges lie on the same edge, this one included, either direction (VEX
    ## `hedge_equivcount`): 1 on a boundary, 2 inside a manifold.
    pub func hedge_equiv_count(hedge: i32) -> i32:
        return hedge
    ## A half-edge from point `src` to point `dst`, or -1 (VEX `pointhedge`).
    pub func point_hedge(src: i32, dst: i32) -> i32:
        return src + dst
    ## Primitive `prim`'s first half-edge (VEX `primhedge`).
    pub func prim_hedge(prim: i32) -> i32:
        return prim
    ## The primitives sharing an edge with `prim`, ascending: how many, and the `at`-th
    ## (VEX `polyneighbours`).
    pub func poly_neighbor_count(prim: i32) -> i32:
        return prim
    pub func poly_neighbor(prim: i32, at: i32) -> i32:
        return prim + at
    ## How many points group pattern `group` holds (VEX `npointsgroup`; any group
    ## expression), and the same for primitives (VEX `nprimsgroup`). The pattern is a
    ## literal, expanded once per cook.
    pub func npointsgroup(group: str) -> i32:
        _ = group
        return 0
    pub func nprimsgroup(group: str) -> i32:
        _ = group
        return 0
    ## Pattern `pattern`'s points, ascending: how many, and the `at`-th (VEX
    ## `expandpointgroup` as a count and an index); the primitive forms likewise.
    pub func expandpointgroup_count(pattern: str) -> i32:
        _ = pattern
        return 0
    pub func expandpointgroup(pattern: str, at: i32) -> i32:
        _ = pattern
        return at
    pub func expandprimgroup_count(pattern: str) -> i32:
        _ = pattern
        return 0
    pub func expandprimgroup(pattern: str, at: i32) -> i32:
        _ = pattern
        return at
    ## The box's lowest corner, highest corner, center and size (VEX `getbbox_min` ...).
    pub func getbbox_min() -> f32[4]:
        return [0.0, 0.0, 0.0, 0.0]
    pub func getbbox_max() -> f32[4]:
        return [0.0, 0.0, 0.0, 0.0]
    pub func getbbox_center() -> f32[4]:
        return [0.0, 0.0, 0.0, 0.0]
    pub func getbbox_size() -> f32[4]:
        return [0.0, 0.0, 0.0, 0.0]
    ## `position` as a fraction of the box along each axis, 0 at its lowest corner and 1 at
    ## its highest; 0.5 along an axis without extent (VEX `relbbox`, `relpointbbox`: the
    ## same box for polygons).
    pub func relbbox(position: f32[4]) -> f32[4]:
        return position
    pub func relpointbbox(position: f32[4]) -> f32[4]:
        return position
    ## The closest surface position to `position` (VEX `minpos`).
    pub func minpos(position: f32[4]) -> f32[4]:
        return position
    ## Point `point`'s normal: its primitives' area vectors summed, unit length (VEX
    ## `computenormal` for a point); zero when they have no area.
    pub func computenormal(point: i32) -> f32[4]:
        _ = point
        return [0.0, 0.0, 0.0, 0.0]
    ## The length along primitive `prim` between parametric `u1` and `u2` in 0..1 (VEX
    ## `primarclen`): a polygon's u runs once around it, each edge an equal share.
    pub func primarclen(prim: i32, u1: f32, u2: f32) -> f32:
        _ = prim
        return u2 - u1
    ## The length of primitive `prim` as an open curve through its vertices (VEX
    ## `curvearclen`).
    pub func curvearclen(prim: i32) -> f32:
        _ = prim
        return 0.0
    ## Point `point`'s distance along the surface's edges from the nearest point of group
    ## pattern `group`, -1 where none reaches (VEX `surfacedist`). Each pattern's field is
    ## computed once per cook (Dijkstra over the edges).
    pub func surfacedist(group: str, point: i32) -> f32:
        _ = group
        return (f32)point
    ## The generalized winding number at `position`: 1 inside a closed outward-facing
    ## mesh, 0 outside, between at holes (VEX `windingnumber`; fast winding numbers,
    ## within about 0.2% of the exact value).
    pub func windingnumber(position: f32[4]) -> f32:
        _ = position
        return 0.0
    ## Open a point cloud (VEX `pcopen`): the nearest `max_count` points (up to 64) within
    ## `radius` of `position`, nearest first, read through the PointCloud's methods. A
    ## later open at the same place in the snippet (a loop) replaces this one's points.
    pub func pcopen(position: f32[4], radius: f32, max_count: i32) -> const PointCloud*:
        _ = position
        _ = radius
        _ = max_count
        return (const PointCloud*)(void*)4096
    ## The same search as `pcopen` (VEX `pcfind`, whose point numbers are `pc.point(i)`).
    pub func pcfind(position: f32[4], radius: f32, max_count: i32) -> const PointCloud*:
        _ = position
        _ = radius
        _ = max_count
        return (const PointCloud*)(void*)4096
    ## The points within `radius` whose own radius, point attribute `radius_name` times
    ## `scale`, reaches `position` (VEX `pcfind_radius`), nearest first, up to `max_count`.
    pub func pcfind_radius(position: f32[4], radius_name: str, scale: f32, radius: f32, max_count: i32) -> const PointCloud*:
        _ = position
        _ = radius_name
        _ = scale
        _ = radius
        _ = max_count
        return (const PointCloud*)(void*)4096
    ## The trilinear value of volume grid `name` at `position` (VEX `volumesample`): ""
    ## names the first grid, "#2" the third, anything else a grid by name; an input with
    ## an SDF (and no grid of that name) samples the SDF exactly. 0 when there is neither.
    pub func volume_sample(name: str, position: f32[4]) -> f32:
        _ = name
        _ = position
        return 0.0
    ## A vector volume, grids `name.x`, `name.y` and `name.z` (VEX `volumesamplev`).
    pub func volume_sample_vec3(name: str, position: f32[4]) -> f32[4]:
        _ = name
        return position
    ## The gradient at `position` by central differences a voxel apart (VEX
    ## `volumegradient`); for an SDF a thousandth of its extent apart.
    pub func volume_gradient(name: str, position: f32[4]) -> f32[4]:
        _ = name
        return position
    ## Voxel (i, j, k)'s stored value, the grid's background outside its leaves (VEX
    ## `volumeindex`).
    pub func volume_index(name: str, i: i32, j: i32, k: i32) -> f32:
        _ = name
        return (f32)(i + j + k)
    ## The nearest voxel's (i, j, k) to `position`, whole numbers in lanes 0 to 2 (VEX
    ## `volumepostoindex`).
    pub func volume_pos_to_index(name: str, position: f32[4]) -> f32[4]:
        _ = name
        return position
    ## Voxel (i, j, k)'s center (VEX `volumeindextopos`).
    pub func volume_index_to_pos(name: str, i: i32, j: i32, k: i32) -> f32[4]:
        _ = name
        return [(f32)i, (f32)j, (f32)k, 0.0]
    ## The voxels the grid's leaves span along each axis (VEX `volumeres`; a sparse grid
    ## has no fixed resolution); zero without a grid.
    pub func volume_res(name: str) -> f32[4]:
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    ## The grid's voxel edge length (VEX `volumevoxeldiameter` over the square root of 3).
    pub func volume_voxel_size(name: str) -> f32:
        _ = name
        return 0.0

## The node: the timeline, its spare parameters, the detail attributes, the inputs, and
## edits queued for after the run (new points and primitives, attribute sets, removals:
## applied in element order, so the result is the same on any number of threads).
pub struct Kernel:
    ## The timeline's frame, seconds (frame 1 is 0) and frames per second.
    pub let frame: f64
    pub let time: f64
    pub let fps: f64
    var written: bool

    ## Input `index`: 0 the node's own input, 1 its second.
    pub func input(index: i32) -> const Geometry*:
        _ = index
        return (const Geometry*)(void*)4096
    ## Ramp parameter `name` (a float ramp row on the node, made on first use) at `t`,
    ## clamped to `0..1` (Houdini's `chramp`); without data, a line from 0 to 1.
    pub func ramp(name: str, t: f32) -> f32:
        _ = name
        return t
    ## Color ramp parameter `name` at `t`: red, green and blue in lanes 0 to 2, lane 3
    ## zero; without data, black to white.
    pub func ramp_color(name: str, t: f32) -> f32[4]:
        _ = name
        return [t, t, t, 0.0]
    ## Print to the node's console (VEX `printf`): `format` with `%d`/`%i` (rounded),
    ## `%f`, `%e`, `%g` (optional precision, `%.3f`) and `%%` filled from `a` to `d` in
    ## order; a newline ends a line. Messages appear in element order, the first 200.
    pub func printf(format: str, a: f32 = 0.0, b: f32 = 0.0, c: f32 = 0.0, d: f32 = 0.0):
        _ = format
        _ = a
        _ = b
        _ = c
        _ = d
    ## Add `message` to the node's warnings; the cook succeeds (the node shows the first
    ## warning in element order and how many there were).
    pub func warning(message: str):
        _ = message
    ## Fail the cook with `message` at this line and element, as a trap does.
    pub func error(message: str):
        _ = message
    ## Queue a new point at world position `position`; its number, for add_prim and the
    ## set_point_ accessors (an element adds at most 1024 points and 1024 primitives).
    pub func add_point(position: f32[4]) -> i32:
        _ = position
        return 0
    ## Queue a new polygon through the first `count` of `points` (3 or more); its number.
    pub func add_prim(points: i32[16], count: i32) -> i32:
        _ = points
        _ = count
        return 0
    ## Queue removing point `index` (and the primitives using it), or primitive `index`.
    pub func remove_point(index: i32):
        _ = index
    pub func remove_prim(index: i32):
        _ = index
    ## Queue setting attribute `name` of point `index` (a new point's number too); it wins over writes through `p`.
    pub func set_point_f32(index: i32, name: str, value: f32):
        _ = index
        _ = name
        _ = value
    pub func set_point_f64(index: i32, name: str, value: f64):
        _ = index
        _ = name
        _ = value
    pub func set_point_i32(index: i32, name: str, value: i32):
        _ = index
        _ = name
        _ = value
    pub func set_point_i64(index: i32, name: str, value: i64):
        _ = index
        _ = name
        _ = value
    pub func set_point_vec2(index: i32, name: str, value: f32[2]):
        _ = index
        _ = name
        _ = value
    pub func set_point_vec3(index: i32, name: str, value: f32[4]):
        _ = index
        _ = name
        _ = value
    pub func set_point_vec4(index: i32, name: str, value: f32[4]):
        _ = index
        _ = name
        _ = value
    ## Queue setting attribute `name` of primitive `index`.
    pub func set_prim_f32(index: i32, name: str, value: f32):
        _ = index
        _ = name
        _ = value
    pub func set_prim_f64(index: i32, name: str, value: f64):
        _ = index
        _ = name
        _ = value
    pub func set_prim_i32(index: i32, name: str, value: i32):
        _ = index
        _ = name
        _ = value
    pub func set_prim_i64(index: i32, name: str, value: i64):
        _ = index
        _ = name
        _ = value
    pub func set_prim_vec2(index: i32, name: str, value: f32[2]):
        _ = index
        _ = name
        _ = value
    pub func set_prim_vec3(index: i32, name: str, value: f32[4]):
        _ = index
        _ = name
        _ = value
    pub func set_prim_vec4(index: i32, name: str, value: f32[4]):
        _ = index
        _ = name
        _ = value
    ## Spare parameter `name` (a row on the node, created on first use) and its default.
    pub func f32(name: str, default: f32 = 0.0) -> f32:
        _ = name
        return default
    pub func f64(name: str, default: f64 = 0.0) -> f64:
        _ = name
        return default
    pub func i32(name: str, default: i32 = 0) -> i32:
        _ = name
        return default
    pub func i64(name: str, default: i64 = 0) -> i64:
        _ = name
        return default
    pub func vec2(name: str, default: f32[2] = [0.0, 0.0]) -> f32[2]:
        _ = name
        return default
    pub func vec3(name: str, default: f32[4] = [0.0, 0.0, 0.0, 0.0]) -> f32[4]:
        _ = name
        return default
    pub func vec4(name: str, default: f32[4] = [0.0, 0.0, 0.0, 0.0]) -> f32[4]:
        _ = name
        return default
    ## Detail attribute `name` (0 when the geometry lacks it).
    pub func detail_f32(name: str) -> f32:
        _ = name
        return 0.0
    pub func detail_f64(name: str) -> f64:
        _ = name
        return 0.0
    pub func detail_i32(name: str) -> i32:
        _ = name
        return 0
    pub func detail_i64(name: str) -> i64:
        _ = name
        return 0
    pub func detail_vec2(name: str) -> f32[2]:
        _ = name
        return [0.0, 0.0]
    pub func detail_vec3(name: str) -> f32[4]:
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    pub func detail_vec4(name: str) -> f32[4]:
        _ = name
        return [0.0, 0.0, 0.0, 0.0]
    ## Set detail attribute `name` (Run Over Detail and Numbers, whose `k` may change).
    pub func set_detail_f32(name: str, value: f32):
        _ = name
        _ = value
        self.written = true
    pub func set_detail_f64(name: str, value: f64):
        _ = name
        _ = value
        self.written = true
    pub func set_detail_i32(name: str, value: i32):
        _ = name
        _ = value
        self.written = true
    pub func set_detail_i64(name: str, value: i64):
        _ = name
        _ = value
        self.written = true
    pub func set_detail_vec2(name: str, value: f32[2]):
        _ = name
        _ = value
        self.written = true
    pub func set_detail_vec3(name: str, value: f32[4]):
        _ = name
        _ = value
        self.written = true
    pub func set_detail_vec4(name: str, value: f32[4]):
        _ = name
        _ = value
        self.written = true
"""
