## Borrowed read access shared by immutable meshes and local topology workspaces.
## Face/edge numbering and lifetime belong to the implementing storage.
from math.vector import Vector3

pub interface PolygonTopology:
    func point_count() -> i64
    func point(id: i64) -> Vector3!
    func face_size(face: i64) -> i64!
    func face_point(face: i64, side: i64) -> i64!
    func face_edge(face: i64, side: i64) -> i64!
    func edge_point(edge: i64, side: i64) -> i64!
