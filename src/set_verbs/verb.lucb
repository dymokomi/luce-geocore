from fields import Sdf, SdfOp, SparseGrid, GridClass, box_grid, share_grid, primitive_sdf, combined_sdf, modified_sdf, release_sdf, sdf_type, set_sdf, release_grid, new_volume, add_grid, release_volume, volume_type, set_volume, sampled_sdf, mesh_level_set, points_level_set, surface_mesh, slice_mesh, push_mesh, VolumeLook, put_volume_look, SplatDensityOptions, splat_density

## What a set verb reads.
pub struct SetVerbInput:
    ## The first input (an empty set for generators) and the second, if any.
    pub let set: const GeometrySet*
    pub let second: const GeometrySet*?
    ## The Group text and Group Type (0 guess, 1 points, 2 edges,
    ## 3 primitives, 4 vertices).
    pub let group: str
    pub let group_type: i64
    pub let parms: Parms

## What a set verb makes: the output set (taken by the run) and what the
## node's info line should say.
pub struct SetVerbOutput:
    pub var set: GeometrySet*? = none
    pub var warning: str = ""
    pub var misses: usize = 0

    pub func close():
        if let made = self.set: dispose_set(made)
        self.set = none

pub struct SetVerb:
    pub let name: str
    pub let category: str
    pub let description: str
    ## Inputs the node has (0: a generator), and whether the second must be
    ## connected.
    pub let inputs: usize
    pub let second_required: bool
    ## Whether the node has Group and Group Type rows.
    pub let grouped: bool
    pub let parms: const ParmSpec[]
    pub let cook: func(const SetVerbInput*, SetVerbOutput*) -> unit!
    ## A text row the node shows in place of Group, by its label ("" for none); its
    ## text reaches the cook as `group`.
    pub let text_row: str = ""

## Run `verb` on `set` (and `second`), returning the output and its report.
pub func run_set_verb(verb: const SetVerb*, set: const GeometrySet*, second: const GeometrySet*?, group: str, group_type: i64, numbers: const f64[]) -> SetVerbOutput!:
    if verb.inputs > 1 and verb.second_required and second == none: error(errors.invalid, "connect the second geometry input")
    var values = try filled_parms(verb.parms, numbers)
    defer values.close()
    var output = SetVerbOutput()
    errdefer output.close()
    let input = SetVerbInput(set, second, group, group_type, Parms(values.view()))
    let cook = verb.cook
    try cook(&input, &output)
    if output.set == none: output.set = try set.storage()
    return output

# mark: Helpers for verbs

## The input set with `curves` (taken) in place of its curves.
pub func replaced_curves(input: const SetVerbInput*, made: Curves*, output: SetVerbOutput*) -> !:
    output.set = try with_curves(input.set, made)

## A set holding only `curves` (taken): what generators make.
pub func only_curves(made: Curves*, output: SetVerbOutput*) -> !:
    let storage = empty_storage() catch failure:
        curves_dispose(made)
        error(failure.code, failure.message)
    storage.put(curves_type(), (void*)made) catch failure:
        dispose_set(storage)
        error(failure.code, failure.message)
    output.set = storage

## The curves the input's group selects, as bits over curves: the group is
## read on its Group Type's domain (guessed from the names it uses) and
## converted to curves (a curve when all its points are members).
pub func selected_curves(input: const SetVerbInput*, source: const Curves*, output: SetVerbOutput*) -> BitsBuilder!:
    let named = try GroupType.of(input.group_type)
    if named == GroupType.edges: error(errors.invalid, "curves have point and primitive groups, not edge groups")
    var domain = named.domain(curve_domain)
    if named == GroupType.guess: domain = try guess_curve_domain(source, input.group, curve_domain)
    # A curve's points are its vertices too.
    if domain == Domain.corner: domain = Domain.point
    var report = GroupReport()
    var bits = try curve_group_bits(source, input.group, domain, &report)
    output.misses += report.misses
    if domain == curve_domain: return bits
    defer bits.close()
    return try convert_curve_bits(source, bits.view(), domain, curve_domain)

## The input's curves, or a warning that there are none (the set passes).
pub func input_curves(input: const SetVerbInput*, output: SetVerbOutput*) -> const Curves*?:
    let found = set_curves(input.set)
    if found == none: output.warning = "The input has no curves; it passes through"
    return found

## The set with `mesh` (taken) joined to its mesh, and without its curves
## when `drop_curves`.
pub func with_added_mesh(set: const GeometrySet*, mesh: Mesh*, drop_curves: bool) -> GeometrySet*!:
    let storage = set.storage() catch failure:
        mesh_dispose(mesh)
        error(failure.code, failure.message)
    errdefer dispose_set(storage)
    var made = mesh
    if let existing = set_mesh(set):
        let parts: MeshPart[2] = [MeshPart(existing, Matrix4()), MeshPart(mesh, Matrix4())]
        let joined = concatenated(parts) catch failure:
            mesh_dispose(mesh)
            error(failure.code, failure.message)
        defer joined.release()
        mesh_dispose(mesh)
        made = try mesh_share(joined.value())
    try storage.put(&mesh_component, (void*)made)
    if drop_curves: storage.remove(curves_type())
    return storage
