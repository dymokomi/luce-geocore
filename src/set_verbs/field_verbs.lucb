## Volume and SDF nodes: SDF primitives, booleans and modifiers (analytic
## programs), sampling into level sets (SDF, mesh, points), surfaces as
## meshes, and slices. Kernels live in luce_geocore.fields.

let center_doc: str = "Where the shape's center sits."
let voxel_doc: str = "Distance between voxels; smaller is finer and slower."
let band_doc: str = "Voxels of distance kept on each side of the surface."

## The input set with `sdf` (taken) in place of its SDF.
func with_sdf(input: const SetVerbInput*, sdf: Sdf*, output: SetVerbOutput*, keep_input: bool) -> !:
    let storage = (input.set.storage() if keep_input else empty_storage()) catch failure:
        release_sdf(sdf)
        error(failure.code, failure.message)
    storage.put(sdf_type(), (void*)sdf) catch failure:
        dispose_set(storage)
        error(failure.code, failure.message)
    output.set = storage

## The input set with `grid` (taken) as a volume, next to or instead of
## what `drop` names.
func with_grid(input: const SetVerbInput*, grid: SparseGrid*, output: SetVerbOutput*, drop: const ComponentType*?) -> !:
    let volume = new_volume() catch failure:
        release_grid(grid)
        error(failure.code, failure.message)
    add_grid(volume, grid) catch failure:
        release_volume(volume)
        error(failure.code, failure.message)
    let storage = input.set.storage() catch failure:
        release_volume(volume)
        error(failure.code, failure.message)
    storage.put(volume_type(), (void*)volume) catch failure:
        dispose_set(storage)
        error(failure.code, failure.message)
    if let kind = drop: storage.remove(kind)
    output.set = storage

# mark: Primitives

let sphere_parms: ParmSpec[2] = [
    ParmSpec("Radius", ParmKind.number, 1.0, 0.000001, 100000.0, 1, "", "Distance from the center to the surface.", 10.0),
    ParmSpec("Center", ParmKind.vector, 0.0, -100000.0, 100000.0, 3, "", center_doc)]

pub func sdf_sphere_verb() -> SetVerb:
    return SetVerb("SDF Sphere", "Volumes", "A sphere as a signed distance field", 0, false, false, sphere_parms, cook_sphere)

func cook_sphere(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    let p = input.parms
    try with_sdf(input, try primitive_sdf(SdfOp.sphere, [p.at(1), p.at(2), p.at(3), p.at(0)]), output, false)

let box_parms: ParmSpec[3] = [
    ParmSpec("Size", ParmKind.vector, 1.0, 0.000001, 100000.0, 3, "", "Width, height and depth."),
    ParmSpec("Rounding", ParmKind.number, 0.0, 0.0, 100000.0, 1, "", "Radius of the rounded edges.", 1.0),
    ParmSpec("Center", ParmKind.vector, 0.0, -100000.0, 100000.0, 3, "", center_doc)]

pub func sdf_box_verb() -> SetVerb:
    return SetVerb("SDF Box", "Volumes", "A box with rounded edges as a signed distance field", 0, false, false, box_parms, cook_box)

func cook_box(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    let p = input.parms
    let rounding = math.min(p.at(3), 0.5 * math.min(p.at(0), math.min(p.at(1), p.at(2))))
    try with_sdf(input, try primitive_sdf(SdfOp.rounded_box, [p.at(4), p.at(5), p.at(6), p.at(0) * 0.5, p.at(1) * 0.5, p.at(2) * 0.5, rounding]), output, false)

