# mark: Combining

let boolean_parms: ParmSpec[2] = [
    ParmSpec("Operation", ParmKind.menu, 0.0, 0.0, 2.0, 1, "Union|Subtract|Intersect", "Both shapes, the first without the second, or where they overlap."),
    ParmSpec("Smoothness", ParmKind.number, 0.0, 0.0, 100000.0, 1, "", "Blend width of the seam; 0 is a sharp edge.", 1.0)]

pub func sdf_boolean_verb() -> SetVerb:
    return SetVerb("SDF Boolean", "Volumes", "Combine two SDFs: union, subtract or intersect, sharp or smooth", 2, true, false, boolean_parms, cook_boolean)

func cook_boolean(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    let second = input.second else error(errors.invalid, "connect the second SDF")
    let first_field = set_sdf(input.set)
    let second_field = set_sdf(second)
    if first_field == none or second_field == none:
        output.warning = "Both inputs need an SDF; the first passes through"
        return
    let a = first_field else return
    let b = second_field else return
    let p = input.parms
    let smooth = p.at(1) > 0.0
    var op = SdfOp.unite
    if p.at(0) == 1.0: op = SdfOp.smooth_subtract if smooth else SdfOp.subtract
    elif p.at(0) == 2.0: op = SdfOp.smooth_intersect if smooth else SdfOp.intersect
    elif smooth: op = SdfOp.smooth_unite
    try with_sdf(input, try combined_sdf(a, b, op, p.at(1)), output, true)

let modify_parms: ParmSpec[2] = [
    ParmSpec("Mode", ParmKind.menu, 0.0, 0.0, 1.0, 1, "Round|Shell", "Grow the surface outward (negative: inward), or keep only a shell around it."),
    ParmSpec("Amount", ParmKind.number, 0.05, -100000.0, 100000.0, 1, "", "How far the surface moves, or half the shell's thickness.", 1.0)]

pub func sdf_modify_verb() -> SetVerb:
    return SetVerb("SDF Modify", "Volumes", "Round an SDF's surface outward or hollow it into a shell", 1, false, false, modify_parms, cook_modify)

func cook_modify(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    let found = set_sdf(input.set)
    if found == none: output.warning = "The input has no SDF; it passes through"
    let a = found else return
    let p = input.parms
    try with_sdf(input, try modified_sdf(a, SdfOp.shell if p.at(0) == 1.0 else SdfOp.round, math.abs(p.at(1)) if p.at(0) == 1.0 else p.at(1)), output, true)

# mark: Level sets

let sample_parms: ParmSpec[3] = [
    ParmSpec("Voxel size", ParmKind.number, 0.05, 0.000001, 100000.0, 1, "", voxel_doc, 1.0),
    ParmSpec("Band", ParmKind.number, 3.0, 1.0, 64.0, 1, "", band_doc, 8.0),
    ParmSpec("Keep input", ParmKind.toggle, 0.0, 0.0, 1.0, 1, "", "Keep what the volume was made from beside it.")]

pub func sdf_to_volume_verb() -> SetVerb:
    return SetVerb("SDF to Volume", "Volumes", "Sample an SDF into a narrow-band level set volume", 1, false, false, sample_parms, cook_sdf_to_volume)

func cook_sdf_to_volume(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    let found = set_sdf(input.set)
    if found == none: output.warning = "The input has no SDF; it passes through"
    let sdf = found else return
    let p = input.parms
    try with_grid(input, try sampled_sdf(sdf, p.at(0), p.at(1), "surface"), output, sdf_type() if p.at(2) == 0.0 else none)

pub func mesh_to_sdf_verb() -> SetVerb:
    return SetVerb("Mesh to SDF", "Volumes", "The signed distance of a closed mesh as a level set volume", 1, false, false, sample_parms, cook_mesh_to_sdf)

func cook_mesh_to_sdf(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    let found = set_mesh(input.set)
    if found == none: output.warning = "The input has no mesh; it passes through"
    let mesh = found else return
    let p = input.parms
    try with_grid(input, try mesh_level_set(mesh, p.at(0), p.at(1), "surface"), output, mesh_type_component() if p.at(2) == 0.0 else none)

let points_parms: ParmSpec[4] = [
    ParmSpec("Radius", ParmKind.number, 0.1, 0.000001, 100000.0, 1, "", "Radius of the sphere around each point.", 1.0),
    ParmSpec("Voxel size", ParmKind.number, 0.02, 0.000001, 100000.0, 1, "", voxel_doc, 1.0),
    ParmSpec("Band", ParmKind.number, 3.0, 1.0, 64.0, 1, "", band_doc, 8.0),
    ParmSpec("Keep input", ParmKind.toggle, 0.0, 0.0, 1.0, 1, "", "Keep the points beside the volume.")]

pub func volume_from_points_verb() -> SetVerb:
    return SetVerb("Volume from Points", "Volumes", "A level set of spheres around the input's points (mesh, cloud and curve points)", 1, false, false, points_parms, cook_volume_from_points)

func cook_volume_from_points(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    var points = Growing[Vector3]()
    defer points.close()
    if let mesh = set_mesh(input.set):
        let origin = mesh.position_origin()
        for p in mesh.point_span(): try points.push(p.vector().add(origin))
    if let data = input.set.find(&points_component):
        let cloud = (const PointCloud*)data
        let origin = cloud_origin(cloud)
        for p in cloud_positions(cloud): try points.push(p.vector().add(origin))
    if let found = set_curves(input.set):
        for at in 0..<found.point_count(): try points.push(found.point(at))
    if points.count == 0:
        output.warning = "The input has no points; it passes through"
        return
    let p = input.parms
    let grid = try points_level_set(points.view(), p.at(0), p.at(1), p.at(2), "surface")
    let storage = (input.set.storage() if p.at(3) != 0.0 else empty_storage()) catch failure:
        release_grid(grid)
        error(failure.code, failure.message)
    errdefer dispose_set(storage)
    let volume = new_volume() catch failure:
        release_grid(grid)
        error(failure.code, failure.message)
    add_grid(volume, grid) catch failure:
        release_volume(volume)
        error(failure.code, failure.message)
    try storage.put(volume_type(), (void*)volume)
    output.set = storage

# mark: Meshes and slices

let convert_parms: ParmSpec[4] = [
    ParmSpec("Voxel size", ParmKind.number, 0.0, 0.0, 100000.0, 1, "", "Sampling of SDFs; 0 is 1/256 of the longest side.", 1.0),
    ParmSpec("Isovalue", ParmKind.number, 0.0, -100000.0, 100000.0, 1, "", "The value the surface follows: a distance for level sets, a density for fog.", 1.0),
    ParmSpec("Exact", ParmKind.toggle, 1.0, 0.0, 1.0, 1, "", "Move an SDF's surface points onto its exact surface."),
    ParmSpec("Keep input", ParmKind.toggle, 0.0, 0.0, 1.0, 1, "", "Keep the SDF and volume beside the mesh.")]

pub func convert_to_mesh_verb() -> SetVerb:
    return SetVerb("Convert to Mesh", "Volumes", "The surface of the input's SDF and volume grids as a mesh (surface nets)", 1, false, false, convert_parms, cook_convert)

func cook_convert(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    let p = input.parms
    var parts = Growing[Mesh*]()
    defer:
        for part in parts.view(): mesh_dispose(part)
        parts.close()
    if let sdf = set_sdf(input.set):
        var voxel = p.at(0)
        if voxel <= 0.0:
            let box = sdf.bounds()
            let size = box.maximum.subtract(box.minimum)
            voxel = math.max(size.x, math.max(size.y, size.z)) / 256.0
        let grid = try sampled_sdf(sdf, voxel, 2.0, "surface")
        defer release_grid(grid)
        try push_mesh(&parts, try surface_mesh(grid, p.at(1), sdf if p.at(2) != 0.0 else none))
    if let volume = set_volume(input.set):
        for index in 0..<volume.grid_count():
            try push_mesh(&parts, try surface_mesh(volume.grid(index), p.at(1), none))
    if parts.count == 0:
        output.warning = "The input has no SDF or volume; it passes through"
        return
    var pieces = Growing[MeshPart]()
    defer pieces.close()
    for part in parts.view(): try pieces.push(MeshPart(part, Matrix4()))
    let joined = try concatenated(pieces.view())
    defer joined.release()
    let storage = try input.set.storage()
    errdefer dispose_set(storage)
    if p.at(3) == 0.0:
        storage.remove(sdf_type())
        storage.remove(volume_type())
    output.set = try with_added_mesh(storage, try mesh_share(joined.value()), false)
    dispose_set(storage)

let slice_parms: ParmSpec[4] = [
    ParmSpec("Axis", ParmKind.menu, 1.0, 0.0, 2.0, 1, "X|Y|Z", "The axis the slice plane faces."),
    ParmSpec("Position", ParmKind.number, 0.5, 0.0, 1.0, 1, "", "Where the plane cuts, across the field's bounds (0..1).", 1.0),
    ParmSpec("Resolution", ParmKind.integer, 128.0, 1.0, 4096.0, 1, "", "Quads along the plane's longer side.", 512.0),
    ParmSpec("Keep input", ParmKind.toggle, 1.0, 0.0, 1.0, 1, "", "Keep the field beside its slice.")]

pub func volume_slice_verb() -> SetVerb:
    return SetVerb("Volume Slice", "Volumes", "A colored plane through an SDF or volume: blue inside, orange outside, contour bands", 1, false, false, slice_parms, cook_slice)

func cook_slice(input: const SetVerbInput*, output: SetVerbOutput*) -> !:
    if set_sdf(input.set) == none and set_volume(input.set) == none:
        output.warning = "The input has no SDF or volume; it passes through"
        return
    let p = input.parms
    let mesh = try slice_mesh(input.set, (i64)p.at(0), p.at(1), (i64)p.at(2))
    if p.at(3) != 0.0:
        output.set = try with_added_mesh(input.set, mesh, false)
        return
    let storage = empty_storage() catch failure:
        mesh_dispose(mesh)
        error(failure.code, failure.message)
    storage.put(&mesh_component, (void*)mesh) catch failure:
        dispose_set(storage)
        error(failure.code, failure.message)
    output.set = storage

func mesh_type_component() -> const ComponentType*:
    return &mesh_component
