#prisma 4.0
def package "luce-geocore" {
    str owner = "dymokomi"
    str version = "0.1.1"
    str kind = "package"
    str language = "luce-base"
    str description = "Shared geometry for Luce: polygon meshes, attributes, modeling kernels and CPU spatial queries, with no GPU or UI dependency."
    str readme = "README.md"

    def export "geocore" {
        str module = "luce_geocore.geocore"
    }

    def export "geocore_native" {
        str module = "luce_geocore.native"
    }

    def export "geocore_growing" {
        str module = "luce_geocore.core.growing"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }
}
