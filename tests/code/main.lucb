## luce-geocore's Code node checks (`luc test` runs them); `--bench` times whole cooks
## over 1M points instead (tests/code/bench.py).
import bench
import checks
import stages

pub func main(arguments: str[]) -> i32!:
    if arguments.length > 1 and arguments[1] == "--bench":
        try bench.run_all()
        return 0
    try checks.points()
    try checks.parameters()
    try checks.other_modes()
    try checks.faults()
    try checks.determinism()
    try checks.checking()
    try checks.grids()
    try stages.reads()
    try stages.nearpoints_smoothing()
    try stages.distance_coloring()
    try stages.ray_projection()
    try stages.spiral()
    try stages.polygons()
    try stages.removals()
    try stages.collapsed_faces()
    try stages.neighbor_average()
    try stages.varying_gathers()
    try stages.ramps()
    try stages.topology_and_measure()
    try stages.point_clouds()
    try stages.volumes()
    try stages.messages()
    return 0
