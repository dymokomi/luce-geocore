## Stage 3 (reading geometry and a second input) and stage 4 (editing geometry from
## parallel code), with cases after common Houdini wrangle tutorials.
import interop
import memory
import strings
from luce_std import math, math32, ramp
from luce_geocore import kernel as geocore_kernel
from luce_geocore.geocore import Code, GeometryVerbs, Mesh, GeometrySet, MeshPrimitives, Vector3, Matrix4, mesh_overlay_points
import support

func expect(condition: bool, what: str):
    if not condition:
        print(f"FAIL  {what}")
        trap("stage checks")

func near(a: f64, b: f64, tolerance: f64) -> bool:
    return math.abs(a - b) <= tolerance

var failure_room: u8[512]

func failure(set: interop.Reference[GeometrySet], mode: i64, body: str, count: i64 = 0) -> str:
    var text = ""
    _ = support.run_inputs(set, none, mode, body, count) catch problem:
        text = strings.format(failure_room, f"{problem.message}") else ""
    return text

## Reads of the node's own input: counts, positions, attributes, topology, bounds.
pub func reads() -> !:
    let set = try support.grid_set(4)
    let source = try (try support.mesh_of(set)).get()
    let read = try support.mesh_of(try support.run(set, support.points_mode, "let g = k.input(0)\np.set_i32(\"np\", g.point_count())\np.set_i32(\"nf\", g.prim_count())\np.set_vec3(\"P0\", g.point_P(0))\np.set_i32(\"valence\", g.neighbor_count(p.ptnum))\np.set_i32(\"faces\", g.point_prim_count(p.ptnum))\np.set_vec3(\"size\", g.bounds().size)\nif g.neighbor_count(p.ptnum) > 0:\n    p.set_i32(\"first\", g.neighbor(p.ptnum, 0))\n"))
    let first = try source.point(0)
    for at: i64 in 0..<25:
        let x = at % 5
        let z = at // 5
        let border = (if_int(x == 0 or x == 4)) + (if_int(z == 0 or z == 4))
        expect(try support.value(read, "np", 0, at) == 25.0 and try support.value(read, "nf", 0, at) == 16.0, "point and prim counts")
        expect(try support.value(read, "P0", 0, at, 0) == first.x and try support.value(read, "P0", 0, at, 2) == first.z, "point_P")
        expect(try support.value(read, "valence", 0, at) == (f64)(4 - border), "neighbor counts")
        expect(try support.value(read, "faces", 0, at) == [4.0, 2.0, 1.0][border], "point_prim counts")
        expect(try support.value(read, "size", 0, at, 0) == 2.0 and try support.value(read, "size", 0, at, 1) == 0.0, "bounds")
        let neighbor = (i64)(try support.value(read, "first", 0, at))
        let d = (try source.point(neighbor)).subtract(try source.point(at))
        expect(near(d.dot(d), 0.25, 1e-9), "a neighbor shares an edge")
    let prims = try support.mesh_of(try support.run(set, support.primitives_mode, "let g = k.input(0)\nf.set_i32(\"n\", g.prim_point_count(f.primnum))\nf.set_i32(\"p2\", g.prim_point(f.primnum, 2))\nf.set_i32(\"back\", g.point_prim(g.prim_point(f.primnum, 0), 0))\n"))
    for face: i64 in 0..<16:
        expect(try support.value(prims, "n", 2, face) == 4.0 and try support.value(prims, "p2", 2, face) == (f64)(try source.face_point(face, 2)), "a primitive's points")
    let weighted = try support.run(set, support.points_mode, "p.set_f32(\"w\", (f32)p.ptnum * 2.0)\n")
    let shifted = try support.mesh_of(try support.run(weighted, support.points_mode, "p.set_f32(\"next\", k.input(0).point_f32((p.ptnum + 1) % p.numpt, \"w\") + k.input(0).point_f32(0, \"missing\"))\n"))
    for at: i64 in 0..<25:
        expect(try support.value(shifted, "next", 0, at) == (f64)(((at + 1) % 25) * 2), "another point's attribute (a missing one reads 0)")
    let faulted = failure(set, support.points_mode, "let far = k.input(0).point_P(p.ptnum + 100)\np.Cd = far\n")
    expect(strings.starts_with(faulted, "line 1, column ") and strings.ends_with(faulted, "index out of bounds (point 0)"), "an index out of range faults")
    expect(strings.ends_with(failure(set, support.points_mode, "p.Cd = k.input(1).point_P(0)\n"), "index out of bounds (point 0)"), "an empty second input has no points")
    print("ok    stage 3: counts, positions, attributes, topology, bounds, faults")

func if_int(condition: bool) -> i64:
    return 1 if condition else 0

## Houdini's nearpoints smoothing: each point moves to the average of its neighbors'.
pub func nearpoints_smoothing() -> !:
    let set = try support.grid_set(4)
    let source = try (try support.mesh_of(set)).get()
    let smoothed = try support.mesh_of(try support.run(set, support.points_mode, "let near = k.input(0).nearpoints(p.P, 0.6, 8)\nvar sum: f32[4] = [0.0, 0.0, 0.0, 0.0]\nfor i in 0..<near.count:\n    sum = sum + k.input(0).point_P(near.points[i])\np.set_vec3(\"avg\", sum * (1.0 / (f32)near.count))\np.set_i32(\"n\", near.count)\np.set_i32(\"self\", k.input(0).nearpoint(p.P + [0.1, 0.0, 0.0, 0.0], 1.0))\np.set_i32(\"nearest\", near.points[0])\n"))
    for at: i64 in 0..<25:
        let here = try source.point(at)
        var count: i64 = 0
        var sum = Vector3()
        for other: i64 in 0..<25:
            let p = try source.point(other)
            let d = p.subtract(here)
            if d.dot(d) <= 0.36:
                count += 1
                sum = sum.add(p)
        expect(try support.value(smoothed, "n", 0, at) == (f64)count, "nearpoints finds every point in reach")
        expect(near(try support.value(smoothed, "avg", 0, at, 0), sum.x / (f64)count, 1e-6) and near(try support.value(smoothed, "avg", 0, at, 2), sum.z / (f64)count, 1e-6), "the neighbors' average")
        expect(try support.value(smoothed, "self", 0, at) == (f64)at and try support.value(smoothed, "nearest", 0, at) == (f64)at, "the nearest point is itself")
    print("ok    stage 3: nearpoints smoothing and nearpoint")

## Houdini's coloring by distance to a second input, and its closest point.
pub func distance_coloring() -> !:
    let set = try support.grid_set(8)
    let sphere = try GeometrySet.of_mesh(try MeshPrimitives.sphere(0.5, 24))
    let surface = try (try support.mesh_of(sphere)).get()
    let colored = try support.mesh_of(try support.run_inputs(set, sphere, support.points_mode, "let g = k.input(1)\np.Cd = [g.xyzdist(p.P), 0.0, 0.0, 0.0]\nlet prim = g.closest_prim(p.P)\np.set_vec3(\"onto\", g.primuv_vec3(prim, g.closest_uv(p.P), \"P\"))\np.set_i32(\"prim\", prim)\n"))
    let mesh = try (try support.mesh_of(set)).get()
    for at: i64 in 0..<mesh.point_count():
        let point = try mesh.point(at)
        let want = try surface.surface_distance(Vector3((f64)(f32)point.x, (f64)(f32)point.y, (f64)(f32)point.z))
        let got = try support.value(colored, "Cd", 0, at, 0)
        expect(near(got, want, 1e-5), "xyzdist is the distance to the surface")
        let onto = Vector3(try support.value(colored, "onto", 0, at, 0), try support.value(colored, "onto", 0, at, 1), try support.value(colored, "onto", 0, at, 2))
        let d = onto.subtract(point)
        expect(near(math.sqrt(d.dot(d)), want, 1e-4), "primuv at the closest uv is the closest point")
        expect(try support.value(colored, "prim", 0, at) == (f64)(try surface.closest_face(point)), "closest_prim")
    print("ok    stage 3: coloring by distance to a second input (xyzdist, closest_uv, primuv)")

## Houdini's ray projection onto a second input.
pub func ray_projection() -> !:
    let lifted = try support.run(try support.grid_set(6), support.points_mode, "p.P[1] = 2.0\n")
    let ground = try support.run(try GeometrySet.of_mesh(try MeshPrimitives.grid(6.0, 3)), support.points_mode, "p.P[1] = p.P[0] * 0.1\n")
    let projected = try support.mesh_of(try support.run_inputs(lifted, ground, support.points_mode, "let hit = k.input(1).intersect(p.P, [0.0, -2.0, 0.0, 0.0])\nif hit.prim >= 0:\n    p.P = hit.position\np.set_f32(\"distance\", hit.distance)\n"))
    let mesh = try projected.get()
    for at: i64 in 0..<mesh.point_count():
        let point = try mesh.point(at)
        expect(near(point.y, point.x * 0.1, 1e-5), "every point lands on the sloped ground")
        expect(near(try support.value(projected, "distance", 0, at), 2.0 - point.x * 0.1, 1e-5), "the hit's distance")
    let missed = try support.mesh_of(try support.run_inputs(lifted, ground, support.points_mode, "p.set_i32(\"prim\", k.input(1).intersect(p.P, [0.0, 1.0, 0.0, 0.0]).prim)\n"))
    expect(try support.value(missed, "prim", 0, 0) == -1.0, "a ray that misses")
    print("ok    stage 3: ray projection onto a second input (intersect)")

## Houdini's spiral of points from nothing (Run Over Numbers).
pub func spiral() -> !:
    let body = "let a = (f32)n * 0.3\nlet pt = k.add_point([math32.cos(a) * (f32)n * 0.1, (f32)n * 0.05, math32.sin(a) * (f32)n * 0.1, 0.0])\nk.set_point_f32(pt, \"id\", (f32)n)\n"
    let one = try support.mesh_of(try support.run_inputs(try support.empty_set(), none, support.numbers_mode, body, count = 5000, threads = 1))
    let many = try support.mesh_of(try support.run_inputs(try support.empty_set(), none, support.numbers_mode, body, count = 5000, threads = 16))
    let a = try one.get()
    let b = try many.get()
    expect(a.point_count() == 5000 and a.face_count() == 0, "a spiral of 5000 points")
    for at: i64 in 0..<5000:
        let p = try a.point(at)
        let q = try b.point(at)
        let angle = (f32)at * 0.3
        expect((f32)p.x == math32.cos(angle) * (f32)at * 0.1 and (f32)p.y == (f32)at * 0.05, "points in element order")
        expect(p.x == q.x and p.y == q.y and p.z == q.z, "the same points at 1 and 16 workers")
        expect(try support.value(one, "id", 0, at) == (f64)at and try support.value(many, "id", 0, at) == (f64)at, "set_point on new points")
    print("ok    stage 4: a spiral of points from nothing, identical at 1 and 16 workers")

## Polygons between new points, and between a curve's points.
pub func polygons() -> !:
    let made = try support.mesh_of(try support.run_inputs(try support.empty_set(), none, support.numbers_mode, "let base: f32[4] = [(f32)n * 2.0, 0.0, 0.0, 0.0]\nvar points: i32[16]\npoints[0] = k.add_point(base)\npoints[1] = k.add_point(base + [1.0, 0.0, 0.0, 0.0])\npoints[2] = k.add_point(base + [0.0, 0.0, 1.0, 0.0])\nlet prim = k.add_prim(points, 3)\nk.set_prim_i32(prim, \"n\", (i32)n)\n", count = 10))
    let mesh = try made.get()
    expect(mesh.point_count() == 30 and mesh.face_count() == 10, "ten triangles from nothing")
    for face: i64 in 0..<10:
        for corner: i64 in 0..<3:
            expect((try mesh.face_point(face, corner)) == face * 3 + corner, "a triangle's points")
        expect(try support.value(made, "n", 2, face) == (f64)face, "set_prim on new primitives")
    # Quads joining a grid's rows to new points lifted above them.
    let grid = try support.grid_set(4)
    let walls = try support.mesh_of(try support.run(grid, support.points_mode, "if p.ptnum % 5 < 4:\n    var points: i32[16]\n    points[0] = p.ptnum\n    points[1] = p.ptnum + 1\n    points[2] = k.add_point(k.input(0).point_P(p.ptnum + 1) + [0.0, 1.0, 0.0, 0.0])\n    points[3] = k.add_point(p.P + [0.0, 1.0, 0.0, 0.0])\n    _ = k.add_prim(points, 4)\n"))
    let w = try walls.get()
    expect(w.point_count() == 25 + 40 and w.face_count() == 16 + 20, "a wall on every row segment")
    let face = 16
    expect((try w.face_point(face, 0)) == 0 and (try w.face_point(face, 1)) == 1 and (try w.face_point(face, 2)) == 25 and (try w.face_point(face, 3)) == 26, "a wall's corners")
    expect((try w.point(25)).y == 1.0, "a lifted point")
    print("ok    stage 4: polygons between new points and onto existing ones")

## Houdini's deleting points by a condition, and set_point winning over p.
pub func removals() -> !:
    let set = try support.grid_set(4)
    let kept = try (try support.mesh_of(try support.run(set, support.points_mode, "if p.P[0] < 0.0:\n    k.remove_point(p.ptnum)\n"))).get()
    expect(kept.point_count() == 15 and kept.face_count() == 8, "points left of x = 0 and their faces are gone")
    for at: i64 in 0..<15:
        expect((try kept.point(at)).x >= 0.0, "the kept points")
    let prims = try (try support.mesh_of(try support.run(set, support.primitives_mode, "if f.primnum % 2 == 0:\n    k.remove_prim(f.primnum)\n"))).get()
    expect(prims.face_count() == 8 and prims.point_count() == 25, "removing primitives keeps their points")
    let colored = try support.mesh_of(try support.run(set, support.points_mode, "p.Cd = [1.0, 0.0, 0.0, 0.0]\nk.set_point_vec3(p.ptnum, \"Cd\", [0.0, 1.0, 0.0, 0.0])\n"))
    expect(try support.value(colored, "Cd", 0, 7, 0) == 0.0 and try support.value(colored, "Cd", 0, 7, 1) == 1.0, "set_point wins over p.Cd")
    # Creation and removal in one snippet: a new point removed again, an input point too.
    let mixed = try (try support.mesh_of(try support.run(set, support.points_mode, "let made = k.add_point(p.P + [0.0, 1.0, 0.0, 0.0])\nif p.ptnum % 2 == 0:\n    k.remove_point(made)\nif p.ptnum == 0:\n    k.remove_point(p.ptnum)\n"))).get()
    expect(mixed.point_count() == 25 - 1 + 12 and mixed.face_count() == 15, "removing added points and an input point")
    expect((try mixed.point(24)).y == 1.0 and (try mixed.point(24)).x == (try mixed.point(0)).x, "the first kept new point is point 1's")
    let negative = failure(set, support.points_mode, "if p.ptnum == 3:\n    k.remove_point(-1)\n")
    expect(strings.ends_with(negative, "index out of bounds (point 3)"), "a negative removal faults")
    # Scattered sets: the highest lane wins, then its last call, at any worker count.
    let many = try support.big_grid_set(200)
    let worker_counts: usize[2] = [1, 16]
    for threads in worker_counts:
        let written = try support.mesh_of(try support.run_inputs(many, none, support.points_mode, "k.set_point_f32(p.ptnum % 7, \"w\", (f32)p.ptnum)\nk.set_point_f32(p.ptnum % 7, \"w\", (f32)p.ptnum + 0.5)\n", 0, threads))
        for at: i64 in 0..<7:
            let highest = (40000 - 1) - ((40000 - 1 - at) % 7)
            expect(try support.value(written, "w", 0, at) == (f64)highest + 0.5, "the highest lane's last set wins")
    let limited = failure(try support.empty_set(), support.numbers_mode, "for i in 0..<1100:\n    _ = k.add_point([(f32)i, 0.0, 0.0, 0.0])\n", count = 2)
    expect(strings.ends_with(limited, "too many additions from one element (number 0)"), "1024 adds per element")
    print("ok    stage 4: removals by a condition, set_point precedence, the add limit")

## Collapsed polygons are legal (Houdini's rule): smoothing a noisy sphere until its
## pole triangles have no area cooks, and those faces get a zero normal.
pub func collapsed_faces() -> !:
    let sphere = try GeometrySet.of_mesh(try MeshPrimitives.sphere(1.0, 16))
    let noisy = try support.run(sphere, support.points_mode, "p.P = p.P + rand3(p.ptnum) * 0.02\n")
    var smoothed = noisy
    for _ in 0..<4:
        smoothed = try support.run(smoothed, support.points_mode, "let near = k.input(0).nearpoints(p.P, 0.6, 16)\nvar sum: f32[4] = [0.0, 0.0, 0.0, 0.0]\nfor i in 0..<near.count:\n    sum = sum + k.input(0).point_P(near.points[i])\np.P = sum * (1.0 / (f32)near.count)\n")
    # Every point near a pole onto the pole itself: their triangles have no area at all.
    let collapsed = try support.run(smoothed, support.points_mode, "if math32.abs(p.P[1]) > 0.5:\n    p.P = [0.0, 1.0 if p.P[1] > 0.0 else -1.0, 0.0, 0.0]\n")
    let mesh = try (try support.mesh_of(collapsed)).get()
    var zero: i64 = 0
    for face in 0..<mesh.face_count():
        let n = try mesh.face_normal(face)
        if n.x == 0.0 and n.y == 0.0 and n.z == 0.0: zero += 1
    expect(zero > 0 and zero < mesh.face_count(), "collapsed faces keep a zero normal, the rest a real one")
    # A new polygon without an area is accepted too.
    let flat = try (try support.mesh_of(try support.run_inputs(try support.empty_set(), none, support.numbers_mode, "var points: i32[16]\nfor i in 0..<3:\n    points[i] = k.add_point([(f32)i, 0.0, 0.0, 0.0])\n_ = k.add_prim(points, 3)\n", count = 1))).get()
    let flat_normal = try flat.face_normal(0)
    expect(flat.face_count() == 1 and flat_normal.x == 0.0 and flat_normal.y == 0.0 and flat_normal.z == 0.0, "a new polygon on a line")
    print(f"ok    collapsed polygons cook: {zero} of {mesh.face_count()} faces without an area")

## luced-3d's Sphere sits on the ground (y 0..2): averaging each point with its 8
## nearest stays inside that box and pulls the equator in. The smoothed sphere has
## collapsed faces (pole ring points with the same neighbors meet), and its face
## guides still draw (a zero-length guide for a face without an area).
pub func neighbor_average() -> !:
    let ball = try GeometrySet.of_mesh(try MeshPrimitives.sphere(1.0, 32))
    let before = try (try support.mesh_of(ball)).get()
    # The pieces: a point's own position, and its nearest point at radius 0.
    for body in ["p.Cd = k.input(0).point_P(p.ptnum) - p.P\n", "let near = k.input(0).nearpoints(p.P, 0.0, 1)\np.Cd = k.input(0).point_P(near.points[0]) - p.P\n"]:
        let probe = try support.mesh_of(try support.run(ball, support.points_mode, body))
        for at in 0..<before.point_count():
            for c: i64 in 0..<3:
                expect(try support.value(probe, "Cd", 0, at, c) == 0.0, "point_P and nearpoints name the point itself")
    let smoothed = try support.mesh_of(try support.run(ball, support.points_mode, "let g = k.input(0)\nlet near = g.nearpoints(p.P, 0.3, 8)\nvar sum: f32[4] = [0.0, 0.0, 0.0, 0.0]\nfor i in 0..<near.count:\n    sum = sum + g.point_P(near.points[i])\np.P = sum * (1.0 / (f32)near.count)\n"))
    let after = try smoothed.get()
    let box = after.bounds()
    expect(box.minimum.y >= 0.0 and box.maximum.y <= 2.0 and box.minimum.x >= -1.0 and box.maximum.x <= 1.0, "averages stay inside the input's box")
    var equator: i64 = -1
    for at in 0..<before.point_count():
        let o = try before.point(at)
        if equator < 0 and math.abs(o.y - 1.0) < 0.01 and o.x > 0.99: equator = at
    expect(equator >= 0 and (try after.point(equator)).x < (try before.point(equator)).x - 0.001, "an equator point moves inward")
    let guides = try mesh_overlay_points(after, Matrix4(), true)
    defer free(guides) in memory.heap
    expect(guides.length == (usize)after.face_count() * 2, "a guide per face, collapsed ones included")
    print(f"ok    nearpoints averaging stays inside the input (y {box.minimum.y}..{box.maximum.y}), guides draw")

## An array read with an element-dependent index inside an element-dependent loop.
pub func varying_gathers() -> !:
    let set = try support.grid_set(4)
    let mesh = try support.mesh_of(try support.run(set, support.points_mode, "var picks: i32[16]\nfor j in 0..<16:\n    picks[j] = (i32)j * 10 + p.ptnum\nvar total: i32 = 0\nfor i in 0..<p.ptnum % 5:\n    total += picks[(i + p.ptnum) % 16]\np.Cd = [(f32)total, 0.0, 0.0, 0.0]\n"))
    for at: i64 in 0..<25:
        var total: i64 = 0
        for i in 0..<at % 5: total += ((i + at) % 16) * 10 + at
        expect(try support.value(mesh, "Cd", 0, at) == (f64)total, "a varying index in a varying loop")
    print("ok    gathers with element-dependent indices and bounds")

## Ramp parameters: a float falloff and a color by height through Code.run's names and
## values ("<name>#ramp", the length, then the data), against luce-std's lookup at the
## same t; defaults for ramps not sent; refused data fails at its line; Code.check
## reports both kinds.
pub func ramps() -> !:
    let set = try support.grid_set(8)
    let falloff: f64[12] = [1.0, 1.0, 3.0, 0.0, 0.0, 2.0, 0.4, 1.0, 1.0, 1.0, 0.2, 1.0]
    let tint: f64[18] = [1.0, 3.0, 3.0, 0.0, 1.0, 0.0, 0.0, 1.0, 0.5, 0.0, 1.0, 0.0, 3.0, 1.0, 0.0, 0.0, 1.0, 1.0]
    var names: str[32]
    var values: f64[32]
    names[0] = "falloff#ramp"
    values[0] = 12.0
    for at in 0..<12: values[1 + at] = falloff[at]
    names[13] = "tint#ramp"
    values[13] = 18.0
    for at in 0..<18: values[14 + at] = tint[at]
    let body = "let d = p.P[0] * 0.5 + 0.5\np.Cd = k.ramp_color(\"tint\", p.P[2] * 0.5 + 0.5)\np.set_f32(\"w\", k.ramp(\"falloff\", d))\np.set_f32(\"plain\", k.ramp(\"missing\", d))\n"
    let made = try support.mesh_of(try Code.run(set, support.points_mode, "", body, "", 0, names[..<32], values[..<32], 1.0, 0.0, 24.0, 0))
    let mesh = try made.get()
    var channels: f64[4]
    for at in 0..<mesh.point_count():
        let q = try mesh.point(at)
        let d = (f32)q.x * 0.5 + 0.5
        expect(try support.value(made, "w", 0, at) == (f64)(f32)ramp.lookup(falloff[..<12], (f64)d), "a float ramp reads as luce-std's lookup")
        expect(try support.value(made, "plain", 0, at) == (f64)d, "a ramp not sent is the default line")
        channels = [0.0, 0.0, 0.0, 0.0]
        _ = ramp.lookup_into(tint[..<18], (f64)((f32)q.z * 0.5 + 0.5), channels)
        for c: i64 in 0..<3:
            expect(try support.value(made, "Cd", 0, at, c) == (f64)(f32)channels[(usize)c], "a color ramp reads as luce-std's lookup")
    # Refused data: version 2.
    values[1] = 2.0
    let refused = Code.run(set, support.points_mode, "", "let x: f32 = 1.0\np.set_f32(\"w\", k.ramp(\"falloff\", x))\n", "", 0, names[..<32], values[..<32], 1.0, 0.0, 24.0, 0) catch refusal:
        expect(strings.starts_with(refusal.message, "line 2, column ") and strings.contains(refusal.message, "version"), "a refused ramp fails at the line naming it")
        print(f"      {refusal.message}")
        recover set
    _ = refused
    let check = try Code.check(1, "", body)
    let c = try check.get()
    var float_ramps = 0
    var color_ramps = 0
    for at: i64 in 0..<c.parameter_count():
        if c.parameter_ramp(at) == 1 and c.parameter_components(at) == 0: float_ramps += 1
        if c.parameter_ramp(at) == 3 and c.parameter_name(at) == "tint": color_ramps += 1
    expect(float_ramps == 2 and color_ramps == 1, "Code.check reports the ramps")
    print("ok    ramps: float and color against luce-std's lookup, defaults, refused data, Code.check")

## Vertices, half-edges, neighbors, groups and measures (CODE-NODE items 4 and 5): half-edge
## walks close around faces, vertex chains visit every vertex of a point, the winding
## number is 1 inside a closed cube and 0 outside, surface distances follow the edges.
pub func topology_and_measure() -> !:
    let cube = try GeometrySet.of_mesh(try Mesh.cube(2.0))
    let walks = try support.mesh_of(try support.run(cube, support.primitives_mode, "let g = k.input(0)\nlet first = g.prim_hedge(f.primnum)\nvar h = first\nvar fine: f32 = 1.0\nfor i in 0..<g.prim_vertex_count(f.primnum):\n    if g.hedge_dst_point(h) != g.hedge_src_point(g.hedge_next(h)): fine = 0.0\n    if g.point_hedge(g.hedge_src_point(h), g.hedge_dst_point(h)) != h: fine = 0.0\n    if g.hedge_prev(g.hedge_next(h)) != h or g.hedge_prim(h) != f.primnum: fine = 0.0\n    if g.hedge_equiv_count(h) != 2 or g.vertex_prim(g.prim_vertex(f.primnum, i)) != f.primnum: fine = 0.0\n    h = g.hedge_next(h)\nif h != first: fine = 0.0\nf.set_f32(\"walk\", fine)\nf.set_f32(\"neighbors\", (f32)g.poly_neighbor_count(f.primnum) * 10.0 + (f32)(g.poly_neighbor(f.primnum, 1) - g.poly_neighbor(f.primnum, 0)))\n"))
    for face: i64 in 0..<6:
        expect(try support.value(walks, "walk", 2, face) == 1.0, "half-edge walks close around faces")
        let neighbors = try support.value(walks, "neighbors", 2, face)
        expect(neighbors > 40.0 and neighbors < 50.0, "a cube face has four neighbors, ascending")
    let points = try support.mesh_of(try support.run(cube, support.points_mode, "let g = k.input(0)\nvar count: i32 = 0\nvar v = g.point_vertex(p.ptnum, 0)\nwhile v >= 0:\n    if g.vertex_point(v) != p.ptnum: count = -100\n    count += 1\n    v = g.vertex_next(v)\np.set_f32(\"chain\", (f32)(count - g.point_vertex_count(p.ptnum)))\nlet center = g.getbbox_center()\np.set_f32(\"inside\", g.windingnumber(center))\np.set_f32(\"near\", g.windingnumber(p.P * 0.9 + center * 0.1))\np.set_f32(\"outside\", g.windingnumber(center + [5.0, 0.3, 0.0, 0.0]))\np.Cd = g.computenormal(p.ptnum)\np.set_f32(\"rel\", g.relbbox(p.P)[1] + g.relpointbbox(center)[0] * 10.0)\n"))
    for point: i64 in 0..<8:
        expect(try support.value(points, "chain", 0, point) == 0.0, "vertex_next visits every vertex of a point")
        expect(near(try support.value(points, "inside", 0, point), 1.0, 0.001) and near(try support.value(points, "near", 0, point), 1.0, 0.001), "the winding number is 1 inside")
        expect(near(try support.value(points, "outside", 0, point), 0.0, 0.001), "the winding number is 0 outside")
        let corner = try (try points.get()).point(point)
        for c: i64 in 0..<3:
            let want = (corner.x if c == 0 else (corner.y - 1.0 if c == 1 else corner.z)) / math.sqrt(3.0)
            expect(near(try support.value(points, "Cd", 0, point, c), want, 0.0001), "a corner's normal")
        let relative = try support.value(points, "rel", 0, point)
        expect(relative == 5.0 + (0.0 if corner.y == 0.0 else 1.0), "relbbox")
    let grid = try support.grid_set(4)
    let measured = try support.mesh_of(try support.run(grid, support.points_mode, "let g = k.input(0)\np.set_f32(\"geo\", g.surfacedist(\"0\", p.ptnum))\np.set_f32(\"groups\", (f32)g.npointsgroup(\"0-4\") + 10.0 * (f32)g.expandpointgroup(\"0-4\", 2) + 100.0 * (f32)g.expandprimgroup_count(\"1 3\"))\np.set_f32(\"arc\", g.primarclen(0, 0.0, 0.5) + 10.0 * g.curvearclen(0))\np.Cd = g.minpos(p.P + [0.1, 1.0, 0.0, 0.0])\n"))
    let m = try measured.get()
    let origin = try m.point(0)
    for point: i64 in 0..<m.point_count():
        let q = try m.point(point)
        expect(near(try support.value(measured, "geo", 0, point), math.abs(q.x - origin.x) + math.abs(q.z - origin.z), 0.0001), "surface distance along the grid's edges")
        expect(try support.value(measured, "groups", 0, point) == 225.0, "group counts and expansion")
        expect(near(try support.value(measured, "arc", 0, point), 16.0, 0.0001), "primarclen and curvearclen")
        expect(near(try support.value(measured, "Cd", 0, point, 0), math.min(q.x + 0.1, 1.0), 0.0001) and near(try support.value(measured, "Cd", 0, point, 1), 0.0, 0.0001), "minpos")
    # A closed sphere of quads and pole triangles: inside 1, outside 0, through the far
    # field's expansion (within about 0.2% here).
    let ball = try support.closed_sphere(48, 24)
    let wound = try support.mesh_of(try support.run_inputs(grid, ball, support.points_mode, "p.set_f32(\"w\", k.input(1).windingnumber(p.P * 0.6) + 10.0 * k.input(1).windingnumber(p.P + [0.0, 3.0, 0.0, 0.0]))\n"))
    for point: i64 in 0..<m.point_count():
        expect(near(try support.value(wound, "w", 0, point), 1.0, 0.005), "the winding number of a closed sphere, within the expansion's 0.5%")
    let faulted = failure(grid, support.points_mode, "p.set_f32(\"x\", (f32)k.input(0).vertex_prim(p.ptnum + 1000))\n")
    expect(strings.ends_with(faulted, "index out of bounds (point 0)"), "a vertex out of range faults")
    print("ok    topology and measure: half-edge walks, vertex chains, neighbors, winding numbers, normals, relbbox, surfacedist, groups, arc lengths, minpos")

## Point clouds (CODE-NODE item 6): counts against brute force, nearest first, imports,
## pcfilter against the same weighted mean written out, pcfind_radius by pscale.
pub func point_clouds() -> !:
    let set = try support.big_grid_set(60)
    let radius: f32 = 0.08
    let body = "let g = k.input(0)\nlet pc = g.pcopen(p.P, 0.08, 20)\nvar sum: f32[4] = [0.0, 0.0, 0.0, 0.0]\nvar total: f32 = 0.0\nvar ordered: f32 = 1.0\nfor i in 0..<pc.count():\n    let d = pc.distance(i) / 0.08\n    let w = math32.max(1.0 - d * d, 0.0)\n    sum = sum + pc.vec3(i, \"P\") * w\n    total += w\n    if i > 0 and pc.distance(i) < pc.distance(i - 1): ordered = 0.0\n    if pc.point(i) != g.pcfind(p.P, 0.08, 20).point(i): ordered = 0.0\np.Cd = pc.filter_vec3(\"P\") - sum * (1.0 / total)\np.set_f32(\"count\", (f32)pc.count())\np.set_f32(\"first\", (f32)pc.point(0) + 1000.0 * pc.distance(0) + 10.0 * ordered)\np.set_f32(\"smooth\", pc.filter_f32(\"ptnum_copy\"))\n"
    let numbered = try support.run(set, support.points_mode, "p.set_f32(\"ptnum_copy\", (f32)p.ptnum)\np.set_f32(\"pscale\", 0.02 + 0.06 * (f32)(p.ptnum % 2))\n")
    let made = try support.mesh_of(try support.run(numbered, support.points_mode, body))
    let m = try made.get()
    for at: i64 in 0..<m.point_count():
        let q = try m.point(at)
        var within: i64 = 0
        var by_radius: i64 = 0
        for other: i64 in 0..<m.point_count():
            let d = (try m.point(other)).subtract(q).length()
            if d <= (f64)radius: within += 1
            if d <= (f64)radius and d <= 0.02 + 0.06 * (f64)(other % 2): by_radius += 1
        expect(try support.value(made, "count", 0, at) == (f64)(within if within < 20 else 20), "pcopen finds the nearest points within the radius, up to max")
        expect(try support.value(made, "first", 0, at) == (f64)at + 10.0, "nearest first, the point itself at 0, pcfind the same")
        for c: i64 in 0..<3:
            expect(near(try support.value(made, "Cd", 0, at, c), 0.0, 0.00001), "pcfilter is the weighted mean written out")
        _ = by_radius
    let radii = try support.mesh_of(try support.run(numbered, support.points_mode, "p.set_f32(\"n\", (f32)k.input(0).pcfind_radius(p.P, \"pscale\", 1.0, 0.1, 64).count())\n"))
    for at: i64 in 0..<m.point_count():
        let q = try m.point(at)
        var by_radius: i64 = 0
        for other: i64 in 0..<m.point_count():
            let d = (try m.point(other)).subtract(q).length()
            if d <= 0.1 and d <= 0.02 + 0.06 * (f64)(other % 2): by_radius += 1
        expect(try support.value(radii, "n", 0, at) == (f64)by_radius, "pcfind_radius keeps the points whose own radius reaches")
    print("ok    point clouds: counts, nearest first, imports, pcfilter, pcfind, pcfind_radius")

## Volumes (CODE-NODE item 7): luced-3d's path, an SDF Sphere sampled by SDF to Volume,
## read against the exact sphere; snapping points onto the surface; the SDF itself.
pub func volumes() -> !:
    let none_numbers: f64[1] = [0.0]
    _ = none_numbers
    let sphere = try GeometryVerbs.run("SDF Sphere", try support.empty_set(), none, "", 0, [0.75, 0.0, 0.0, 0.0])
    let field = try (try sphere.get()).geometry()
    let sampled = try GeometryVerbs.run("SDF to Volume", field, none, "", 0, [0.05, 3.0, 0.0])
    let volume = try (try sampled.get()).geometry()
    let set = try support.big_grid_set(21)
    let body = "let g = k.input(1)\nlet q = p.P * 0.9 + [0.0, 0.1, 0.0, 0.0]\nlet d = g.volume_sample(\"surface\", q)\nlet n = normalized(g.volume_gradient(\"surface\", q))\nlet snapped = q - n * d\np.Cd = [d, length(snapped), dot(n, normalized(q)), 0.0]\nlet index = g.volume_pos_to_index(\"surface\", q)\nlet center = g.volume_index_to_pos(\"\", (i32)index[0], (i32)index[1], (i32)index[2])\np.set_f32(\"back\", length(center - q))\np.set_f32(\"voxel\", g.volume_index(\"#0\", (i32)index[0], (i32)index[1], (i32)index[2]) - g.volume_sample(\"surface\", center))\np.set_f32(\"size\", g.volume_voxel_size(\"surface\"))\np.set_f32(\"res\", g.volume_res(\"surface\")[0])\np.set_f32(\"exact\", k.input(0).volume_sample(\"\", q))\n"
    let read = try support.mesh_of(try support.run_inputs(set, volume, support.points_mode, body))
    let exact = try support.mesh_of(try support.run_inputs(set, field, support.points_mode, "p.set_f32(\"sdf\", k.input(1).volume_sample(\"\", p.P * 0.9 + [0.0, 0.1, 0.0, 0.0]))\n"))
    let m = try read.get()
    for at: i64 in 0..<m.point_count():
        let q = (try m.point(at)).multiply_scalar(0.9).add(Vector3(0.0, 0.1, 0.0))
        let want = q.length() - 0.75
        let d = try support.value(read, "Cd", 0, at, 0)
        if math.abs(want) < 0.1:
            expect(near(d, want, 0.01), "the level set near its surface")
            expect(near(try support.value(read, "Cd", 0, at, 1), 0.75, 0.01), "snapped onto the surface")
            expect(try support.value(read, "Cd", 0, at, 2) > 0.99, "the gradient points outward")
        expect(near(try support.value(exact, "sdf", 0, at), want, 0.00001), "an SDF samples exactly")
        expect(try support.value(read, "back", 0, at) <= 0.05 * 0.87 + 0.00001, "the nearest voxel's center is within half a voxel diagonal")
        expect(near(try support.value(read, "voxel", 0, at), 0.0, 0.00001), "volume_index reads the voxel volume_sample reads at its center")
        expect(near(try support.value(read, "size", 0, at), 0.05, 0.00001) and try support.value(read, "res", 0, at) >= 30.0, "voxel size and the leaves' span (the band around a 1.5 wide sphere)")
    print("ok    volumes: level set against the exact sphere, gradients, snapping, index and position, the SDF itself")

## printf, warning and error (CODE-NODE item 9) through Code.cook.
pub func messages() -> !:
    let set = try support.grid_set(4)
    let run = try Code.cook(set, support.points_mode, "", "if p.ptnum < 3:\n    k.printf(\"point %d: %.2f%%\\n\", (f32)p.ptnum, 0.25 * (f32)p.ptnum)\nif p.ptnum % 5 == 0:\n    k.warning(\"careful\")\n", "", 0, support.no_names(), support.no_values(), 1.0, 0.0, 24.0, 0)
    let r = try run.get()
    expect(r.output() == "point 0: 0.00%\npoint 1: 0.25%\npoint 2: 0.50%\n" and r.output_count() == 3, "printf output in element order")
    expect(r.warning() == "careful" and r.warning_count() == 5, "warnings: the first and a count")
    expect((try (try r.geometry().get()).mesh()) != none, "the geometry")
    let many = try Code.cook(try support.big_grid_set(200), support.points_mode, "", "k.printf(\"%d\\n\", (f32)p.ptnum)\n", "", 0, support.no_names(), support.no_values(), 1.0, 0.0, 24.0, 0)
    let all = try many.get()
    expect(all.output_count() == 40000, "every message counted")
    let text = all.output()
    expect(strings.starts_with(text, "0\n1\n2\n3\n") and strings.ends_with(text, "198\n199\n... and 39800 more messages\n"), "the first 200 in element order, the rest counted")
    _ = Code.cook(set, support.points_mode, "", "if p.ptnum == 7:\n    k.error(\"bad point\")\n", "", 0, support.no_names(), support.no_values(), 1.0, 0.0, 24.0, 0) catch refusal:
        expect(strings.starts_with(refusal.message, "line 2, column ") and strings.ends_with(refusal.message, "bad point (point 7)"), "k.error fails at its line and element")
        recover run
    print("ok    messages: printf in element order and capped, warnings counted, error fails at its element")

## Texts (CODE-NODE item 8): written as a text attribute, read back through every method,
## grown in a loop at one call site, read from an input by number.
pub func texts() -> !:
    let set = try support.grid_set(4)
    let named = try support.run(set, support.points_mode, "let t = k.text(\"piece_\").concat(k.itoa(p.ptnum // 5))\np.set_text(\"name\", t)\nif p.ptnum == 0:\n    k.set_prim_text(3, \"label\", k.sprintf(\"face %d\", 3.0))\n")
    let mesh = try (try support.mesh_of(named)).get()
    let name = try mesh.attribute_entry(mesh.find_attribute("name", 0))
    expect(name.text_at(0) == "piece_0" and name.text_at(12) == "piece_2" and name.text_at(24) == "piece_4", "set_text writes a text attribute")
    let label = try mesh.attribute_entry(mesh.find_attribute("label", 2))
    expect(label.text_at(3) == "face 3" and label.text_at(2) == "", "set_prim_text by number, the others empty")
    let body = "let t = p.text(\"name\")\nlet piece = k.text(\"piece_\")\np.set_f32(\"len\", (f32)t.length())\np.set_f32(\"starts\", 1.0 if t.startswith(piece) and t.endswith(k.itoa(p.ptnum // 5)) and not t.equals(piece) else 0.0)\np.set_f32(\"number\", (f32)t.split(k.text(\"_\"), 1).to_i32() + 10.0 * (f32)t.split_count(k.text(\"_\")))\np.set_f32(\"found\", (f32)t.find(k.text(\"_\")))\np.set_f32(\"float\", k.sprintf(\"%.2f\", 1.5).to_f32())\nvar s = k.text(\"\")\nfor i in 0..<3:\n    s = s.concat(k.itoa((i32)i))\np.set_text(\"grown\", s.join(k.text(\"-\"), t.replace(piece, k.text(\"part\")).slice(-2, 100)))\np.set_text(\"other\", k.input(0).point_text(24, \"name\"))\n"
    let read = try (try support.mesh_of(try support.run(named, support.points_mode, body))).get()
    for at: i64 in 0..<25:
        let row = at // 5
        expect(try read.attribute_entry(read.find_attribute("len", 0)).number((usize)at, 0) == 7.0, "length")
        expect(try read.attribute_entry(read.find_attribute("starts", 0)).number((usize)at, 0) == 1.0, "startswith, endswith, equals")
        expect(try read.attribute_entry(read.find_attribute("number", 0)).number((usize)at, 0) == (f64)row + 20.0, "split, split_count, to_i32")
        expect(try read.attribute_entry(read.find_attribute("found", 0)).number((usize)at, 0) == 5.0, "find")
        expect(try read.attribute_entry(read.find_attribute("float", 0)).number((usize)at, 0) == 1.5, "sprintf and to_f32")
        var room: u8[32]
        let want = try strings.format(room, f"012-t{row}")
        expect((try read.attribute_entry(read.find_attribute("grown", 0))).text_at((usize)at) == want, "concat in a loop, join, replace, slice")
        expect((try read.attribute_entry(read.find_attribute("other", 0))).text_at((usize)at) == "piece_4", "point_text of another point")
    print("ok    texts: attributes written and read, every method, a loop at one site, point_text")

## Arrays (CODE-NODE item 8): built in a loop, sorted, searched, reshaped; vectors and
## integers; the 64-item limit.
pub func arrays() -> !:
    let set = try support.grid_set(4)
    let body = "var a = k.floats()\nfor i in 0..<5:\n    a = a.append((f32)((i * 7 + p.ptnum) % 5))\nlet sorted = a.sort()\nlet order = a.argsort()\np.set_f32(\"sorted\", sorted.at(0) + 10.0 * sorted.at(4))\np.set_f32(\"smallest\", a.at(order.at(0)))\np.set_f32(\"found\", (f32)a.find(4.0))\nlet b = a.insert(0, 9.0).remove(1).set(1, 8.0)\np.set_f32(\"first\", b.at(0) + 10.0 * b.at(1))\nlet r = a.reverse().slice(1, 3).resize(4).pop()\np.set_f32(\"reshaped\", (f32)r.len() + 10.0 * r.at(2))\nlet v = k.vectors().append(p.P).append([1.0, 2.0, 3.0, 0.0]).sort()\np.Cd = v.at(1) if v.at(0)[0] < 1.0 else v.at(0)\nlet n = k.ints().append(3).append(1).append(2).sort()\np.set_f32(\"ints\", (f32)(n.at(0) * 100 + n.at(1) * 10 + n.at(2)))\n"
    let made = try (try support.mesh_of(try support.run(set, support.points_mode, body))).get()
    for at: i64 in 0..<25:
        let items: i64[5] = [(0 * 7 + at) % 5, (1 * 7 + at) % 5, (2 * 7 + at) % 5, (3 * 7 + at) % 5, (4 * 7 + at) % 5]
        expect(try made.attribute_entry(made.find_attribute("sorted", 0)).number((usize)at, 0) == 40.0, "sort")
        expect(try made.attribute_entry(made.find_attribute("smallest", 0)).number((usize)at, 0) == 0.0, "argsort")
        var where_four: i64 = -1
        for (k, item) in items.indexed():
            if item == 4 and where_four < 0: where_four = (i64)k
        expect(try made.attribute_entry(made.find_attribute("found", 0)).number((usize)at, 0) == (f64)where_four, "find")
        expect(try made.attribute_entry(made.find_attribute("first", 0)).number((usize)at, 0) == 9.0 + 80.0, "insert, remove, set")
        expect(try made.attribute_entry(made.find_attribute("reshaped", 0)).number((usize)at, 0) == 3.0, "reverse, slice, resize (zeros), pop")
        expect(try made.attribute_entry(made.find_attribute("ints", 0)).number((usize)at, 0) == 123.0, "int arrays")
        expect(try support.value(try support.mesh_of(try support.run(set, support.points_mode, "p.Cd = k.vectors().append([1.0, 2.0, 3.0, 0.0]).at(0)\n")), "Cd", 0, at, 2) == 3.0, "vector arrays")
    let full = failure(set, support.points_mode, "var a = k.floats()\nfor i in 0..<65:\n    a = a.append(1.0)\n")
    expect(strings.ends_with(full, "too many additions from one element (point 0)"), "64 items at most")
    print("ok    arrays: append in a loop, sort, argsort, find, insert, remove, set, reverse, slice, resize, pop, vectors, ints, the limit")
